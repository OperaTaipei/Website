---
import Layout from '../../layouts/Layout.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';

import en from '../../i18n/en.json';
import zh from '../../i18n/zh.json';
import fr from '../../i18n/fr.json';
import ja from '../../i18n/ja.json';
import { quoteTranslations } from '../../i18n/quote';

export function getStaticPaths() {
  return [
    { params: { lang: undefined } }, // English (/quote)
    { params: { lang: 'zh' } },      // Chinese (/zh/quote)
    { params: { lang: 'fr' } },      // French (/fr/quote)
    { params: { lang: 'ja' } }       // Japanese (/ja/quote)
  ];
}

const { lang = 'en' } = Astro.params;

const baseMap: Record<string, any> = { en, zh, fr, ja };
const t = {
  ...(baseMap[lang] || en),
  ...(quoteTranslations[lang] || quoteTranslations.en)
};

const mainSiteUrl = lang === 'en' ? '/' : `/${lang}/`;
const canonical = lang === 'en'
  ? 'https://opera-taipei.com/quote'
  : `https://opera-taipei.com/${lang}/quote`;

const alternates = [
  { href: 'https://opera-taipei.com/quote', hreflang: 'en' },
  { href: 'https://opera-taipei.com/zh/quote', hreflang: 'zh-Hant' },
  { href: 'https://opera-taipei.com/fr/quote', hreflang: 'fr' },
  { href: 'https://opera-taipei.com/ja/quote', hreflang: 'ja' }
];

const getQuoteLangLink = (targetLang: string) => {
  if (targetLang === 'en') return '/quote';
  return `/${targetLang}/quote`;
};

// Generate 30-min interval time options in strict AM / PM format
const timeOptions = Array.from({ length: 48 }, (_, i) => {
  const h24 = Math.floor(i / 2);
  const m = i % 2 === 0 ? '00' : '30';
  const period = h24 >= 12 ? 'PM' : 'AM';
  const h12 = h24 % 12 === 0 ? 12 : h24 % 12;
  const val = `${String(h24).padStart(2, '0')}:${m}`;
  const label = `${String(h12).padStart(2, '0')}:${m} ${period}`;
  return { val, label };
});
---

<Layout
  title={t.page_title}
  description={t.page_desc}
  lang={lang}
  canonical={canonical}
  alternates={alternates}
>
  <!-- html2canvas & jsPDF for direct page-by-page formatted PDF generation -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" defer></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js" defer></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js" defer></script>

  <div class="web-ui-container">
    <!-- Navigation Bar -->
    <nav id="navbar" class="quote-nav">
      <div class="nav-left">
        <a href={mainSiteUrl} class="nav-logo" aria-label="Opéra Taipei Home">
          <img src="/images/opera-logo.png" alt="Opéra Taipei Logo" class="nav-logo-img" />
        </a>
        <a href={mainSiteUrl} class="back-main-link">{t.back_to_main}</a>
      </div>

      <ul class="nav-links">
        <li><a href="#venue-details">{t.nav_venue_info}</a></li>
        <li><a href="#step-info">{t.nav_questionnaire}</a></li>
        <li><a href="#step-packages">{t.nav_packages}</a></li>
        <li><a href="#step-summary">{t.nav_summary}</a></li>
        <li><a href="#contact">{t.nav_contact}</a></li>
      </ul>

      <button class="hamburger" id="hamburger" aria-label="Toggle mobile menu">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <div class="lang-switcher">
        <a href={getQuoteLangLink('en')} data-lang-switch="en" class={`lang-btn ${lang === 'en' ? 'active' : ''}`}>EN</a>
        <a href={getQuoteLangLink('zh')} data-lang-switch="zh" class={`lang-btn ${lang === 'zh' ? 'active' : ''}`}>中文</a>
        <a href={getQuoteLangLink('fr')} data-lang-switch="fr" class={`lang-btn ${lang === 'fr' ? 'active' : ''}`}>FR</a>
        <a href={getQuoteLangLink('ja')} data-lang-switch="ja" class={`lang-btn ${lang === 'ja' ? 'active' : ''}`}>JA</a>
      </div>
    </nav>

    <div class="mobile-menu" id="mobile-menu">
      <a href={mainSiteUrl} class="mobile-nav-link">{t.back_to_main}</a>
      <a href="#venue-details" class="mobile-nav-link">{t.nav_venue_info}</a>
      <a href="#step-info" class="mobile-nav-link">{t.nav_questionnaire}</a>
      <a href="#step-packages" class="mobile-nav-link">{t.nav_packages}</a>
      <a href="#step-summary" class="mobile-nav-link">{t.nav_summary}</a>
      <a href="#contact" class="mobile-nav-link">{t.nav_contact}</a>
    </div>

    <main>
      <!-- ====================================================
           HERO & REFERENCE ESTIMATE BANNER
      ==================================================== -->
      <section class="quote-hero">
        <div class="hero-background"></div>
        <div class="hero-circles"></div>

        <div class="quote-hero-inner fade-in visible">
          <p class="hero-eyebrow">{t.hero_eyebrow}</p>
          <h1 class="hero-title" style="font-size: clamp(2.6rem, 6vw, 5rem);" set:html={t.hero_title} />
          <p class="hero-subtitle" style="margin-bottom: 30px;">{t.hero_subtitle}</p>

          <!-- Prominent Reference Disclaimer Banner -->
          <div class="reference-disclaimer-banner">
            <div class="ref-badge-pill">{t.ref_badge}</div>
            <h2 class="ref-banner-heading">{t.ref_banner_title}</h2>
            <p class="ref-banner-copy">{t.ref_banner_text}</p>
            <div class="ref-banner-actions">
              <a href="#step-info" class="btn-gold"><span>{t.ref_cta_start}</span></a>
              <a href="#contact" class="btn-ghost">{t.ref_cta_talk}</a>
            </div>
          </div>
        </div>
      </section>

      <!-- ====================================================
           SECTION 1: VENUE DETAILS, BAR VISUALS & TABLE SETUP
      ==================================================== -->
      <section id="venue-details" class="quote-section quote-section--dark">
        <div class="section-wrap fade-in visible">
          <p class="section-label">{t.venue_sec_label}</p>
          <h2 class="section-title" set:html={t.venue_sec_title} />
          <div class="section-divider"></div>
          <p class="quote-sec-intro">{t.venue_sec_intro}</p>

          <!-- Key Venue Metrics Strip -->
          <div class="venue-stats-grid">
            <div class="venue-stat-card">
              <div class="stat-val">{t.stat_capacity}</div>
              <div class="stat-lbl">{t.stat_capacity_lbl}</div>
            </div>
            <div class="venue-stat-card">
              <div class="stat-val">{t.stat_seating}</div>
              <div class="stat-lbl">{t.stat_seating_lbl}</div>
            </div>
            <div class="venue-stat-card">
              <div class="stat-val">{t.stat_screens}</div>
              <div class="stat-lbl">{t.stat_screens_lbl}</div>
            </div>
            <div class="venue-stat-card">
              <div class="stat-val">{t.stat_audio}</div>
              <div class="stat-lbl">{t.stat_audio_lbl}</div>
            </div>
          </div>

          <!-- 1. 3D Floor Plan & Table Setup Section Block -->
          <div class="venue-sub-section" id="section-floorplan">
            <div class="events-block-title">{t.venue_tab_floorplan}</div>
            <div class="floorplan-showcase-grid">
              <div class="floorplan-img-box">
                <img src="/images/3DPlanOpera.png" alt="Opéra Taipei 3D Floor Plan & Table Layout" class="floor-plan-img" />
              </div>
              <div class="floorplan-details-box">
                <h3 class="sub-card-title">{t.floorplan_title}</h3>
                <p class="sub-card-desc">{t.floorplan_desc}</p>

                <div class="facilities-mini-box">
                  <h4>{t.trusted_col2}</h4>
                  <ul>
                    <li>{t.trusted_e1}</li>
                    <li>{t.trusted_e2}</li>
                    <li>{t.trusted_e3}</li>
                    <li>{t.trusted_e4}</li>
                    <li>{t.trusted_e5}</li>
                    <li>{t.trusted_e6}</li>
                    <li>{t.trusted_e7}</li>
                    <li>{t.trusted_e8}</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <!-- 2. Bar Visuals Section Block -->
          <div class="venue-sub-section" id="section-visuals">
            <div class="venue-sub-header-row">
              <div class="events-block-title" style="margin-bottom: 0;">{t.venue_tab_visuals}</div>
            </div>
            <div class="quote-gallery-grid">
              <div class="quote-gallery-item">
                <img src="/images/nz93950-enhanced-nr.jpg" alt="Opéra Taipei panoramic Taipei 101 view" loading="lazy" />
              </div>
              <div class="quote-gallery-item">
                <img src="/images/nz93619-enhanced-nr.jpg" alt="Opéra Taipei craft cocktail bar" loading="lazy" />
              </div>
              <div class="quote-gallery-item">
                <img src="/images/nz93801-enhanced-nr.jpg" alt="Opéra Taipei seating & lounge setup" loading="lazy" />
              </div>
              <div class="quote-gallery-item">
                <img src="/images/nz94160-enhanced-nr.jpg" alt="Opéra Taipei night ambiance" loading="lazy" />
              </div>
              <div class="quote-gallery-item">
                <img src="/images/pxl_20230816_104529730.jpg" alt="Opéra Taipei skyline window seating" loading="lazy" />
              </div>
              <div class="quote-gallery-item">
                <img src="/images/darts.jpg" alt="Opéra Taipei entertainment & darts area" loading="lazy" />
              </div>
            </div>
          </div>

          <!-- 3. Equipments Section Block -->
          <div class="venue-sub-section" id="section-equipment">
            <div class="events-block-title">{t.venue_tab_equipment}</div>
            <div class="events-two-columns">
              <div class="events-card">
                <div class="events-card-label">{t.services_label} <span class="events-card-note">{t.services_note}</span></div>
                <ul class="events-feature-list">
                  <li>{t.svc1}</li>
                  <li>{t.svc2}</li>
                  <li>{t.svc3}</li>
                  <li>{t.svc4}</li>
                  <li>{t.svc5}</li>
                  <li>{t.svc6}</li>
                  <li>{t.svc7}</li>
                  <li>{t.svc8}</li>
                </ul>
              </div>
              <div class="events-card">
                <div class="events-card-label">{t.facilities_label}</div>
                <ul class="events-feature-list">
                  <li>{t.fac1}</li>
                  <li>{t.fac2}</li>
                  <li>{t.fac3}</li>
                  <li>{t.fac4}</li>
                  <li>{t.fac5}</li>
                  <li>{t.fac6}</li>
                  <li>{t.fac7}</li>
                </ul>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- ====================================================
           INTERACTIVE QUOTATION FORM
      ==================================================== -->
      <form id="quote-builder-form" onsubmit="return false;">

        <!-- STEP 1: EVENT & CLIENT INFORMATION (PDF PAGE 1) -->
        <section id="step-info" class="quote-section">
          <div class="section-wrap">
            <p class="section-label">{t.step1_label}</p>
            <h2 class="section-title" set:html={t.step1_title} />
            <div class="section-divider"></div>

            <!-- Pricing Rules Block under Event Information Title -->
            <div class="pricing-rules-block" style="margin-bottom: 40px;">
              <div class="events-block-title">{t.pricing_rules_title}</div>
              <div class="events-two-columns" style="margin-bottom: 18px;">
                <div class="events-card">
                  <div class="events-card-label">{t.events_day} <span class="events-card-note">{t.events_day_note}</span></div>
                  <div class="venue-price-row">
                    <span class="venue-price-label">{t.events_hr_venue}</span>
                    <span class="venue-price-amount">5,000 NTD / hr</span>
                  </div>
                  <div class="venue-price-row">
                    <span class="venue-price-label">{t.events_hr_drinks}</span>
                    <span class="venue-price-amount">15,000 NTD / hr</span>
                  </div>
                </div>
                <div class="events-card">
                  <div class="events-card-label">{t.events_night} <span class="events-card-note">{t.events_night_note}</span></div>
                  <div class="venue-price-row">
                    <span class="venue-price-label">{t.events_weekday}</span>
                    <span class="venue-price-amount">100,000 NTD</span>
                  </div>
                  <div class="venue-price-row">
                    <span class="venue-price-label">{t.events_weekend}</span>
                    <span class="venue-price-amount">200,000 NTD</span>
                  </div>
                </div>
              </div>
              <p class="events-note">{t.events_note}</p>
            </div>

            <p class="quote-sec-intro">{t.step1_desc}</p>

            <div class="form-card">
              <div class="form-grid-2">
                <div class="form-group form-group--full">
                  <label for="inp-title">{t.fld_title}</label>
                  <input type="text" id="inp-title" name="title" placeholder={t.fld_title_ph} value="Private Event at Opéra" />
                </div>

                <div class="form-group form-group--full">
                  <label>{t.fld_date}</label>
                  <input type="hidden" id="inp-date" name="date" />
                  <div class="calendar-picker-wrap">
                    <div class="calendar-selected-bar" id="calendar-selected-bar">
                      <span class="cal-selected-date-text" id="cal-selected-date-text">Select a date</span>
                      <span class="cal-day-type-badge" id="cal-day-type-badge">Weekday</span>
                    </div>
                    <div class="calendar-widget" id="event-calendar-widget">
                      <div class="cal-header">
                        <button type="button" class="cal-nav-btn" id="cal-prev-month" aria-label="Previous Month">‹</button>
                        <div class="cal-month-title" id="cal-month-title">Month Year</div>
                        <button type="button" class="cal-nav-btn" id="cal-next-month" aria-label="Next Month">›</button>
                      </div>
                      <div class="cal-weekdays">
                        <span>Sun</span>
                        <span>Mon</span>
                        <span>Tue</span>
                        <span>Wed</span>
                        <span>Thu</span>
                        <span class="cal-wknd-hdr">Fri</span>
                        <span class="cal-wknd-hdr">Sat</span>
                      </div>
                      <div class="cal-days-grid" id="cal-days-grid"></div>
                    </div>
                  </div>
                </div>

                <div class="form-group">
                  <label for="inp-guest-name">{t.fld_guest_name}</label>
                  <input type="text" id="inp-guest-name" name="guestName" placeholder={t.fld_guest_name_ph} />
                </div>
                <div class="form-group">
                  <label for="inp-tax-id">{t.fld_tax_id}</label>
                  <input type="text" id="inp-tax-id" name="taxId" placeholder={t.fld_tax_id_ph} maxlength="12" />
                </div>

                <div class="form-group form-group--full">
                  <label for="inp-contact">{t.fld_contact_info}</label>
                  <input type="text" id="inp-contact" name="contactInfo" placeholder={t.fld_contact_info_ph} />
                </div>

                <div class="form-group form-group--full">
                  <label for="inp-attending">{t.fld_attending}</label>
                  <div class="number-slider-wrap">
                    <input type="number" id="inp-attending" name="attending" min="1" max="350" value="60" />
                    <input type="range" id="rng-attending" min="10" max="300" step="5" value="60" />
                  </div>
                </div>

                <div class="form-group">
                  <label>{t.fld_setup_time}</label>
                  <p class="setup-free-note">{t.fld_setup_free_note}</p>
                  <div class="early-setup-box">
                    <div class="early-setup-row">
                      <span class="early-setup-lbl">{t.fld_early_setup}</span>
                      <div class="yn-switch" data-opt="early_setup">
                        <button type="button" class="yn-btn" data-val="YES">{t.tbl_col_yes}</button>
                        <button type="button" class="yn-btn active" data-val="NO">{t.tbl_col_no}</button>
                      </div>
                    </div>
                    <div class="time-range-grid time-range-grid--two">
                      <div>
                        <label for="inp-early-start-text" class="sub-lbl">{t.fld_early_setup_time_lbl}</label>
                        <div class="time-input-combo">
                          <input type="text" id="inp-early-start-text" value="03:00" placeholder="hh:mm" class="time-text-inp" />
                          <select id="sel-early-start-ampm" class="gold-select time-ampm-sel">
                            <option value="AM">AM</option>
                            <option value="PM" selected>PM</option>
                          </select>
                        </div>
                        <input type="hidden" id="inp-early-setup-start" name="earlySetupStart" value="15:00" />
                      </div>
                      <div>
                        <label for="inp-early-end-text" class="sub-lbl">{t.fld_early_setup_end_lbl}</label>
                        <div class="time-input-combo">
                          <input type="text" id="inp-early-end-text" value="05:00" placeholder="hh:mm" class="time-text-inp" />
                          <select id="sel-early-end-ampm" class="gold-select time-ampm-sel">
                            <option value="AM">AM</option>
                            <option value="PM" selected>PM</option>
                          </select>
                        </div>
                        <input type="hidden" id="inp-early-setup-end" name="earlySetupEnd" value="17:00" />
                      </div>
                    </div>
                    <div class="early-setup-calc-row">
                      <span class="sub-lbl">{t.fld_event_duration}: <strong id="early-setup-hours-val">2</strong> hrs</span>
                      <span class="early-setup-fee-preview" id="early-setup-fee-val">= 10,000 NTD$</span>
                    </div>
                  </div>
                </div>

                <div class="form-group">
                  <label>{t.fld_event_time}</label>
                  <div class="time-range-grid time-range-grid--two">
                    <div>
                      <span class="sub-lbl">{t.fld_event_start}</span>
                      <div class="time-input-combo">
                        <input type="text" id="inp-start-text" value="07:00" placeholder="hh:mm" class="time-text-inp" />
                        <select id="sel-start-ampm" class="gold-select time-ampm-sel">
                          <option value="AM">AM</option>
                          <option value="PM" selected>PM</option>
                        </select>
                      </div>
                      <input type="hidden" id="inp-start-time" name="startTime" value="19:00" />
                    </div>
                    <div>
                      <span class="sub-lbl">{t.fld_event_end}</span>
                      <div class="time-input-combo">
                        <input type="text" id="inp-end-text" value="10:00" placeholder="hh:mm" class="time-text-inp" />
                        <select id="sel-end-ampm" class="gold-select time-ampm-sel">
                          <option value="AM">AM</option>
                          <option value="PM" selected>PM</option>
                        </select>
                      </div>
                      <input type="hidden" id="inp-end-time" name="endTime" value="22:00" />
                    </div>
                  </div>
                  <input type="hidden" id="inp-duration" name="duration" value="3" />
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- STEP 2: DRINK PACKAGES (4 OPTIONS) -->
        <section id="step-packages" class="quote-section quote-section--dark">
          <div class="section-wrap">
            <p class="section-label">{t.step3_label}</p>
            <h2 class="section-title" set:html={t.step3_title} />
            <div class="section-divider"></div>
            <p class="quote-sec-intro">{t.step3_desc}</p>

            <!-- Option 0: No Drink Package (Daytime Venue Only) -->
            <div class="drink-pkg-card drink-pkg-card--none" data-pkg-card="none" style="margin-bottom: 20px;">
              <div class="pkg-none-row">
                <div>
                  <h3 class="pkg-title" style="margin-bottom: 4px; font-size: 1.3rem;">{t.pkg_none_name}</h3>
                  <p class="pkg-desc" style="margin-bottom: 0;">{t.pkg_none_desc}</p>
                </div>
                <span class="pkg-status-indicator" data-select-lbl={t.pkg_select_badge} data-selected-lbl={t.pkg_selected_badge}>{t.pkg_select_badge}</span>
              </div>
            </div>

            <div class="drink-packages-grid">
              <!-- Package 1: Open Bar Tally Up (Master Tab) -->
              <div class="drink-pkg-card" data-pkg-card="tally">
                <div class="pkg-card-top">
                  <div class="pkg-header-row">
                    <span class="pkg-tag-pill">{t.pkg_1_tag}</span>
                    <span class="pkg-status-indicator" data-select-lbl={t.pkg_select_badge} data-selected-lbl={t.pkg_selected_badge}>{t.pkg_select_badge}</span>
                  </div>
                  <h3 class="pkg-title">{t.pkg_1_name}</h3>
                  <p class="pkg-desc">{t.pkg_1_desc}</p>
                </div>

                <div class="pkg-config-box">
                  <div class="form-group">
                    <label for="inp-tally-cap">{t.pkg_1_cap_lbl}</label>
                    <input type="number" id="inp-tally-cap" min="0" step="5000" value="100000" placeholder={t.pkg_1_cap_ph} />
                  </div>
                  <div class="form-group" style="margin-top: 12px;">
                    <label>{t.pkg_1_policy_lbl}</label>
                    <div class="radio-group">
                      <label class="radio-lbl">
                        <input type="radio" name="tallyPolicy" value="Check with host to extend" checked />
                        <span>{t.pkg_1_policy_check}</span>
                      </label>
                      <label class="radio-lbl">
                        <input type="radio" name="tallyPolicy" value="Close the bar" />
                        <span>{t.pkg_1_policy_close}</span>
                      </label>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Package 2: Drink Tickets (300 NTD per ticket) -->
              <div class="drink-pkg-card" data-pkg-card="tickets">
                <div class="pkg-card-top">
                  <div class="pkg-header-row">
                    <span class="pkg-tag-pill">{t.pkg_2_tag}</span>
                    <span class="pkg-status-indicator" data-select-lbl={t.pkg_select_badge} data-selected-lbl={t.pkg_selected_badge}>{t.pkg_select_badge}</span>
                  </div>
                  <h3 class="pkg-title">{t.pkg_2_name}</h3>
                  <p class="pkg-desc">{t.pkg_2_desc}</p>
                </div>

                <div class="pkg-config-box">
                  <div class="form-group">
                    <label for="inp-ticket-qty">{t.pkg_2_qty_lbl}</label>
                    <input type="number" id="inp-ticket-qty" min="1" step="10" value="120" />
                  </div>
                  <div class="quick-mult-pills">
                    <button type="button" class="mult-pill" data-ticket-mult="1">{t.pkg_2_quick_1}</button>
                    <button type="button" class="mult-pill" data-ticket-mult="2">{t.pkg_2_quick_2}</button>
                    <button type="button" class="mult-pill" data-ticket-mult="3">{t.pkg_2_quick_3}</button>
                  </div>
                  <div class="pkg-live-calc" id="calc-tickets-preview">= 36,000 NTD$</div>
                </div>
              </div>

              <!-- Package 3: All-You-Can-Drink (400 NTD per guest / hour) -->
              <div class="drink-pkg-card active" data-pkg-card="aycd">
                <div class="pkg-card-top">
                  <div class="pkg-header-row">
                    <span class="pkg-tag-pill">{t.pkg_3_tag}</span>
                    <span class="pkg-status-indicator" data-select-lbl={t.pkg_select_badge} data-selected-lbl={t.pkg_selected_badge}>{t.pkg_selected_badge}</span>
                  </div>
