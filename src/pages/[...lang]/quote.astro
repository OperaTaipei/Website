<script>
  // =========================================================================
  // INTERACTIVE QUOTATION LOGIC, LIVE CALCULATOR, PDF EXPORT & EMAIL SENDER
  // =========================================================================

  // 1. Mobile Hamburger Menu & Scroll Navbar
  const navbar = document.getElementById('navbar');
  if (navbar) {
    window.addEventListener('scroll', () => {
      navbar.classList.toggle('scrolled', window.scrollY > 80);
    });
  }

  const hamburgerButton = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  if (hamburgerButton && mobileMenu) {
    hamburgerButton.addEventListener('click', () => {
      hamburgerButton.classList.toggle('open');
      mobileMenu.classList.toggle('open');
    });
    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', () => {
        hamburgerButton.classList.remove('open');
        mobileMenu.classList.remove('open');
      });
    });
  }

  // 2. Vibe Video Modal
  const openVibeBtn = document.getElementById('open-vibe-btn');
  const closeVibeBtn = document.getElementById('close-vibe-btn');
  const vibeModal = document.getElementById('vibe-modal');
  const vibeVideo = document.getElementById('vibe-video') as HTMLVideoElement | null;

  if (openVibeBtn && vibeModal) {
    openVibeBtn.addEventListener('click', () => {
      vibeModal.classList.add('active');
      if (vibeVideo) vibeVideo.play().catch(() => {});
    });
  }
  if (closeVibeBtn && vibeModal) {
    closeVibeBtn.addEventListener('click', () => {
      vibeModal.classList.remove('active');
      if (vibeVideo) {
        vibeVideo.pause();
        vibeVideo.currentTime = 0;
      }
    });
  }

  // 4. Form State & Elements
  const inpTitle = document.getElementById('inp-title') as HTMLInputElement;
  const inpDate = document.getElementById('inp-date') as HTMLInputElement;
  const inpGuestName = document.getElementById('inp-guest-name') as HTMLInputElement;
  const inpTaxId = document.getElementById('inp-tax-id') as HTMLInputElement;
  const inpContact = document.getElementById('inp-contact') as HTMLInputElement;
  const inpAttending = document.getElementById('inp-attending') as HTMLInputElement;
  const rngAttending = document.getElementById('rng-attending') as HTMLInputElement;
  const inpStartTime = document.getElementById('inp-start-time') as HTMLInputElement;
  const inpEndTime = document.getElementById('inp-end-time') as HTMLInputElement;
  const inpDuration = document.getElementById('inp-duration') as HTMLInputElement;
  const inpSetupTime = document.getElementById('inp-setup-time') as HTMLInputElement;
  const inpDjHours = document.getElementById('inp-dj-hours') as HTMLInputElement;
  const inpMusicStyle = document.getElementById('inp-music-style') as HTMLInputElement;
  const inpOtherRequests = document.getElementById('inp-other-requests') as HTMLTextAreaElement;

  // Drink package inputs
  const inpTallyCap = document.getElementById('inp-tally-cap') as HTMLInputElement;
  const inpTicketQty = document.getElementById('inp-ticket-qty') as HTMLInputElement;
  const inpAycdGuests = document.getElementById('inp-aycd-guests') as HTMLInputElement;
  const inpAycdHours = document.getElementById('inp-aycd-hours') as HTMLInputElement;
  const inpOtherPkgDesc = document.getElementById('inp-other-pkg-desc') as HTMLTextAreaElement;
  const inpOtherPkgAmount = document.getElementById('inp-other-pkg-amount') as HTMLInputElement;

  // Add-ons
  const chkAddFood = document.getElementById('chk-add-food') as HTMLInputElement;
  const foodBudgetWrap = document.getElementById('food-budget-wrap');
  const inpFoodPerGuest = document.getElementById('inp-food-per-guest') as HTMLInputElement;
  const selVenueTier = document.getElementById('sel-venue-tier') as HTMLSelectElement;

  // Default date to 2 weeks from today
  if (inpDate && !inpDate.value) {
    const d = new Date();
    d.setDate(d.getDate() + 14);
    inpDate.value = d.toISOString().split('T')[0];
  }

  // Track YES/NO options state
  const ynState: Record<string, 'YES' | 'NO'> = {
    vis_tvs: 'YES',
    vis_led: 'YES',
    vis_projectors: 'YES',
    vis_1f_tv: 'YES',
    vis_backdrop: 'NO',
    mus_dj: 'NO',
    mus_playlist: 'YES',
    mus_mics: 'YES',
    mus_style: 'YES',
    mus_photographer: 'NO'
  };

  let selectedPkg: 'tally' | 'tickets' | 'aycd' | 'other' = 'aycd';

  // Sync Attending Number & Slider & AYCD Guests
  const syncGuests = (val: number) => {
    const clean = Math.max(1, val || 1);
    if (inpAttending) inpAttending.value = String(clean);
    if (rngAttending) rngAttending.value = String(Math.min(300, clean));
    if (inpAycdGuests) inpAycdGuests.value = String(clean);
    updateQuote();
  };

  inpAttending?.addEventListener('input', () => syncGuests(Number(inpAttending.value)));
  rngAttending?.addEventListener('input', () => syncGuests(Number(rngAttending.value)));

  // Auto-calculate duration when start/end time changes
  const calcDurationFromTimes = () => {
    if (!inpStartTime?.value || !inpEndTime?.value) return;
    const [sh, sm] = inpStartTime.value.split(':').map(Number);
    const [eh, em] = inpEndTime.value.split(':').map(Number);
    let startMin = sh * 60 + sm;
    let endMin = eh * 60 + em;
    if (endMin <= startMin) endMin += 24 * 60; // Crosses midnight
    const hrs = Math.max(1, Math.round(((endMin - startMin) / 60) * 2) / 2);
    if (inpDuration) inpDuration.value = String(hrs);
    if (inpAycdHours) inpAycdHours.value = String(hrs);
    updateQuote();
  };

  inpStartTime?.addEventListener('change', calcDurationFromTimes);
  inpEndTime?.addEventListener('change', calcDurationFromTimes);
  inpDuration?.addEventListener('input', () => {
    if (inpAycdHours) inpAycdHours.value = inpDuration.value;
    updateQuote();
  });

  // YES/NO Toggles
  document.querySelectorAll('.yn-switch').forEach(sw => {
    const optKey = sw.getAttribute('data-opt');
    if (!optKey) return;
    const btns = sw.querySelectorAll('.yn-btn');
    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-val') as 'YES' | 'NO';
        ynState[optKey] = val;
        btns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        updateQuote();
      });
    });
  });

  // Drink Package Card Selection
  const pkgCards = document.querySelectorAll('.drink-pkg-card');
  const setActivePkg = (pkgKey: 'tally' | 'tickets' | 'aycd' | 'other') => {
    selectedPkg = pkgKey;
    pkgCards.forEach(card => {
      const k = card.getAttribute('data-pkg-card');
      const isSelected = k === pkgKey;
      card.classList.toggle('active', isSelected);
      const badge = card.querySelector('.pkg-status-indicator');
      if (badge) {
        badge.textContent = isSelected
          ? badge.getAttribute('data-selected-lbl')
          : badge.getAttribute('data-select-lbl');
      }
    });
    updateQuote();
  };

  pkgCards.forEach(card => {
    card.addEventListener('click', () => {
      const k = card.getAttribute('data-pkg-card') as 'tally' | 'tickets' | 'aycd' | 'other';
      if (k) setActivePkg(k);
    });
  });

  // Quick ticket multiplier pills
  document.querySelectorAll('.mult-pill').forEach(pill => {
    pill.addEventListener('click', (e) => {
      e.stopPropagation();
      const mult = Number(pill.getAttribute('data-ticket-mult') || 1);
      const guests = Number(inpAttending?.value || 60);
      if (inpTicketQty) inpTicketQty.value = String(guests * mult);
      setActivePkg('tickets');
    });
  });

  // Food checkbox toggle
  chkAddFood?.addEventListener('change', () => {
    if (foodBudgetWrap) {
      foodBudgetWrap.style.display = chkAddFood.checked ? 'flex' : 'none';
    }
    updateQuote();
  });

  // Format currency helper
  const fmtNTD = (num: number) => num.toLocaleString('en-US');

  // Build Quote Line Items & Sync Both Live Table and PDF DOM
  interface QuoteLine {
    item: string;
    qty: string;
    priceNum: number | null; // null means TBD
    priceText: string;
  }

  const getQuoteState = () => {
    const title = inpTitle?.value.trim() || 'Private Event at Opéra';
    const rawDate = inpDate?.value || '';
    const formattedDate = rawDate ? rawDate.replace(/-/g, '/') : '';
    const guestName = inpGuestName?.value.trim() || '';
    const taxId = inpTaxId?.value.trim() || '';
    const contact = inpContact?.value.trim() || '';
    const attending = Number(inpAttending?.value || 60);
    const startTime = inpStartTime?.value || '19:00';
    const endTime = inpEndTime?.value || '22:00';
    const duration = Number(inpDuration?.value || 3);
    const eventTimeStr = `${startTime} – ${endTime} (${duration} hrs)`;
    const setupTime = inpSetupTime?.value.trim() || '';
    const musicStyleText = inpMusicStyle?.value.trim() || '';
    const otherRequests = inpOtherRequests?.value.trim() || '';

    // Update live package mini previews
    const ticketQty = Math.max(1, Number(inpTicketQty?.value || 100));
    const ticketsTotal = ticketQty * 300;
    const calcTicketsEl = document.getElementById('calc-tickets-preview');
    if (calcTicketsEl) calcTicketsEl.textContent = `= ${fmtNTD(ticketsTotal)} NTD$`;

    const aycdGuests = Math.max(1, Number(inpAycdGuests?.value || attending));
    const aycdHours = Math.max(0.5, Number(inpAycdHours?.value || duration));
    const aycdTotal = Math.round(aycdGuests * aycdHours * 400);
    const calcAycdEl = document.getElementById('calc-aycd-preview');
    if (calcAycdEl) calcAycdEl.textContent = `= ${fmtNTD(aycdTotal)} NTD$`;

    const lines: QuoteLine[] = [];
    let hasTbd = false;

    // 1. Selected Drink Package Line
    if (selectedPkg === 'tally') {
      const cap = Number(inpTallyCap?.value || 0);
      const policyRadio = document.querySelector('input[name="tallyPolicy"]:checked') as HTMLInputElement;
      const policy = policyRadio?.value || 'Check with host to extend';
      if (cap > 0) {
        lines.push({
          item: `Open Bar Tally Up (Master Tab — Cap: ${fmtNTD(cap)} NTD, ${policy})`,
          qty: '1 Master Tab',
          priceNum: cap,
          priceText: `${fmtNTD(cap)} NTD$`
        });
      } else {
        hasTbd = true;
        lines.push({
          item: `Open Bar Tally Up (Master Tab — ${policy})`,
          qty: '1 Master Tab',
          priceNum: null,
          priceText: 'TBD (On consumption)'
        });
      }
    } else if (selectedPkg === 'tickets') {
      lines.push({
        item: 'Drink Tickets (300 NTD per ticket)',
        qty: `${fmtNTD(ticketQty)} tickets`,
        priceNum: ticketsTotal,
        priceText: `${fmtNTD(ticketsTotal)} NTD$`
      });
    } else if (selectedPkg === 'aycd') {
      lines.push({
        item: `All-You-Can-Drink (400 NTD / guest / hr)`,
        qty: `${aycdGuests} guests × ${aycdHours} hrs`,
        priceNum: aycdTotal,
        priceText: `${fmtNTD(aycdTotal)} NTD$`
      });
    } else if (selectedPkg === 'other') {
      const customDesc = inpOtherPkgDesc?.value.trim() || 'Custom Beverage / Rental Arrangement';
      const customAmt = Number(inpOtherPkgAmount?.value || 0);
      if (customAmt > 0) {
        lines.push({
          item: `Custom Package: ${customDesc}`,
          qty: '1',
          priceNum: customAmt,
          priceText: `${fmtNTD(customAmt)} NTD$`
        });
      } else {
        hasTbd = true;
        lines.push({
          item: `Custom Package: ${customDesc}`,
          qty: '1',
          priceNum: null,
          priceText: 'TBD'
        });
      }
    }

    // 2. Optional Finger Food & Catering
    if (chkAddFood?.checked) {
      const foodPerGuest = Math.max(0, Number(inpFoodPerGuest?.value || 400));
      const foodTotal = attending * foodPerGuest;
      lines.push({
        item: `Finger Food & Catering (${fmtNTD(foodPerGuest)} NTD / guest)`,
        qty: `${attending} guests`,
        priceNum: foodTotal,
        priceText: `${fmtNTD(foodTotal)} NTD$`
      });
    }

    // 3. Venue Privatization / Minimum Spend Tier
    const tier = selVenueTier?.value || 'none';
    const currentFbTotal = lines.reduce((acc, l) => acc + (l.priceNum || 0), 0);

    if (tier === 'day_venue') {
      const venueCost = Math.round(duration * 5000);
      lines.push({
        item: 'Daytime Venue Privatization (Venue Only — 5,000 NTD / hr)',
        qty: `${duration} hrs`,
        priceNum: venueCost,
        priceText: `${fmtNTD(venueCost)} NTD$`
      });
    } else if (tier === 'day_fb') {
      const minSpend = Math.round(duration * 15000);
      if (currentFbTotal < minSpend) {
        const diff = minSpend - currentFbTotal;
        lines.push({
          item: `Daytime Privatization Minimum Spend Balance (Min. ${fmtNTD(minSpend)} NTD)`,
          qty: 'Balance',
          priceNum: diff,
          priceText: `${fmtNTD(diff)} NTD$`
        });
      }
    } else if (tier === 'night_weekday') {
      const minSpend = 100000;
      if (currentFbTotal < minSpend) {
        const diff = minSpend - currentFbTotal;
        lines.push({
          item: 'Nighttime Weekday Minimum Spend Balance (Min. 100,000 NTD)',
          qty: 'Balance',
          priceNum: diff,
          priceText: `${fmtNTD(diff)} NTD$`
        });
      }
    } else if (tier === 'night_weekend') {
      const minSpend = 200000;
      if (currentFbTotal < minSpend) {
        const diff = minSpend - currentFbTotal;
        lines.push({
          item: 'Nighttime Weekend Minimum Spend Balance (Min. 200,000 NTD)',
          qty: 'Balance',
          priceNum: diff,
          priceText: `${fmtNTD(diff)} NTD$`
        });
      }
    }

    // 4. Add selected services (DJ at 1,000 NTD/h, Backdrop & Photographer with detailed quote note)
    const djHours = Math.max(0.5, Number(inpDjHours?.value || duration));
    if (ynState.mus_dj === 'YES') {
      const djCost = Math.round(djHours * 1000);
      lines.push({
        item: 'DJ (1,000 NTD$ / h)',
        qty: `${djHours} hrs`,
        priceNum: djCost,
        priceText: `${fmtNTD(djCost)} NTD$`
      });
    }
    if (ynState.vis_backdrop === 'YES') {
      hasTbd = true;
      lines.push({
        item: 'Backdrop Print (Detailed quotation will be provided)',
        qty: '1',
        priceNum: null,
        priceText: 'Detailed quote'
      });
    }
    if (ynState.mus_photographer === 'YES') {
      hasTbd = true;
      lines.push({
        item: 'Photographer (Detailed quotation will be provided)',
        qty: `${duration} hrs`,
        priceNum: null,
        priceText: 'Detailed quote'
      });
    }

    const subtotal = lines.reduce((sum, l) => sum + (l.priceNum || 0), 0);
    const vat = Math.round(subtotal * 0.05);
    const grandTotal = subtotal + vat;

    return {
      title,
      rawDate,
      formattedDate,
      guestName,
      taxId,
      contact,
      attending,
      startTime,
      endTime,
      duration,
      djHours,
      eventTimeStr,
      setupTime,
      musicStyleText,
      otherRequests,
      lines,
      hasTbd,
      subtotal,
      vat,
      grandTotal
    };
  };

  // Auto-enable DJ toggle if user edits DJ hours box directly
  inpDjHours?.addEventListener('input', () => {
    ynState.mus_dj = 'YES';
    const sw = document.querySelector('.yn-switch[data-opt="mus_dj"]');
    if (sw) {
      sw.querySelectorAll('.yn-btn').forEach(b => {
        b.classList.toggle('active', b.getAttribute('data-val') === 'YES');
      });
    }
    updateQuote();
  });

  const updateQuote = () => {
    const state = getQuoteState();

    // Update Live Web Summary
    const liveTitle = document.getElementById('live-summary-title');
    if (liveTitle) liveTitle.textContent = `Quote — ${state.title}`;

    const liveTbody = document.getElementById('live-quote-tbody');
    if (liveTbody) {
      liveTbody.innerHTML = state.lines
        .map(
          l => `
          <tr>
            <td>${l.item}</td>
            <td class="text-center">${l.qty}</td>
            <td class="text-right">${l.priceText}</td>
          </tr>
        `
        )
        .join('');
    }

    const tbdSuffix = state.hasTbd ? ' + TBD' : '';
    const elSub = document.getElementById('live-subtotal');
    const elVat = document.getElementById('live-vat');
    const elGrand = document.getElementById('live-grand-total');
    if (elSub) elSub.textContent = `${fmtNTD(state.subtotal)}${tbdSuffix}`;
    if (elVat) elVat.textContent = `${fmtNTD(state.vat)}`;
    if (elGrand) elGrand.textContent = `${fmtNTD(state.grandTotal)}${tbdSuffix}`;

    const tbdNote = document.getElementById('live-tbd-note');
    if (tbdNote) tbdNote.style.display = state.hasTbd ? 'block' : 'none';

    // Update Hidden Official 2-Page PDF DOM
    const setTxt = (id: string, val: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = val;
    };

    setTxt('pdf-title', state.title);
    setTxt('pdf-date', state.formattedDate);
    setTxt('pdf-guest-name', state.guestName);
    setTxt('pdf-tax-id', state.taxId);
    setTxt('pdf-contact', state.contact);
    setTxt('pdf-attending', `${state.attending} guests`);
    setTxt('pdf-event-time', state.eventTimeStr);
    setTxt('pdf-setup-time', state.setupTime);
    setTxt(
      'pdf-dj-label-cell',
      ynState.mus_dj === 'YES'
        ? `DJ (Cost is 1,000 NTD$ / h — ${state.djHours} hrs required)`
        : 'DJ (Cost is 1,000 NTD$ / h)'
    );
    setTxt(
      'pdf-music-style-cell',
      ynState.mus_style === 'YES' && state.musicStyleText
        ? `Music style (${state.musicStyleText})`
        : 'Music style'
    );

    // Sync YES/NO checkmarks in PDF Page 1
    Object.keys(ynState).forEach(k => {
      const isYes = ynState[k] === 'YES';
      setTxt(`pdf-${k}-yes`, isYes ? '✓' : '');
      setTxt(`pdf-${k}-no`, !isYes ? '✓' : '');
    });

    // Combine Other Requests + Music Style for PDF Page 1
    const otherParts: string[] = [];
    if (ynState.mus_style === 'YES' && state.musicStyleText) {
      otherParts.push(`Music Style Preference: ${state.musicStyleText}`);
    }
    if (state.otherRequests) {
      otherParts.push(state.otherRequests);
    }
    setTxt('pdf-other-requests-val', otherParts.join('\n'));

    // Populate PDF Page 2 Quote Table (minimum 6 rows to match template)
    const pdfQuoteTbody = document.getElementById('pdf-quote-tbody');
    if (pdfQuoteTbody) {
      const totalRows = Math.max(6, state.lines.length);
      let rowsHtml = '';
      for (let i = 0; i < totalRows; i++) {
        const line = state.lines[i];
        rowsHtml += `
          <tr>
            <td>${line ? line.item : '&nbsp;'}</td>
            <td>${line ? line.qty : '&nbsp;'}</td>
            <td style="text-align: right;">${line ? line.priceText : '&nbsp;'}</td>
          </tr>
        `;
      }
      pdfQuoteTbody.innerHTML = rowsHtml;
    }

    setTxt('pdf-subtotal', `${fmtNTD(state.subtotal)}${tbdSuffix}`);
    setTxt('pdf-vat', `${fmtNTD(state.vat)}`);
    setTxt('pdf-grand-total', `${fmtNTD(state.grandTotal)}${tbdSuffix}`);
  };

  // Attach input listeners to all form inputs
  document.querySelectorAll('#quote-builder-form input, #quote-builder-form textarea, #quote-builder-form select').forEach(el => {
    el.addEventListener('input', updateQuote);
    el.addEventListener('change', updateQuote);
  });

  // 5. URL Query Parameter State Serialization (Shareable Quote Link)
  const buildShareableUrl = () => {
    const state = getQuoteState();
    const params = new URLSearchParams();
    params.set('title', state.title);
    if (state.rawDate) params.set('date', state.rawDate);
    if (state.guestName) params.set('name', state.guestName);
    if (state.taxId) params.set('tax', state.taxId);
    if (state.contact) params.set('contact', state.contact);
    params.set('guests', String(state.attending));
    params.set('start', state.startTime);
    params.set('end', state.endTime);
    params.set('dur', String(state.duration));
    if (state.setupTime) params.set('setup', state.setupTime);
    params.set('pkg', selectedPkg);
    if (inpTallyCap?.value) params.set('cap', inpTallyCap.value);
    if (inpTicketQty?.value) params.set('tix', inpTicketQty.value);
    if (chkAddFood?.checked) params.set('food', inpFoodPerGuest?.value || '400');
    if (selVenueTier?.value && selVenueTier.value !== 'none') params.set('tier', selVenueTier.value);
    if (ynState.vis_backdrop === 'YES') params.set('backdrop', '1');
    if (ynState.mus_dj === 'YES') {
      params.set('dj', '1');
      params.set('djh', String(state.djHours));
    }
    if (ynState.mus_photographer === 'YES') params.set('photo', '1');
    if (state.otherRequests) params.set('notes', state.otherRequests);

    return `${window.location.origin}${window.location.pathname}?${params.toString()}`;
  };

  const restoreStateFromUrl = () => {
    const params = new URLSearchParams(window.location.search);
    if (params.size === 0) return;

    if (params.has('title') && inpTitle) inpTitle.value = params.get('title')!;
    if (params.has('date') && inpDate) inpDate.value = params.get('date')!;
    if (params.has('name') && inpGuestName) inpGuestName.value = params.get('name')!;
    if (params.has('tax') && inpTaxId) inpTaxId.value = params.get('tax')!;
    if (params.has('contact') && inpContact) inpContact.value = params.get('contact')!;
    if (params.has('guests')) syncGuests(Number(params.get('guests')));
    if (params.has('start') && inpStartTime) inpStartTime.value = params.get('start')!;
    if (params.has('end') && inpEndTime) inpEndTime.value = params.get('end')!;
    if (params.has('dur') && inpDuration) {
      inpDuration.value = params.get('dur')!;
      if (inpAycdHours) inpAycdHours.value = params.get('dur')!;
    }
    if (params.has('setup') && inpSetupTime) inpSetupTime.value = params.get('setup')!;
    if (params.has('cap') && inpTallyCap) inpTallyCap.value = params.get('cap')!;
    if (params.has('tix') && inpTicketQty) inpTicketQty.value = params.get('tix')!;
    if (params.has('food') && chkAddFood) {
      chkAddFood.checked = true;
      if (foodBudgetWrap) foodBudgetWrap.style.display = 'flex';
      if (inpFoodPerGuest) inpFoodPerGuest.value = params.get('food')!;
    }
    if (params.has('tier') && selVenueTier) selVenueTier.value = params.get('tier')!;
    if (params.get('backdrop') === '1') ynState.vis_backdrop = 'YES';
    if (params.get('dj') === '1') ynState.mus_dj = 'YES';
    if (params.has('djh') && inpDjHours) inpDjHours.value = params.get('djh')!;
    if (params.get('photo') === '1') ynState.mus_photographer = 'YES';
    if (params.has('notes') && inpOtherRequests) inpOtherRequests.value = params.get('notes')!;

    // Update UI switches to match restored ynState
    Object.keys(ynState).forEach(optKey => {
      const sw = document.querySelector(`.yn-switch[data-opt="${optKey}"]`);
      if (sw) {
        sw.querySelectorAll('.yn-btn').forEach(b => {
          b.classList.toggle('active', b.getAttribute('data-val') === ynState[optKey]);
        });
      }
    });

    if (params.has('pkg')) {
      const p = params.get('pkg') as 'tally' | 'tickets' | 'aycd' | 'other';
      if (['tally', 'tickets', 'aycd', 'other'].includes(p)) {
        setActivePkg(p);
      }
    }
  };

  // Preserve query parameters when switching language
  document.querySelectorAll('[data-lang-switch]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const baseHref = link.getAttribute('href') || '/quote';
      const url = new URL(buildShareableUrl());
      window.location.href = `${baseHref}${url.search}`;
    });
  });

  // 6. PDF Generation Function
  const generateAndDownloadPdf = async () => {
    updateQuote();
    const state = getQuoteState();
    const element = document.getElementById('pdf-document-template');
    if (!element) return;

    const btn = document.getElementById('btn-download-pdf');
    const origHtml = btn?.innerHTML || '';
    if (btn) btn.innerHTML = '<span>⏳ Generating PDF...</span>';

    const safeName = (state.guestName || state.title || 'Event')
      .replace(/[^a-zA-Z0-9\u4e00-\u9fa5_-]/g, '_')
      .slice(0, 30);
    const fileName = `Opera_Taipei_Quote_${safeName}_${state.rawDate || 'Reference'}.pdf`;

    try {
      const html2pdfLib = (window as any).html2pdf;
      if (html2pdfLib) {
        await html2pdfLib()
          .set({
            margin: 0,
            filename: fileName,
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: {
              scale: 2,
              useCORS: true,
              letterRendering: true,
              width: 794,
              windowWidth: 794
            },
            jsPDF: { unit: 'px', format: [794, 1122], orientation: 'portrait', hotfixes: ['px_scaling'] }
          })
          .from(element)
          .save();
      } else {
        window.print();
      }
    } catch (err) {
      console.error('PDF generation error, falling back to native print:', err);
      window.print();
    } finally {
      if (btn) btn.innerHTML = origHtml;
    }
  };

  document.getElementById('btn-download-pdf')?.addEventListener('click', generateAndDownloadPdf);
  document.getElementById('btn-print-pdf')?.addEventListener('click', () => {
    updateQuote();
    window.print();
  });

  // 7. Shareable Link Copy Button
  document.getElementById('btn-share-link')?.addEventListener('click', async () => {
    const shareUrl = buildShareableUrl();
    try {
      await navigator.clipboard.writeText(shareUrl);
      const fb = document.getElementById('share-link-feedback');
      if (fb) {
        fb.style.display = 'block';
        setTimeout(() => (fb.style.display = 'none'), 4000);
      }
    } catch {}
  });

  // 8. Build Plain-Text Summary & Send Email with Quote Request
  const buildEmailSummary = () => {
    const state = getQuoteState();
    const shareUrl = buildShareableUrl();
    const tbdSuffix = state.hasTbd ? ' + TBD' : '';

    const itemsList = state.lines
      .map(l => `  • ${l.item} (${l.qty}): ${l.priceText}`)
      .join('\n');

    const subject = `[Private Event Quote Request] ${state.title} - ${state.rawDate} (${state.attending} Guests)`;
    const body = `Hello Opéra Taipei Events Team,

I have generated a preliminary reference quote on your website and would love to get in touch to discuss and finalize our event details!
(Please also find the formatted PDF quotation attached to this email.)

=========================================
1. EVENT & HOST INFORMATION
=========================================
- Event Title: ${state.title}
- Event Date: ${state.formattedDate}
- Guest / Company Name: ${state.guestName || 'N/A'}
- Company Tax ID: ${state.taxId || 'N/A'}
- Contact Info: ${state.contact || 'N/A'}
- Attending Number: ${state.attending} guests
- Event Time: ${state.eventTimeStr}
- Setup Time: ${state.setupTime || 'N/A'}

=========================================
2. VISUALS & MUSIC OPTIONS
=========================================
- TVs: ${ynState.vis_tvs} | LED Walls: ${ynState.vis_led} | Window Projectors: ${ynState.vis_projectors} | 1F TV: ${ynState.vis_1f_tv}
- Backdrop Print: ${ynState.vis_backdrop}
- DJ: ${ynState.mus_dj} | Playlist: ${ynState.mus_playlist} | Microphones: ${ynState.mus_mics} | Photographer: ${ynState.mus_photographer}
- Music Style: ${state.musicStyleText || 'N/A'}
- Other Requests: ${state.otherRequests || 'None'}

=========================================
3. PRELIMINARY QUOTE BREAKDOWN (REFERENCE)
=========================================
${itemsList}

- TOTAL ($NT): ${fmtNTD(state.subtotal)}${tbdSuffix}
- 5% VAT ($NT): ${fmtNTD(state.vat)}
- AMOUNT TO BE PAID ($NT): ${fmtNTD(state.grandTotal)}${tbdSuffix}

=========================================
4. INTERACTIVE QUOTE LINK
=========================================
${shareUrl}

Best regards,
${state.guestName || 'Event Host'}`;

    return { subject, body };
  };

  const emailModal = document.getElementById('email-modal');
  const closeEmailModal = () => emailModal?.classList.remove('active');
  document.getElementById('close-email-modal')?.addEventListener('click', closeEmailModal);
  document.getElementById('modal-done-btn')?.addEventListener('click', closeEmailModal);

  document.getElementById('btn-send-email')?.addEventListener('click', async () => {
    // 1. Trigger PDF download so the user has the PDF file ready to attach
    await generateAndDownloadPdf();

    // 2. Prepare mailto link
    const { subject, body } = buildEmailSummary();
    const mailtoHref = `mailto:contact@opera-taipei.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

    const modalLink = document.getElementById('modal-mailto-link') as HTMLAnchorElement | null;
    if (modalLink) modalLink.href = mailtoHref;

    // 3. Show helpful modal & open email client
    emailModal?.classList.add('active');
    window.location.href = mailtoHref;
  });

  document.getElementById('modal-copy-text-btn')?.addEventListener('click', async (e) => {
    const { body } = buildEmailSummary();
    try {
      await navigator.clipboard.writeText(body);
      const btn = e.currentTarget as HTMLButtonElement;
      const orig = btn.textContent;
      btn.textContent = '✓ Copied!';
      setTimeout(() => (btn.textContent = orig), 2500);
    } catch {}
  });

  // Initialize on page load
  restoreStateFromUrl();
  updateQuote();
</script>
