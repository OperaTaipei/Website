      padding: 12px 14px;
    }
    .back-main-link {
      display: none;
    }
    .quote-summary-card {
      padding: 22px 16px;
    }
    .quote-summary-header h3 {
      font-size: 1.45rem;
    }
    /* Stacked Line-Item Cards on Mobile (< 640px) */
    .live-quote-table,
    .live-quote-table tbody,
    .live-quote-table tfoot {
      display: block;
      width: 100%;
    }
    .live-quote-table thead {
      display: none;
    }
    .live-quote-table tbody :global(tr) {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid rgba(201, 168, 76, 0.32);
      border-radius: 8px;
      padding: 12px 14px;
      margin-bottom: 10px;
      gap: 8px;
    }
    .live-quote-table tbody :global(td.td-item) {
      flex: 0 0 100%;
      width: 100%;
      border: none;
      padding: 0 0 8px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      font-size: 0.86rem;
      font-weight: 500;
      color: var(--color-white);
      line-height: 1.45;
      word-break: break-word;
    }
    .live-quote-table tbody :global(td.td-qty) {
      border: none;
      padding: 2px 0 0 0;
      text-align: left !important;
      font-size: 0.78rem;
      color: var(--color-text-muted);
    }
    .live-quote-table tbody :global(td.td-price) {
      border: none;
      padding: 2px 0 0 0;
      text-align: right !important;
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--color-gold-light);
    }
    .live-quote-table tfoot tr.summary-black-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #050505;
      border: 1px solid rgba(201, 168, 76, 0.3);
      border-radius: 6px;
      padding: 11px 14px;
      margin-top: 6px;
      gap: 10px;
    }
    .live-quote-table tfoot tr.grand-total-row {
      border: 1.5px solid var(--color-gold);
    }
    .live-quote-table tfoot tr.summary-black-row td {
      border: none;
      padding: 0;
      text-align: left !important;
      font-size: 0.82rem;
    }
    .live-quote-table tfoot tr.summary-black-row td:last-child {
      text-align: right !important;
      font-size: 0.95rem;
      white-space: nowrap;
    }
    .quote-actions-bar {
      flex-direction: column;
      align-items: stretch;
    }
    .quote-actions-bar button {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  // =========================================================================
  // INTERACTIVE QUOTATION LOGIC, LIVE CALCULATOR, PDF EXPORT & EMAIL SENDER
  // =========================================================================

  // 1. Mobile Hamburger Menu & Scroll Navbar
  const navbar = document.getElementById('navbar');
  if (navbar) {
    window.addEventListener('scroll', () => {
      navbar.classList.toggle('scrolled', window.scrollY > 80);
    });
  }

  const hamburgerButton = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  if (hamburgerButton && mobileMenu) {
    hamburgerButton.addEventListener('click', () => {
      hamburgerButton.classList.toggle('open');
      mobileMenu.classList.toggle('open');
    });
    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', () => {
        hamburgerButton.classList.remove('open');
        mobileMenu.classList.remove('open');
      });
    });
  }

  // 4. Form State & Elements
  const inpTitle = document.getElementById('inp-title') as HTMLInputElement;
  const inpDate = document.getElementById('inp-date') as HTMLInputElement;
  const inpGuestName = document.getElementById('inp-guest-name') as HTMLInputElement;
  const inpTaxId = document.getElementById('inp-tax-id') as HTMLInputElement;
  const inpContact = document.getElementById('inp-contact') as HTMLInputElement;
  const inpAttending = document.getElementById('inp-attending') as HTMLInputElement;
  const rngAttending = document.getElementById('rng-attending') as HTMLInputElement;
  const inpStartTime = document.getElementById('inp-start-time') as HTMLInputElement;
  const inpEndTime = document.getElementById('inp-end-time') as HTMLInputElement;
  const inpDuration = document.getElementById('inp-duration') as HTMLInputElement;
  const inpEarlySetupStart = document.getElementById('inp-early-setup-start') as HTMLInputElement;
  const inpEarlySetupEnd = document.getElementById('inp-early-setup-end') as HTMLInputElement;

  const inpEarlyStartText = document.getElementById('inp-early-start-text') as HTMLInputElement;
  const selEarlyStartAmPm = document.getElementById('sel-early-start-ampm') as HTMLSelectElement;
  const inpEarlyEndText = document.getElementById('inp-early-end-text') as HTMLInputElement;
  const selEarlyEndAmPm = document.getElementById('sel-early-end-ampm') as HTMLSelectElement;
  const earlySetupHoursEl = document.getElementById('early-setup-hours-val');
  const earlySetupFeeEl = document.getElementById('early-setup-fee-val');
  const inpStartText = document.getElementById('inp-start-text') as HTMLInputElement;
  const selStartAmPm = document.getElementById('sel-start-ampm') as HTMLSelectElement;
  const inpEndText = document.getElementById('inp-end-text') as HTMLInputElement;
  const selEndAmPm = document.getElementById('sel-end-ampm') as HTMLSelectElement;

  const inpDjHours = document.getElementById('inp-dj-hours') as HTMLInputElement;
  const inpMusicStyle = document.getElementById('inp-music-style') as HTMLInputElement;
  const inpOtherRequests = document.getElementById('inp-other-requests') as HTMLTextAreaElement;

  const parse12hTo24h = (rawText: string, period: string, fallback24: string) => {
    const clean = (rawText || '').trim().replace(/[^0-9:]/g, '');
    if (!clean) return fallback24;
    const parts = clean.split(':');
    let h = parseInt(parts[0] || '0', 10);
    let m = parseInt(parts[1] || '0', 10);
    if (isNaN(h)) return fallback24;
    if (isNaN(m) || m < 0) m = 0;
    if (m > 59) m = 59;

    const isPm = period === 'PM';
    if (h >= 1 && h <= 12) {
      if (isPm && h < 12) h += 12;
      if (!isPm && h === 12) h = 0;
    } else if (h > 23) {
      h = h % 24;
    }
    return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
  };

  const set12hComboFrom24h = (
    time24: string,
    textEl: HTMLInputElement | null,
    ampmEl: HTMLSelectElement | null
  ) => {
    if (!time24 || !time24.includes(':')) return;
    const [hStr, mStr] = time24.split(':');
    const h24 = Number(hStr);
    const period = h24 >= 12 ? 'PM' : 'AM';
    const h12 = h24 % 12 === 0 ? 12 : h24 % 12;
    if (textEl) textEl.value = `${String(h12).padStart(2, '0')}:${mStr}`;
    if (ampmEl) ampmEl.value = period;
  };

  const syncAllTimeCombos = () => {
    if (inpEarlySetupStart && inpEarlyStartText && selEarlyStartAmPm) {
      inpEarlySetupStart.value = parse12hTo24h(inpEarlyStartText.value, selEarlyStartAmPm.value, '15:00');
    }
    if (inpEarlySetupEnd && inpEarlyEndText && selEarlyEndAmPm) {
      inpEarlySetupEnd.value = parse12hTo24h(inpEarlyEndText.value, selEarlyEndAmPm.value, '17:00');
    }
    if (inpStartTime && inpStartText && selStartAmPm) {
      inpStartTime.value = parse12hTo24h(inpStartText.value, selStartAmPm.value, '19:00');
    }
    if (inpEndTime && inpEndText && selEndAmPm) {
      inpEndTime.value = parse12hTo24h(inpEndText.value, selEndAmPm.value, '22:00');
    }
  };

  const formatAmPm = (time24: string) => {
    if (!time24 || !time24.includes(':')) return time24;
    const [hStr, mStr] = time24.split(':');
    const h24 = Number(hStr);
    const period = h24 >= 12 ? 'PM' : 'AM';
    const h12 = h24 % 12 === 0 ? 12 : h24 % 12;
    return `${String(h12).padStart(2, '0')}:${mStr} ${period}`;
  };

  // Drink package inputs
  const inpTallyCap = document.getElementById('inp-tally-cap') as HTMLInputElement;
  const inpTicketQty = document.getElementById('inp-ticket-qty') as HTMLInputElement;
  const inpAycdGuests = document.getElementById('inp-aycd-guests') as HTMLInputElement;
  const inpAycdHours = document.getElementById('inp-aycd-hours') as HTMLInputElement;
  const inpOtherPkgDesc = document.getElementById('inp-other-pkg-desc') as HTMLTextAreaElement;
  const inpOtherPkgAmount = document.getElementById('inp-other-pkg-amount') as HTMLInputElement;

  // Add-ons
  const chkAddFood = document.getElementById('chk-add-food') as HTMLInputElement;
  const foodBudgetWrap = document.getElementById('food-budget-wrap');
  const inpFoodPerGuest = document.getElementById('inp-food-per-guest') as HTMLInputElement;
  const selVenueTier = document.getElementById('sel-venue-tier') as HTMLSelectElement;

  // Default date to 2 weeks from today
  if (inpDate && !inpDate.value) {
    const d = new Date();
    d.setDate(d.getDate() + 14);
    const yyyy = d.getFullYear();
    const mm = String(d.getMonth() + 1).padStart(2, '0');
    const dd = String(d.getDate()).padStart(2, '0');
    inpDate.value = `${yyyy}-${mm}-${dd}`;
  }

  // Interactive Visual Calendar State & Renderer
  const calSelectedDateText = document.getElementById('cal-selected-date-text');
  const calDayTypeBadge = document.getElementById('cal-day-type-badge');
  const calMonthTitle = document.getElementById('cal-month-title');
  const calDaysGrid = document.getElementById('cal-days-grid');
  const calPrevBtn = document.getElementById('cal-prev-month');
  const calNextBtn = document.getElementById('cal-next-month');

  const MONTH_NAMES = [
    'January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December'
  ];
  const DAY_NAMES = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

  const initDateParts = (inpDate?.value || '').split('-').map(Number);
  let calViewYear = initDateParts[0] || new Date().getFullYear();
  let calViewMonth = (initDateParts[1] || new Date().getMonth() + 1) - 1;

  const renderCalendar = () => {
    if (!calDaysGrid || !inpDate) return;
    const selectedVal = inpDate.value;
    if (selectedVal) {
      const [sy, sm, sd] = selectedVal.split('-').map(Number);
      const selDateObj = new Date(sy, sm - 1, sd);
      const dow = selDateObj.getDay();
      const dayName = DAY_NAMES[dow] || '';
      const isWknd = dow === 5 || dow === 6;
      if (calSelectedDateText) {
        calSelectedDateText.textContent = `📅 ${dayName}, ${sy}/${String(sm).padStart(2, '0')}/${String(sd).padStart(2, '0')}`;
      }
      if (calDayTypeBadge) {
        calDayTypeBadge.textContent = isWknd ? 'Weekend (Fri / Sat)' : 'Weekday (Sun – Thu)';
        calDayTypeBadge.classList.toggle('is-weekend', isWknd);
      }
    }

    if (calMonthTitle) {
      calMonthTitle.textContent = `${MONTH_NAMES[calViewMonth]} ${calViewYear}`;
    }

    const firstDayOfMonth = new Date(calViewYear, calViewMonth, 1).getDay();
    const daysInMonth = new Date(calViewYear, calViewMonth + 1, 0).getDate();

    let html = '';
    for (let i = 0; i < firstDayOfMonth; i++) {
      html += `<span class="cal-day empty"></span>`;
    }
    for (let d = 1; d <= daysInMonth; d++) {
      const iso = `${calViewYear}-${String(calViewMonth + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
      const dow = new Date(calViewYear, calViewMonth, d).getDay();
      const isWknd = dow === 5 || dow === 6;
      const isSelected = iso === selectedVal;
      const cls = ['cal-day', isWknd ? 'wknd' : '', isSelected ? 'selected' : ''].filter(Boolean).join(' ');
      html += `<button type="button" class="${cls}" data-cal-date="${iso}">${d}</button>`;
    }
    calDaysGrid.innerHTML = html;

    calDaysGrid.querySelectorAll('button[data-cal-date]').forEach(btn => {
      btn.addEventListener('click', () => {
        const picked = btn.getAttribute('data-cal-date');
        if (picked && inpDate) {
          inpDate.value = picked;
          renderCalendar();
          updateQuote();
        }
      });
    });
  };

  calPrevBtn?.addEventListener('click', () => {
    calViewMonth--;
    if (calViewMonth < 0) {
      calViewMonth = 11;
      calViewYear--;
    }
    renderCalendar();
  });

  calNextBtn?.addEventListener('click', () => {
    calViewMonth++;
    if (calViewMonth > 11) {
      calViewMonth = 0;
      calViewYear++;
    }
    renderCalendar();
  });

  // Track YES/NO options state
  const ynState: Record<string, 'YES' | 'NO'> = {
    early_setup: 'NO',
    outside_catering: 'NO',
    vis_tvs: 'YES',
    vis_led: 'YES',
    vis_projectors: 'YES',
    vis_1f_tv: 'YES',
    vis_backdrop: 'NO',
    mus_dj: 'NO',
    mus_playlist: 'YES',
    mus_mics: 'YES',
    mus_style: 'YES',
    mus_photographer: 'NO'
  };

  type PkgType = 'none' | 'tally' | 'tickets' | 'aycd' | 'other';
  let selectedPkg: PkgType = 'aycd';

  // Sync Attending Number & Slider & AYCD Guests
  const syncGuests = (val: number) => {
    const clean = Math.max(1, val || 1);
    if (inpAttending) inpAttending.value = String(clean);
    if (rngAttending) rngAttending.value = String(Math.min(300, clean));
    if (inpAycdGuests) inpAycdGuests.value = String(clean);
    updateQuote();
  };

  inpAttending?.addEventListener('input', () => syncGuests(Number(inpAttending.value)));
  rngAttending?.addEventListener('input', () => syncGuests(Number(rngAttending.value)));

  // Auto-calculate duration when start/end time changes
  const calcDurationFromTimes = () => {
    syncAllTimeCombos();
    if (!inpStartTime?.value || !inpEndTime?.value) return;
    const [sh, sm] = inpStartTime.value.split(':').map(Number);
    const [eh, em] = inpEndTime.value.split(':').map(Number);
    let startMin = sh * 60 + sm;
    let endMin = eh * 60 + em;
    if (endMin <= startMin) endMin += 24 * 60; // Crosses midnight
    const hrs = Math.max(1, Math.round(((endMin - startMin) / 60) * 2) / 2);
    if (inpDuration) inpDuration.value = String(hrs);
    if (inpAycdHours) inpAycdHours.value = String(hrs);
    updateQuote();
  };

  inpStartText?.addEventListener('input', calcDurationFromTimes);
  selStartAmPm?.addEventListener('change', calcDurationFromTimes);
  inpEndText?.addEventListener('input', calcDurationFromTimes);
  selEndAmPm?.addEventListener('change', calcDurationFromTimes);
  inpDuration?.addEventListener('input', () => {
    if (inpAycdHours) inpAycdHours.value = inpDuration.value;
    updateQuote();
  });

  // YES/NO Toggles
  document.querySelectorAll('.yn-switch').forEach(sw => {
    const optKey = sw.getAttribute('data-opt');
    if (!optKey) return;
    const btns = sw.querySelectorAll('.yn-btn');
    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-val') as 'YES' | 'NO';
        ynState[optKey] = val;
        btns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        updateQuote();
      });
    });
  });

  // Drink Package Card Selection (Supports "none" + clicking active card to deselect)
  const pkgCards = document.querySelectorAll('.drink-pkg-card');
  const setActivePkg = (pkgKey: PkgType) => {
    selectedPkg = pkgKey;
    pkgCards.forEach(card => {
      const k = card.getAttribute('data-pkg-card');
      const isSelected = k === pkgKey;
      card.classList.toggle('active', isSelected);
      const badge = card.querySelector('.pkg-status-indicator');
      if (badge) {
        badge.textContent = isSelected
          ? badge.getAttribute('data-selected-lbl')
          : badge.getAttribute('data-select-lbl');
      }
    });
    updateQuote();
  };

  pkgCards.forEach(card => {
    card.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const clickedInteractiveChild = Boolean(target.closest('input, textarea, select, label, .mult-pill'));
      const k = card.getAttribute('data-pkg-card') as PkgType;
      if (!k) return;
      if (k !== 'none' && selectedPkg === k && !clickedInteractiveChild) {
        setActivePkg('none');
      } else {
        setActivePkg(k);
      }
    });
  });

  // Quick ticket multiplier pills
  document.querySelectorAll('.mult-pill').forEach(pill => {
    pill.addEventListener('click', (e) => {
      e.stopPropagation();
      const mult = Number(pill.getAttribute('data-ticket-mult') || 1);
      const guests = Number(inpAttending?.value || 60);
      if (inpTicketQty) inpTicketQty.value = String(guests * mult);
      setActivePkg('tickets');
    });
  });

  // Food checkbox toggle
  chkAddFood?.addEventListener('change', () => {
    if (foodBudgetWrap) {
      foodBudgetWrap.style.display = chkAddFood.checked ? 'flex' : 'none';
    }
    updateQuote();
  });

  // Format currency helper
  const fmtNTD = (num: number) => num.toLocaleString('en-US');

  // Build Quote Line Items & Sync Both Live Table and PDF DOM
  interface QuoteLine {
    item: string;
    qty: string;
    priceNum: number | null; // null means TBD
    priceText: string;
  }

  const getQuoteState = () => {
    syncAllTimeCombos();
    const title = inpTitle?.value.trim() || 'Private Event at Opéra';
    const rawDate = inpDate?.value || '';
    const formattedDate = rawDate ? rawDate.replace(/-/g, '/') : '';
    const guestName = inpGuestName?.value.trim() || '';
    const taxId = inpTaxId?.value.trim() || '';
    const contact = inpContact?.value.trim() || '';
    const attending = Number(inpAttending?.value || 60);
    const startTime = inpStartTime?.value || '19:00';
    const endTime = inpEndTime?.value || '22:00';
    const duration = Number(inpDuration?.value || 3);
    const eventTimeStr = `${formatAmPm(startTime)} – ${formatAmPm(endTime)}`;
    const earlySetupStart = inpEarlySetupStart?.value || '15:00';
    const earlySetupEnd = inpEarlySetupEnd?.value || '17:00';
    const [esh, esm] = earlySetupStart.split(':').map(Number);
    const [eeh, eem] = earlySetupEnd.split(':').map(Number);
    const esStartMin = esh * 60 + esm;
    let esEndMin = eeh * 60 + eem;
    if (esEndMin <= esStartMin) esEndMin += 24 * 60; // Crosses midnight
    const earlySetupHours = Math.max(0.5, Math.round(((esEndMin - esStartMin) / 60) * 2) / 2);
    const earlySetupCost = Math.round(earlySetupHours * 5000);

    if (earlySetupHoursEl) earlySetupHoursEl.textContent = String(earlySetupHours);
    if (earlySetupFeeEl) earlySetupFeeEl.textContent = `= ${fmtNTD(earlySetupCost)} NTD$`;

    const setupTime =
      ynState.early_setup === 'YES'
        ? `Early setup: ${formatAmPm(earlySetupStart)} – ${formatAmPm(earlySetupEnd)} (${earlySetupHours} hrs — 5,000 NTD$ / h)`
        : '2h prior to event start (Free of charge)';
    const musicStyleText = inpMusicStyle?.value.trim() || '';
    const otherRequests = inpOtherRequests?.value.trim() || '';

    // Update live package mini previews
    const ticketQty = Math.max(1, Number(inpTicketQty?.value || 100));
    const ticketsTotal = ticketQty * 300;
    const calcTicketsEl = document.getElementById('calc-tickets-preview');
    if (calcTicketsEl) calcTicketsEl.textContent = `= ${fmtNTD(ticketsTotal)} NTD$`;

    const aycdGuests = Math.max(1, Number(inpAycdGuests?.value || attending));
    const aycdHours = Math.max(0.5, Number(inpAycdHours?.value || duration));
    const aycdTotal = Math.round(aycdGuests * aycdHours * 400);
    const calcAycdEl = document.getElementById('calc-aycd-preview');
    if (calcAycdEl) calcAycdEl.textContent = `= ${fmtNTD(aycdTotal)} NTD$`;

    // Determine Daytime (ends at or before 20:00) vs. Nighttime (ends after 20:00)
    const [sh, sm] = startTime.split(':').map(Number);
    const [eh, em] = endTime.split(':').map(Number);
    const startMin = sh * 60 + sm;
    let endMin = eh * 60 + em;
    if (endMin <= startMin) endMin += 24 * 60; // Crosses midnight
    const isDaytime = startMin >= 6 * 60 && endMin <= 20 * 60;

    // Determine Weekday (Sun-Thu) vs. Weekend (Fri-Sat) from selected date
    const [yy, mm, dd] = (rawDate || '').split('-').map(Number);
    const dateObj = yy && mm && dd ? new Date(yy, mm - 1, dd) : new Date();
    const dayOfWeek = dateObj.getDay();
    const dayName = DAY_NAMES[dayOfWeek] || 'Day';
    const isWeekend = dayOfWeek === 5 || dayOfWeek === 6;

    const serviceLines: QuoteLine[] = [];
    let hasTbd = false;

    // 1. Selected Drink Package Line
    if (selectedPkg === 'tally') {
      const cap = Number(inpTallyCap?.value || 0);
      const policyRadio = document.querySelector('input[name="tallyPolicy"]:checked') as HTMLInputElement;
      const policy = policyRadio?.value || 'Check with host to extend';
      if (cap > 0) {
        serviceLines.push({
          item: `Open Bar Tally Up (Master Tab — Cap: ${fmtNTD(cap)} NTD, ${policy})`,
          qty: '1 Master Tab',
          priceNum: cap,
          priceText: `${fmtNTD(cap)} NTD$`
        });
      } else {
        hasTbd = true;
        serviceLines.push({
          item: `Open Bar Tally Up (Master Tab — ${policy})`,
          qty: '1 Master Tab',
          priceNum: null,
          priceText: 'TBD (On consumption)'
        });
      }
    } else if (selectedPkg === 'tickets') {
      serviceLines.push({
        item: 'Drink Tickets (300 NTD per ticket)',
        qty: `${fmtNTD(ticketQty)} tickets`,
        priceNum: ticketsTotal,
        priceText: `${fmtNTD(ticketsTotal)} NTD$`
      });
    } else if (selectedPkg === 'aycd') {
      serviceLines.push({
        item: `All-You-Can-Drink (400 NTD / guest / hr)`,
        qty: `${aycdGuests} guests × ${aycdHours} hrs`,
        priceNum: aycdTotal,
        priceText: `${fmtNTD(aycdTotal)} NTD$`
      });
    } else if (selectedPkg === 'other') {
      const customDesc = inpOtherPkgDesc?.value.trim() || 'Custom Beverage / Rental Arrangement';
      const customAmt = Number(inpOtherPkgAmount?.value || 0);
      if (customAmt > 0) {
        serviceLines.push({
          item: `Custom Package: ${customDesc}`,
          qty: '1',
          priceNum: customAmt,
          priceText: `${fmtNTD(customAmt)} NTD$`
        });
      } else {
        hasTbd = true;
        serviceLines.push({
          item: `Custom Package: ${customDesc}`,
          qty: '1',
          priceNum: null,
          priceText: 'TBD'
        });
      }
    }

    // 2. Optional Finger Food & Catering / Outside Catering
    if (chkAddFood?.checked) {
      const foodPerGuest = Math.max(0, Number(inpFoodPerGuest?.value || 400));
      const foodTotal = attending * foodPerGuest;
      serviceLines.push({
        item: `Finger Food & Catering (${fmtNTD(foodPerGuest)} NTD / guest)`,
        qty: `${attending} guests`,
        priceNum: foodTotal,
        priceText: `${fmtNTD(foodTotal)} NTD$`
      });
    }
    if (ynState.outside_catering === 'YES') {
      serviceLines.push({
        item: 'Outside Catering (Corkage Fee 5,000 NTD$)',
        qty: '1',
        priceNum: 5000,
        priceText: '5,000 NTD$'
      });
    }

    // 3. DJ, Backdrop & Photographer services
    const djHours = Math.max(0.5, Number(inpDjHours?.value || duration));
    if (ynState.mus_dj === 'YES') {
      const djCost = Math.round(djHours * 1000);
      serviceLines.push({
        item: 'DJ (1,000 NTD$ / h)',
        qty: `${djHours} hrs`,
        priceNum: djCost,
        priceText: `${fmtNTD(djCost)} NTD$`
      });
    }
    if (ynState.vis_backdrop === 'YES') {
      hasTbd = true;
      serviceLines.push({
        item: 'Backdrop Print (Detailed quotation will be provided)',
        qty: '1',
        priceNum: null,
        priceText: 'Detailed quote'
      });
    }
    if (ynState.mus_photographer === 'YES') {
      hasTbd = true;
      serviceLines.push({
        item: 'Photographer (Detailed quotation will be provided)',
        qty: `${duration} hrs`,
        priceNum: null,
        priceText: 'Detailed quote'
      });
    }

    // 4. Apply Booking & Minimum Spend Rules based on Date (Weekday/Weekend) & Time (Before/After 20:00)
    const hasFoodOrDrink = selectedPkg !== 'none' || Boolean(chkAddFood?.checked);
    const servicesTotal = serviceLines.reduce((acc, l) => acc + (l.priceNum || 0), 0);

    const lines: QuoteLine[] = [];
    let minSpendRequired = 0;
    let remainingToSpend = 0;
    let ruleSlotBadge = '';
    let ruleSlotTitle = '';

    if (isDaytime && !hasFoodOrDrink) {
      // Daytime Option 1: No food or drink menu selected -> 5,000 NTD$ / hr + requested add-ons
      const venueCost = Math.round(duration * 5000);
      ruleSlotBadge = `${dayName} · Daytime (Before 20:00) · Option 1`;
      ruleSlotTitle = `No Food or Drink Menu — Venue Rental 5,000 NTD$ / hr (${fmtNTD(venueCost)} NTD$) + Add-ons`;
      lines.push({
        item: 'Daytime Venue Rental (No Food/Drink Menu — 5,000 NTD$ / hr)',
        qty: `${duration} hrs`,
        priceNum: venueCost,
        priceText: `${fmtNTD(venueCost)} NTD$`
      });
      lines.push(...serviceLines);
    } else if (isDaytime && hasFoodOrDrink) {
      // Daytime Option 2: Food and/or drinks selected -> 15,000 NTD$ / hr minimum spend
      minSpendRequired = Math.round(duration * 15000);
      ruleSlotBadge = `${dayName} · Daytime (Before 20:00) · Option 2`;
      ruleSlotTitle = `Daytime with Food/Drinks — Minimum Spend 15,000 NTD$ / hr (${fmtNTD(minSpendRequired)} NTD$)`;
      lines.push(...serviceLines);
      if (servicesTotal < minSpendRequired) {
        remainingToSpend = minSpendRequired - servicesTotal;
        lines.push({
          item: `Remaining Amount to Spend (Daytime Minimum 15,000 NTD$ / hr × ${duration} hrs)`,
          qty: 'Min. Spend Balance',
          priceNum: remainingToSpend,
          priceText: `${fmtNTD(remainingToSpend)} NTD$`
        });
      }
    } else if (!isWeekend) {
      // Nighttime Weekday (Sun–Thu, after 20:00 / 21:00) -> 100,000 NTD$ minimum spend (follows Option 2)
      minSpendRequired = 100000;
      ruleSlotBadge = `${dayName} · Weekday Nighttime`;
      ruleSlotTitle = `Weekday Nighttime Privatization — Minimum Spend 100,000 NTD$`;
      lines.push(...serviceLines);
      if (servicesTotal < minSpendRequired) {
        remainingToSpend = minSpendRequired - servicesTotal;
        lines.push({
          item: 'Remaining Amount to Spend (Weekday Minimum Spend 100,000 NTD$)',
          qty: 'Min. Spend Balance',
          priceNum: remainingToSpend,
          priceText: `${fmtNTD(remainingToSpend)} NTD$`
        });
      }
    } else {
      // Nighttime Weekend (Fri & Sat, after 20:00 / 21:00) -> 200,000 NTD$ minimum spend (follows Option 2)
      minSpendRequired = 200000;
      ruleSlotBadge = `${dayName} · Weekend Nighttime`;
      ruleSlotTitle = `Weekend Nighttime Privatization — Minimum Spend 200,000 NTD$`;
      lines.push(...serviceLines);
      if (servicesTotal < minSpendRequired) {
        remainingToSpend = minSpendRequired - servicesTotal;
        lines.push({
          item: 'Remaining Amount to Spend (Weekend Minimum Spend 200,000 NTD$)',
          qty: 'Min. Spend Balance',
          priceNum: remainingToSpend,
          priceText: `${fmtNTD(remainingToSpend)} NTD$`
        });
      }
    }

    // 5. Early Setup (5,000 NTD$ / h × hours) is always added on top of the minimum spend
    if (ynState.early_setup === 'YES') {
      lines.push({
        item: `Early Setup (${formatAmPm(earlySetupStart)} – ${formatAmPm(earlySetupEnd)} — 5,000 NTD$ / h)`,
        qty: `${earlySetupHours} hrs`,
        priceNum: earlySetupCost,
        priceText: `${fmtNTD(earlySetupCost)} NTD$`
      });
    }

    const subtotal = lines.reduce((sum, l) => sum + (l.priceNum || 0), 0);
    const vat = Math.round(subtotal * 0.05);
    const grandTotal = subtotal + vat;

    return {
      title,
      rawDate,
      formattedDate,
      dayName,
      isWeekend,
      isDaytime,
      guestName,
      taxId,
      contact,
      attending,
      startTime,
      endTime,
      duration,
      djHours,
      eventTimeStr,
      earlySetupStart,
      earlySetupEnd,
      earlySetupHours,
      setupTime,
      musicStyleText,
      otherRequests,
      lines,
      servicesTotal,
      minSpendRequired,
      remainingToSpend,
      ruleSlotBadge,
      ruleSlotTitle,
      hasTbd,
      subtotal,
      vat,
      grandTotal
    };
  };

  // Auto-enable Early Setup toggle if user edits early setup time input or AM/PM directly
  const onEarlySetupTimeInput = () => {
    syncAllTimeCombos();
    ynState.early_setup = 'YES';
    const sw = document.querySelector('.yn-switch[data-opt="early_setup"]');
    if (sw) {
      sw.querySelectorAll('.yn-btn').forEach(b => {
        b.classList.toggle('active', b.getAttribute('data-val') === 'YES');
      });
    }
    updateQuote();
  };
  inpEarlySetupText?.addEventListener('input', onEarlySetupTimeInput);
  selEarlySetupAmPm?.addEventListener('change', onEarlySetupTimeInput);

  // Auto-enable DJ toggle if user edits DJ hours box directly
  inpDjHours?.addEventListener('input', () => {
    ynState.mus_dj = 'YES';
    const sw = document.querySelector('.yn-switch[data-opt="mus_dj"]');
    if (sw) {
      sw.querySelectorAll('.yn-btn').forEach(b => {
        b.classList.toggle('active', b.getAttribute('data-val') === 'YES');
      });
    }
    updateQuote();
  });

  const updateQuote = () => {
    const state = getQuoteState();

    // Update Live Web Summary
    const liveTitle = document.getElementById('live-summary-title');
    if (liveTitle) liveTitle.textContent = `Quote — ${state.title}`;

    const liveRuleBadge = document.getElementById('live-rule-badge');
    const liveRuleTitle = document.getElementById('live-rule-title');
    const liveRemainingBox = document.getElementById('live-remaining-spend-box');
    if (liveRuleBadge) liveRuleBadge.textContent = state.ruleSlotBadge;
    if (liveRuleTitle) liveRuleTitle.textContent = state.ruleSlotTitle;
    if (liveRemainingBox) {
      if (state.minSpendRequired > 0 && state.remainingToSpend > 0) {
        liveRemainingBox.style.display = 'block';
        liveRemainingBox.innerHTML = `
          <div>Remaining amount to spend to reach the minimum: <span class="rem-highlight">${fmtNTD(state.remainingToSpend)} NTD$</span></div>
          <div style="font-size:0.78rem;color:rgba(245,240,232,0.75);margin-top:3px;">
            Selected services: <strong>${fmtNTD(state.servicesTotal)} NTD$</strong> / Required minimum spend: <strong>${fmtNTD(state.minSpendRequired)} NTD$</strong>.
          </div>
        `;
      } else if (state.minSpendRequired > 0 && state.remainingToSpend === 0) {
        liveRemainingBox.style.display = 'block';
        liveRemainingBox.innerHTML = `
          <div style="color:#8fd19e;font-weight:600;">✓ Minimum spend of ${fmtNTD(state.minSpendRequired)} NTD$ reached (Selected services: ${fmtNTD(state.servicesTotal)} NTD$).</div>
        `;
      } else {
        liveRemainingBox.style.display = 'none';
      }
    }

    const liveTbody = document.getElementById('live-quote-tbody');
    if (liveTbody) {
      liveTbody.innerHTML = state.lines
        .map(
          l => `
          <tr>
            <td class="td-item">${l.item}</td>
            <td class="td-qty text-center">${l.qty}</td>
            <td class="td-price text-right">${l.priceText}</td>
          </tr>
        `
        )
        .join('');
    }

    const tbdSuffix = state.hasTbd ? ' + TBD' : '';
    const elSub = document.getElementById('live-subtotal');
    const elVat = document.getElementById('live-vat');
    const elGrand = document.getElementById('live-grand-total');
    if (elSub) elSub.textContent = `${fmtNTD(state.subtotal)}${tbdSuffix}`;
    if (elVat) elVat.textContent = `${fmtNTD(state.vat)}`;
    if (elGrand) elGrand.textContent = `${fmtNTD(state.grandTotal)}${tbdSuffix}`;

    const tbdNote = document.getElementById('live-tbd-note');
    if (tbdNote) tbdNote.style.display = state.hasTbd ? 'block' : 'none';

    // Update Hidden Official 2-Page PDF DOM
    const setTxt = (id: string, val: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = val;
    };

    setTxt('pdf-title', state.title);
    setTxt('pdf-date', state.formattedDate);
    setTxt('pdf-guest-name', state.guestName);
    setTxt('pdf-tax-id', state.taxId);
    setTxt('pdf-contact', state.contact);
    setTxt('pdf-attending', `${state.attending} guests`);
    setTxt('pdf-event-time', state.eventTimeStr);
    setTxt('pdf-setup-time', state.setupTime);
    setTxt(
      'pdf-dj-label-cell',
      ynState.mus_dj === 'YES'
        ? `DJ (Cost is 1,000 NTD$ / h — ${state.djHours} hrs required)`
        : 'DJ (Cost is 1,000 NTD$ / h)'
    );
    setTxt(
      'pdf-music-style-cell',
      ynState.mus_style === 'YES' && state.musicStyleText
        ? `Music style (${state.musicStyleText})`
        : 'Music style'
    );

    // Sync YES/NO checkmarks in PDF Page 1
    Object.keys(ynState).forEach(k => {
      const isYes = ynState[k] === 'YES';
      setTxt(`pdf-${k}-yes`, isYes ? '✓' : '');
      setTxt(`pdf-${k}-no`, !isYes ? '✓' : '');
    });

    // Combine Other Requests + Music Style for PDF Page 1
    const otherParts: string[] = [];
    if (ynState.mus_style === 'YES' && state.musicStyleText) {
      otherParts.push(`Music Style Preference: ${state.musicStyleText}`);
    }
    if (state.otherRequests) {
      otherParts.push(state.otherRequests);
    }
    setTxt('pdf-other-requests-val', otherParts.join('\n'));

    // Populate PDF Page 2 Quote Table (minimum 6 rows to match template)
    const pdfQuoteTbody = document.getElementById('pdf-quote-tbody');
    if (pdfQuoteTbody) {
      const totalRows = Math.max(6, state.lines.length);
      let rowsHtml = '';
      for (let i = 0; i < totalRows; i++) {
        const line = state.lines[i];
        rowsHtml += `
          <tr>
            <td>${line ? line.item : '&nbsp;'}</td>
            <td>${line ? line.qty : '&nbsp;'}</td>
            <td style="text-align: right;">${line ? line.priceText : '&nbsp;'}</td>
          </tr>
        `;
      }
      pdfQuoteTbody.innerHTML = rowsHtml;
    }

    setTxt('pdf-subtotal', `${fmtNTD(state.subtotal)}${tbdSuffix}`);
    setTxt('pdf-vat', `${fmtNTD(state.vat)}`);
    setTxt('pdf-grand-total', `${fmtNTD(state.grandTotal)}${tbdSuffix}`);
  };

  // Attach input listeners to all form inputs
  document.querySelectorAll('#quote-builder-form input, #quote-builder-form textarea, #quote-builder-form select').forEach(el => {
    el.addEventListener('input', updateQuote);
    el.addEventListener('change', updateQuote);
  });

  // 5. URL Query Parameter State Serialization (Shareable Quote Link)
  const buildShareableUrl = () => {
    const state = getQuoteState();
    const params = new URLSearchParams();
    params.set('title', state.title);
    if (state.rawDate) params.set('date', state.rawDate);
    if (state.guestName) params.set('name', state.guestName);
    if (state.taxId) params.set('tax', state.taxId);
    if (state.contact) params.set('contact', state.contact);
    params.set('guests', String(state.attending));
    params.set('start', state.startTime);
    params.set('end', state.endTime);
    params.set('dur', String(state.duration));
    if (ynState.early_setup === 'YES') {
      params.set('es', '1');
      params.set('est', state.earlySetupStart);
      params.set('eet', state.earlySetupEnd);
    }
    params.set('pkg', selectedPkg);
    if (inpTallyCap?.value) params.set('cap', inpTallyCap.value);
    if (inpTicketQty?.value) params.set('tix', inpTicketQty.value);
    if (chkAddFood?.checked) params.set('food', inpFoodPerGuest?.value || '400');
    if (ynState.outside_catering === 'YES') params.set('oc', '1');
    if (selVenueTier?.value && selVenueTier.value !== 'none') params.set('tier', selVenueTier.value);
    if (ynState.vis_backdrop === 'YES') params.set('backdrop', '1');
    if (ynState.mus_dj === 'YES') {
      params.set('dj', '1');
      params.set('djh', String(state.djHours));
    }
    if (ynState.mus_photographer === 'YES') params.set('photo', '1');
    if (state.otherRequests) params.set('notes', state.otherRequests);

    return `${window.location.origin}${window.location.pathname}?${params.toString()}`;
  };

  const restoreStateFromUrl = () => {
    const params = new URLSearchParams(window.location.search);
    if (params.size === 0) return;

    if (params.has('title') && inpTitle) inpTitle.value = params.get('title')!;
    if (params.has('date') && inpDate) {
      inpDate.value = params.get('date')!;
      const parts = inpDate.value.split('-').map(Number);
      if (parts[0] && parts[1]) {
        calViewYear = parts[0];
        calViewMonth = parts[1] - 1;
      }
    }
    if (params.has('name') && inpGuestName) inpGuestName.value = params.get('name')!;
    if (params.has('tax') && inpTaxId) inpTaxId.value = params.get('tax')!;
    if (params.has('contact') && inpContact) inpContact.value = params.get('contact')!;
    if (params.has('guests')) syncGuests(Number(params.get('guests')));
    if (params.has('start') && inpStartTime) {
      inpStartTime.value = params.get('start')!;
      set12hComboFrom24h(inpStartTime.value, inpStartText, selStartAmPm);
    }
    if (params.has('end') && inpEndTime) {
      inpEndTime.value = params.get('end')!;
      set12hComboFrom24h(inpEndTime.value, inpEndText, selEndAmPm);
    }
    if (params.has('dur') && inpDuration) {
      inpDuration.value = params.get('dur')!;
      if (inpAycdHours) inpAycdHours.value = params.get('dur')!;
    }
    if (params.get('es') === '1') ynState.early_setup = 'YES';
    if (params.has('est') && inpEarlySetupStart) {
      inpEarlySetupStart.value = params.get('est')!;
      set12hComboFrom24h(inpEarlySetupStart.value, inpEarlyStartText, selEarlyStartAmPm);
    }
    if (params.has('eet') && inpEarlySetupEnd) {
      inpEarlySetupEnd.value = params.get('eet')!;
      set12hComboFrom24h(inpEarlySetupEnd.value, inpEarlyEndText, selEarlyEndAmPm);
    }
    if (params.has('cap') && inpTallyCap) inpTallyCap.value = params.get('cap')!;
    if (params.has('tix') && inpTicketQty) inpTicketQty.value = params.get('tix')!;
    if (params.has('food') && chkAddFood) {
      chkAddFood.checked = true;
      if (foodBudgetWrap) foodBudgetWrap.style.display = 'flex';
      if (inpFoodPerGuest) inpFoodPerGuest.value = params.get('food')!;
    }
    if (params.get('oc') === '1') ynState.outside_catering = 'YES';
    if (params.has('tier') && selVenueTier) selVenueTier.value = params.get('tier')!;
    if (params.get('backdrop') === '1') ynState.vis_backdrop = 'YES';
    if (params.get('dj') === '1') ynState.mus_dj = 'YES';
    if (params.has('djh') && inpDjHours) inpDjHours.value = params.get('djh')!;
    if (params.get('photo') === '1') ynState.mus_photographer = 'YES';
    if (params.has('notes') && inpOtherRequests) inpOtherRequests.value = params.get('notes')!;

    // Update UI switches to match restored ynState
    Object.keys(ynState).forEach(optKey => {
      const sw = document.querySelector(`.yn-switch[data-opt="${optKey}"]`);
      if (sw) {
        sw.querySelectorAll('.yn-btn').forEach(b => {
          b.classList.toggle('active', b.getAttribute('data-val') === ynState[optKey]);
        });
      }
    });

    if (params.has('pkg')) {
      const p = params.get('pkg') as PkgType;
      if (['none', 'tally', 'tickets', 'aycd', 'other'].includes(p)) {
        setActivePkg(p);
      }
    }
  };

  // Preserve query parameters when switching language
  document.querySelectorAll('[data-lang-switch]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const baseHref = link.getAttribute('href') || '/quote';
      const url = new URL(buildShareableUrl());
      window.location.href = `${baseHref}${url.search}`;
    });
  });

  // 6. PDF Generation Function (Combined Solution: In-Viewport Origin Mount + Page-by-Page html2canvas & jsPDF)
  const generateAndDownloadPdf = async () => {
    updateQuote();
    const state = getQuoteState();
    const wrapper = document.getElementById('pdf-render-wrapper');
    const element = document.getElementById('pdf-document-template');
    if (!wrapper || !element) return;

    const btn = document.getElementById('btn-download-pdf');
    const origHtml = btn?.innerHTML || '';
    if (btn) btn.innerHTML = '<span>⏳ Generating PDF...</span>';

    const safeName = (state.guestName || state.title || 'Event')
      .replace(/[^a-zA-Z0-9\u4e00-\u9fa5_-]/g, '_')
      .slice(0, 30);
    const fileName = `Opera_Taipei_Quote_${safeName}_${state.rawDate || 'Reference'}.pdf`;

    const savedScrollX = window.scrollX;
    const savedScrollY = window.scrollY;

    // Cover viewport with a dark loading overlay while mounting PDF template at (0,0)
    const backdrop = document.createElement('div');
    backdrop.style.cssText =
      'position:fixed;inset:0;background:rgba(8,8,8,0.92);z-index:99999;display:flex;align-items:center;justify-content:center;color:#e2c47a;font-family:Montserrat,sans-serif;font-size:0.95rem;letter-spacing:0.1em;';
    backdrop.textContent = '⏳ Generating PDF Quotation...';
    document.body.appendChild(backdrop);

    try {
      wrapper.classList.add('pdf-capturing');
      window.scrollTo(0, 0);

      // Allow browser two animation frames to lay out and paint the visible template at (0,0)
      await new Promise<void>(resolve =>
        requestAnimationFrame(() => requestAnimationFrame(() => resolve()))
      );

      const html2canvasFn = (window as any).html2canvas;
      const jsPDFClass = (window as any).jspdf?.jsPDF || (window as any).jsPDF;
      const pages = element.querySelectorAll('.pdf-page');

      if (html2canvasFn && jsPDFClass && pages.length > 0) {
        const pdf = new jsPDFClass({
          orientation: 'portrait',
          unit: 'mm',
          format: 'a4',
          compress: true
        });

        for (let i = 0; i < pages.length; i++) {
          const pageEl = pages[i] as HTMLElement;
          const canvas = await html2canvasFn(pageEl, {
            scale: 2,
            useCORS: true,
            backgroundColor: '#ffffff',
            width: 794,
            height: 1120,
            windowWidth: 794,
            scrollX: 0,
            scrollY: 0
          });
          const imgData = canvas.toDataURL('image/jpeg', 0.98);
          if (i > 0) pdf.addPage();
          pdf.addImage(imgData, 'JPEG', 0, 0, 210, 297);
        }

        pdf.save(fileName);
      } else {
        const html2pdfLib = (window as any).html2pdf;
        if (html2pdfLib) {
          await html2pdfLib()
            .set({
              margin: 0,
              filename: fileName,
              image: { type: 'jpeg', quality: 0.98 },
              html2canvas: {
                scale: 2,
                useCORS: true,
                letterRendering: true,
                width: 794,
                windowWidth: 794,
                scrollX: 0,
                scrollY: 0
              },
              jsPDF: { unit: 'px', format: [794, 1122], orientation: 'portrait', hotfixes: ['px_scaling'] }
            })
            .from(element)
            .save();
        } else {
          window.print();
        }
      }
    } catch (err) {
      console.error('PDF generation error, falling back to native print:', err);
      window.print();
    } finally {
      wrapper.classList.remove('pdf-capturing');
      window.scrollTo(savedScrollX, savedScrollY);
      backdrop.remove();
      if (btn) btn.innerHTML = origHtml;
    }
  };

  document.getElementById('btn-download-pdf')?.addEventListener('click', generateAndDownloadPdf);

  // 8. Build Plain-Text Summary & Send Email with Quote Request
  const buildEmailSummary = () => {
    const state = getQuoteState();
    const shareUrl = buildShareableUrl();
    const tbdSuffix = state.hasTbd ? ' + TBD' : '';

    const itemsList = state.lines
      .map(l => `  • ${l.item} (${l.qty}): ${l.priceText}`)
      .join('\n');

    const subject = `[Private Event Quote Request] ${state.title} - ${state.rawDate} (${state.attending} Guests)`;
    const body = `Hello Opéra Taipei Events Team,

I have generated a preliminary reference quote on your website and would love to get in touch to discuss and finalize our event details!
(Please also find the formatted PDF quotation attached to this email.)

=========================================
1. EVENT & HOST INFORMATION
=========================================
- Event Title: ${state.title}
- Event Date: ${state.formattedDate}
- Guest / Company Name: ${state.guestName || 'N/A'}
- Company Tax ID: ${state.taxId || 'N/A'}
- Contact Info: ${state.contact || 'N/A'}
- Attending Number: ${state.attending} guests
- Event Time: ${state.eventTimeStr}
- Setup Time: ${state.setupTime || 'N/A'}

=========================================
2. VISUALS & MUSIC OPTIONS
=========================================
- TVs: ${ynState.vis_tvs} | LED Walls: ${ynState.vis_led} | Window Projectors: ${ynState.vis_projectors} | 1F TV: ${ynState.vis_1f_tv}
- Backdrop Print: ${ynState.vis_backdrop}
- DJ: ${ynState.mus_dj} | Playlist: ${ynState.mus_playlist} | Microphones: ${ynState.mus_mics} | Photographer: ${ynState.mus_photographer}
- Music Style: ${state.musicStyleText || 'N/A'}
- Other Requests: ${state.otherRequests || 'None'}

=========================================
3. PRELIMINARY QUOTE BREAKDOWN (REFERENCE)
=========================================
${itemsList}

- TOTAL ($NT): ${fmtNTD(state.subtotal)}${tbdSuffix}
- 5% VAT ($NT): ${fmtNTD(state.vat)}
- AMOUNT TO BE PAID ($NT): ${fmtNTD(state.grandTotal)}${tbdSuffix}

=========================================
4. INTERACTIVE QUOTE LINK
=========================================
${shareUrl}

Best regards,
${state.guestName || 'Event Host'}`;

    return { subject, body };
  };

  document.getElementById('btn-send-email')?.addEventListener('click', async () => {
    // 1. Trigger PDF download so the user has the PDF file ready to attach
    await generateAndDownloadPdf();

    // 2. Open email client with pre-filled quote request
    const { subject, body } = buildEmailSummary();
    const mailtoHref = `mailto:contact@opera-taipei.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    window.location.href = mailtoHref;
  });

  // Initialize on page load
  restoreStateFromUrl();
  renderCalendar();
  updateQuote();
</script>
