  /* Print Stylesheet: Print ONLY the 2-Page Official PDF Template */
  @media print {
    @page {
      size: A4 portrait;
      margin: 0;
    }
    body {
      background: #ffffff !important;
      color: #000000 !important;
    }
    .web-ui-container {
      display: none !important;
    }
    #pdf-render-wrapper {
      display: block !important;
      position: static !important;
      left: 0 !important;
      top: 0 !important;
      z-index: 1 !important;
      overflow: visible !important;
    }
    #pdf-document-template {
      width: 100% !important;
    }
  }

  /* Responsive Design */
  @media (max-width: 960px) {
    .venue-stats-grid {
      grid-template-columns: 1fr 1fr;
    }
    .floorplan-showcase-grid,
    .options-two-col,
    .drink-packages-grid,
    .terms-and-legal-grid {
      grid-template-columns: 1fr;
    }
    .quote-gallery-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .quote-section {
      padding: 60px 20px;
    }
    .form-grid-2,
    .time-range-grid,
    .venue-stats-grid,
    .quote-gallery-grid {
      grid-template-columns: 1fr;
