  .pdf-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
  }

  .pdf-title-date-box {
    width: 340px;
    border: 1px solid #000000;
  }

  .pdf-title-cell {
    padding: 10px 12px;
    font-size: 22px;
    font-weight: 700;
    border-bottom: 1px solid #000000;
