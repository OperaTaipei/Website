    align-items: center;
  }

  .pdf-logo-box {
    width: 150px;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-right: 20px;
  }

  .pdf-logo-box img {
    max-height: 105px;
    width: auto;
    object-fit: contain;
  }

  /* Page 1 Table */
  .pdf-main-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
    margin-bottom: 16px;
  }

  .pdf-main-table th,
  .pdf-main-table td {
    border: 1px solid #000000;
