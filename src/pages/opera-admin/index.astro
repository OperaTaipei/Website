    function updateItemMediaPreview() {
      const select = document.getElementById('item-media');
      if (!select) return;
      const val = select.value;
      const img = document.getElementById('item-media-preview');
      const placeholder = document.getElementById('item-media-preview-placeholder');
      
      if (!val) {
        if (img) img.style.display = 'none';
        if (img) img.src = '';
        if (placeholder) placeholder.style.display = 'block';
        return;
      }

      const mediaItem = window.allMedia.find(m => m.id === Number(val));
      if (mediaItem) {
        if (img) {
          img.src = mediaItem.url;
          img.style.display = 'block';
        }
        if (placeholder) placeholder.style.display = 'none';
      } else {
        if (img) img.style.display = 'none';
        if (img) img.src = '';
        if (placeholder) placeholder.style.display = 'block';
      }
    }

