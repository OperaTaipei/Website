            .category-title { border-bottom: 1px solid #444; font-size: 1.5rem; text-transform: uppercase; margin-bottom: 1rem; padding-bottom: 0.25rem; letter-spacing: 0.05em; }
            .menu-item { display: flex; flex-direction: column; margin-bottom: 1.25rem; }
            .item-header { display: flex; justify-content: space-between; font-weight: bold; font-size: 1.1rem; }
            .item-desc { font-style: italic; color: #444; font-size: 0.95rem; margin-top: 0.25rem; }
            .item-ings { font-size: 0.85rem; color: #555; text-transform: uppercase; margin-top: 0.15rem; }
            .item-tags { font-size: 0.85rem; color: #777; font-style: italic; margin-top: 0.15rem; }
            @media print {
              body { padding: 1.5rem; }
              button { display: none; }
            }
          </style>
        </head>
        <body>
          <h1>OPERA TAIPEI</h1>
      `;

      const categoriesGrouped = {};
      data.forEach(item => {
        if (!categoriesGrouped[item.category_name]) categoriesGrouped[item.category_name] = [];
        categoriesGrouped[item.category_name].push(item);
      });

      Object.keys(categoriesGrouped).forEach(cat => {
        const categoryId = categoriesGrouped[cat][0].category_id;
        const includeDesc = document.querySelector(`.category-opt-desc[data-category-id="${categoryId}"]`).checked;
        const includePrice = document.querySelector(`.category-opt-price[data-category-id="${categoryId}"]`).checked;
        const includeIng = document.querySelector(`.category-opt-ing[data-category-id="${categoryId}"]`).checked;
        const includeTags = document.querySelector(`.category-opt-tags[data-category-id="${categoryId}"]`).checked;

        html += `<div class="category-section">`;
        html += `<h2 class="category-title">${cat}</h2>`;
        categoriesGrouped[cat].forEach(item => {
          html += `<div class="menu-item">`;
          let nameStr = item.name;
          if (item.bottle_type && item.bottle_volume) {
            nameStr += ` (${item.bottle_type}, ${item.bottle_volume}L)`;
          }
          html += `<div class="item-header"><span>${nameStr}</span>`;
          if (includePrice) html += `<span>$${item.price}</span>`;
          html += `</div>`;
          if (includeIng && item.ingredients && item.ingredients.length > 0) {
            html += `<div class="item-ings">${item.ingredients.join(' / ')}</div>`;
          }
          if (includeTags && item.tags && item.tags.length > 0) {
            html += `<div class="item-tags">${item.tags.join(', ')}</div>`;
          }
          if (includeDesc && item.description) {
            html += `<div class="item-desc">${item.description}</div>`;
          }
          html += `</div>`;
        });
        html += `</div>`;
      });

      html += `
        <script>
          window.onload = function() {
            window.print();
          }
        <\/script>
        </body>
        </html>
      `;

      printWindow.document.write(html);
      printWindow.document.close();
    }

    function backupDatabase() {
      const link1 = document.createElement('a');
      link1.href = '/opera-admin/api/backup?type=structure';
      link1.download = 'schema_backup.sql';
      document.body.appendChild(link1);
      link1.click();
      document.body.removeChild(link1);

      setTimeout(() => {
        const link2 = document.createElement('a');
        link2.href = '/opera-admin/api/backup?type=data';
        link2.download = 'data_backup.sql';
        document.body.appendChild(link2);
        link2.click();
        document.body.removeChild(link2);
      }, 500);
    }

    // Reusable client-side table sorting logic
    document.addEventListener('click', (event) => {
      const header = event.target.closest('th');
      if (!header) return;

      const table = header.closest('table');
      if (!table) return;

      const tbody = table.querySelector('tbody');
      if (!tbody) return;

      // Skip non-sortable columns
      if (header.dataset.sortable === 'false') return;

      const index = Array.from(header.parentNode.children).indexOf(header);
      const rows = Array.from(tbody.querySelectorAll('tr'));
      if (rows.length <= 1) return;

      // Skip the placeholder row if there's no data
      const isPlaceholder = rows.length === 1 && rows[0].querySelector('td[colspan]');
      if (isPlaceholder) return;

      // Toggles sorted state: ascending -> descending -> ascending
      const currentSort = header.getAttribute('aria-sort');
      const isAscending = currentSort !== 'ascending';

      // Extract sorting key from a table cell
      const getCellValue = (tr, idx) => {
        const cell = tr.children[idx];
        if (!cell) return '';

        // Checkbox
        const checkbox = cell.querySelector('input[type="checkbox"]');
        if (checkbox) {
          return checkbox.checked ? 1 : 0;
        }

        // Custom sort value
        if (cell.dataset.sortValue !== undefined) {
          return cell.dataset.sortValue;
        }

        // Default text content
        return cell.textContent.trim();
      };

      const sortedRows = rows.sort((a, b) => {
        const valA = getCellValue(a, index);
        const valB = getCellValue(b, index);

        // Numeric sort if both are purely numeric (optionally with currency symbols/units)
        const cleanNum = (val) => {
          if (typeof val === 'number') return val;
          const str = String(val).trim();
          // Match numbers with optional currency symbols, commas, and common units
          const match = str.match(/^\s*[$\-─+±~≈<>≥≤NTD¥€£]*\s*(\d+(?:[.,]\d+)?)\s*(?:L|ml|%)?\s*$/i);
          if (match) {
            const numStr = match[1].replace(/,/g, '');
            return parseFloat(numStr);
          }
          return NaN;
        };

        const numA = cleanNum(valA);
        const numB = cleanNum(valB);

        if (!isNaN(numA) && !isNaN(numB)) {
          return isAscending ? numA - numB : numB - numA;
        }

        // String sort
        const strA = String(valA);
        const strB = String(valB);
        return isAscending
          ? strA.localeCompare(strB, undefined, { numeric: true, sensitivity: 'base' })
          : strB.localeCompare(strA, undefined, { numeric: true, sensitivity: 'base' });
      });

      // Clear any active sort markers in the current table headers
      table.querySelectorAll('th').forEach(th => th.removeAttribute('aria-sort'));

      // Mark the current header
      header.setAttribute('aria-sort', isAscending ? 'ascending' : 'descending');

      // Append sorted rows to body
      tbody.append(...sortedRows);
    });
  </script>
</body>
</html>
