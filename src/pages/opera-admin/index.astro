---
export const prerender = false;

import * as dbHelpers from '../../lib/db';

const db = Astro.locals.runtime?.env?.DB;
if (!db) {
  return new Response("Cloudflare D1 Database binding is missing. Check your wrangler configuration.", { status: 500 });
}

// 1. Fetch initial lists
const menuItems = await dbHelpers.getMenuItems(db);
const categories = await dbHelpers.getCategories(db);
const ingredients = await dbHelpers.getIngredients(db);
const flavorTags = await dbHelpers.getFlavorTags(db);
const media = await dbHelpers.getMedia(db);

// Sort categories and menu items alphabetically ascending by name
categories.sort((a, b) => a.name.localeCompare(b.name));
menuItems.sort((a, b) => a.name.localeCompare(b.name));

// Helper to check Cloudflare Access headers if available
const userEmail = Astro.request.headers.get('Cf-Access-Authenticated-User-Email') || 'Local Dev Admin';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Opera menu manager</title>
  <style>
    /* =========================================================================
       1. THEME DESIGN TOKENS (CSS VARIABLES)
       ========================================================================= */
    :root {
      --bg-dark: #121214;
      --bg-card: #1e1e24;
      --primary: #c5a880;
      --primary-hover: #b4966e;
      --text: #e2e8f0;
      --text-muted: #94a3b8;
      --border: #2d2d34;
      --danger: #ef4444;
      --success: #10b981;
    }

    /* =========================================================================
       2. RESET & BASE STYLES
       ========================================================================= */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text);
      padding: 3rem 3rem 2rem 3rem;
    }

    /* =========================================================================
       3. HEADER & NAVIGATION STYLES
       ========================================================================= */
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
      border-bottom: 1px solid var(--border);
      padding-bottom: 1rem;
    }

    .header-left, .header-right {
      flex: 1;
      display: flex;
    }

    .header-left {
      justify-content: flex-start;
    }

    .header-right {
      justify-content: flex-end;
    }

    .header-center {
      flex: 2;
      text-align: center;
    }

    .logo {
      height: 40px;
      width: auto;
    }

    h1 {
      color: var(--primary);
      font-weight: 600;
    }

    .user-tag {
      font-size: 0.85rem;
      color: var(--text-muted);
      background: var(--border);
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
    }

    /* =========================================================================
       4. LAYOUT & SIDEBAR STYLES
       ========================================================================= */
    .grid {
      display: grid;
      grid-template-columns: 250px 1fr;
      gap: 2rem;
    }

    .sidebar {
      background: var(--bg-card);
      border-radius: 8px;
      padding: 1.5rem;
      border: 1px solid var(--border);
      height: fit-content;
    }

    .sidebar-nav button {
      display: block;
      width: 100%;
      text-align: left;
      padding: 0.75rem 1rem;
      background: none;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      border-radius: 4px;
      font-size: 1rem;
      margin-bottom: 0.5rem;
    }

    .sidebar-nav button.active {
      background: var(--primary);
      color: var(--bg-dark);
      font-weight: bold;
    }

    .content-area {
      background: var(--bg-card);
      border-radius: 8px;
      padding: 2rem;
      border: 1px solid var(--border);
    }

    /* =========================================================================
       5. ACTIONS BAR & BUTTON STYLES
       ========================================================================= */
    .action-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
    }

    .btn {
      background: var(--primary);
      color: var(--bg-dark);
      border: none;
      padding: 0.5rem 1rem;
      font-weight: bold;
      border-radius: 4px;
      cursor: pointer;
      font-size: 0.9rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      transition: background 0.2s;
    }

    .btn:hover {
      background: var(--primary-hover);
    }

    .btn-danger {
      background: var(--danger);
      color: white;
    }

    .btn-danger:hover {
      background: #dc2626;
    }

    .btn-secondary {
      background: #475569;
      color: white;
    }

    .btn-secondary:hover {
      background: #334155;
    }

    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    /* =========================================================================
       6. TABLE & DATA VISUALIZATION
       ========================================================================= */
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 1.5rem;
    }

    th, td {
      padding: 1rem;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }

    th {
      color: var(--text-muted);
      font-weight: 600;
    }

    tr:hover {
      background: rgba(255, 255, 255, 0.02);
    }

    .badge {
      display: inline-block;
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
      font-size: 0.75rem;
      background: var(--border);
      color: var(--text-muted);
      margin-right: 0.25rem;
      margin-bottom: 0.25rem;
    }

    .badge-success {
      background: rgba(16, 185, 129, 0.1);
      color: var(--success);
      border: 1px solid var(--success);
    }

    .badge-danger {
      background: rgba(239, 68, 68, 0.1);
      color: var(--danger);
      border: 1px solid var(--danger);
    }

    /* =========================================================================
       7. FORM CONTROL STYLES
       ========================================================================= */
    .form-group {
      margin-bottom: 1.25rem;
    }

    .form-group label {
      display: block;
      margin-bottom: 0.5rem;
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    .form-control {
      width: 100%;
      background: var(--bg-dark);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 0.75rem;
      border-radius: 4px;
      font-size: 0.95rem;
    }

    .form-control:focus {
      outline: 1px solid var(--primary);
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .form-group-checkbox {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 1rem;
    }

    /* =========================================================================
       8. TAB CONTROLS (LANGUAGES & CATEGORIES)
       ========================================================================= */
    .tabs {
      display: flex;
      border-bottom: 1px solid var(--border);
      margin-bottom: 1rem;
    }

    .tab-btn {
      background: none;
      border: none;
      color: var(--text-muted);
      padding: 0.5rem 1rem;
      cursor: pointer;
      border-bottom: 2px solid transparent;
      font-weight: 500;
    }

    .tab-btn.active {
      color: var(--primary);
      border-bottom-color: var(--primary);
    }

    .tab-content {
      display: none;
      background: rgba(0, 0, 0, 0.15);
      padding: 1rem;
      border-radius: 4px;
      border: 1px solid var(--border);
      margin-bottom: 1rem;
    }

    .tab-content.active {
      display: block;
    }

    .copy-helper-btn {
      float: right;
      font-size: 0.75rem;
      background: #334155;
      color: #cbd5e1;
      border: none;
      padding: 0.2rem 0.5rem;
      border-radius: 3px;
      cursor: pointer;
      margin-bottom: 0.5rem;
    }

    .copy-helper-btn:hover {
      background: #475569;
    }

    /* =========================================================================
       9. MODALS & DIALOG OVERRIDES
       ========================================================================= */
    .dialog {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      padding: 2rem;
      margin: auto;
      max-width: 600px;
      width: 90%;
    }

    .dialog::backdrop {
      background: rgba(0, 0, 0, 0.8);
    }

    .dialog-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.5rem;
    }

    .dialog h3 {
      color: var(--primary);
    }

    .dialog-close {
      background: none;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 1.5rem;
    }

    /* =========================================================================
       10. SLIDERS & TOGGLES
       ========================================================================= */
    .switch {
      position: relative;
      display: inline-block;
      width: 44px;
      height: 24px;
    }

    .switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }

    .slider {
      position: absolute;
      cursor: pointer;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: #475569;
      transition: .4s;
      border-radius: 24px;
    }

    .slider:before {
      position: absolute;
      content: "";
      height: 16px;
      width: 16px;
      left: 4px;
      bottom: 4px;
      background-color: white;
      transition: .4s;
      border-radius: 50%;
    }

    input:checked + .slider {
      background-color: var(--success);
    }

    input:checked + .slider:before {
      transform: translateX(20px);
    }

    .select-checkbox {
      width: 18px;
      height: 18px;
      cursor: pointer;
    }

    /* =========================================================================
       11. PRINT & EXPORT LAYOUT STYLES
       ========================================================================= */
    .print-panel {
      background: #1e293b;
      padding: 1.5rem;
      border-radius: 8px;
      border: 1px solid #334155;
      margin-top: 1.5rem;
    }

    .print-category-group {
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 1.25rem;
      margin-bottom: 1.5rem;
      background: rgba(255, 255, 255, 0.01);
    }

    .category-header-controls {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.75rem;
      margin-bottom: 0.75rem;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .category-select-label {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 1.1rem;
      cursor: pointer;
    }

    .category-export-options {
      display: flex;
      gap: 1rem;
      align-items: center;
    }

    .category-export-options label {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      font-size: 0.85rem;
      color: var(--text-muted);
      cursor: pointer;
    }

    .category-items-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 0.75rem;
      padding: 0.5rem 0;
    }

    .print-item-label {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.95rem;
      cursor: pointer;
      padding: 0.25rem;
      border-radius: 4px;
    }

    .print-item-label:hover {
      background: rgba(255, 255, 255, 0.03);
    }

    .print-item-label input:disabled + span {
      color: var(--text-muted);
      opacity: 0.6;
      cursor: not-allowed;
    }

    .muted-price {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .print-actions-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border);
      flex-wrap: wrap;
      gap: 1rem;
    }

    .global-helper-bar {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 1rem;
      margin-bottom: 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .global-helper-buttons {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    /* =========================================================================
       12. ALERTS, LOGGERS & LOADING SPINNER
       ========================================================================= */
    #alert-banner {
      display: none;
      padding: 1rem;
      border-radius: 4px;
      margin-bottom: 1.5rem;
      font-weight: 500;
    }

    #alert-banner.success {
      background: rgba(16, 185, 129, 0.15);
      color: var(--success);
      border: 1px solid var(--success);
    }

    #alert-banner.error {
      background: rgba(239, 68, 68, 0.15);
      color: var(--danger);
      border: 1px solid var(--danger);
    }

    #loading-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.6);
      z-index: 9999;
      justify-content: center;
      align-items: center;
      color: white;
      font-size: 1.5rem;
      font-weight: bold;
    }

    .spinner {
      border: 4px solid rgba(255, 255, 255, 0.1);
      width: 50px;
      height: 50px;
      border-radius: 50%;
      border-left-color: var(--primary);
      animation: spin 1s linear infinite;
      margin-bottom: 1rem;
    }

    @keyframes spin {
      0% {
        transform: rotate(0deg);
      }
      100% {
        transform: rotate(360deg);
      }
    }
  </style>
</head>
<body>

  <header>
    <div class="header-left">
      <img src="/images/opera-logo.png" alt="Opera Logo" class="logo" />
    </div>
    <div class="header-center">
      <h1>Opera menu manager</h1>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.25rem;">Relational Database & Menu Management</p>
    </div>
    <div class="header-right">
      <span class="user-tag">User: {userEmail}</span>
    </div>
  </header>

  <!-- Alert Banner -->
  <div id="alert-banner"></div>

  <!-- Loading Overlay -->
  <div id="loading-overlay">
    <div style="text-align: center;">
      <div class="spinner"></div>
      <p>Saving Changes...</p>
    </div>
  </div>

  <div class="grid">
    <!-- Sidebar navigation -->
    <div class="sidebar">
      <div class="sidebar-nav">
        <button onclick="switchTab('items')" id="nav-items" class="active">Menu Items</button>
        <button onclick="switchTab('categories')" id="nav-categories">Categories</button>
        <button onclick="switchTab('ingredients')" id="nav-ingredients">Ingredients</button>
        <button onclick="switchTab('tags')" id="nav-tags">Flavor Tags</button>
        <button onclick="switchTab('print')" id="nav-print">Print menu</button>
      </div>
    </div>

    <!-- Main Content Area -->
    <div class="content-area">
      
      <!-- Section: MENU ITEMS -->
      <section id="section-items">
        <div class="action-bar">
          <h2>Menu Items</h2>
          <div style="display: flex; gap: 0.5rem;">
            <button class="btn" onclick="openItemDialog()">+ Add Menu Item</button>
          </div>
        </div>

        <!-- Category sub-tabs -->
        <div class="category-subtabs" style="display: flex; gap: 0.5rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem; flex-wrap: wrap;">
          {categories.map((category, index) => (
            <button 
              type="button" 
              class={`tab-btn category-tab-btn ${index === 0 ? 'active' : ''}`} 
              onclick={`switchCategoryTab(${category.id})`}
              id={`cat-tab-${category.id}`}
            >
              {category.name}
            </button>
          ))}
        </div>

        {categories.map((category, index) => {
          const items = menuItems.filter(item => item.category_id === category.id);
          return (
            <div 
              class="category-items-table" 
              id={`category-table-${category.id}`} 
              style={`display: ${index === 0 ? 'block' : 'none'};`}
            >
              <table>
                <thead>
                  <tr>
                    <th>Name (EN)</th>
                    <th>Price (NTD$)</th>
                    <th>Ingredients</th>
                    <th>Tags</th>
                    <th>Picture</th>
                    <th>Visible</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {items.map(item => (
                    <tr data-id={item.id}>
                      <td style="font-weight: 500;">{item.name}</td>
                      <td>{item.price}</td>
                      <td>
                        {item.ingredients.map(ing => (
                          <span class="badge">{ing}</span>
                        ))}
                      </td>
                      <td>
                        {item.tags.map(tag => (
                          <span class="badge">{tag}</span>
                        ))}
                      </td>
                      <td style={`font-weight: 500; color: ${item.media_id ? 'var(--success)' : 'inherit'};`}>{item.media_id ? 'Yes' : 'No'}</td>
                      <td>
                        <label class="switch">
                          <input type="checkbox" checked={item.is_available} onchange={`toggleAvailability(${item.id}, this.checked)`} />
                          <span class="slider"></span>
                        </label>
                      </td>
                      <td>
                        <button class="btn btn-secondary btn-sm" onclick={`editItem(${JSON.stringify(item)})`}>Edit</button>
                        <button class="btn btn-danger btn-sm" onclick={`deleteItem(${item.id})`}>Delete</button>
                      </td>
                    </tr>
                  ))}
                  {items.length === 0 && (
                    <tr>
                      <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 2rem;">No items in this category.</td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          );
        })}
      </section>

      <!-- Section: CATEGORIES -->
      <section id="section-categories" style="display: none;">
        <div class="action-bar">
          <h2>Categories</h2>
          <button class="btn" onclick="openCategoryDialog()">+ Add Category</button>
        </div>
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Code Name</th>
              <th>Display Name (EN)</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {categories.map(cat => (
              <tr>
                <td>{cat.id}</td>
                <td><code>{cat.code_name}</code></td>
                <td>{cat.name}</td>
                <td>
                  <button class="btn btn-secondary btn-sm" onclick={`editCategory(${cat.id}, '${cat.code_name}')`}>Edit</button>
                  <button class="btn btn-danger btn-sm" onclick={`deleteCategory(${cat.id})`}>Delete</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <!-- Section: INGREDIENTS -->
      <section id="section-ingredients" style="display: none;">
        <div class="action-bar">
          <h2>Ingredients</h2>
          <button class="btn" onclick="openIngredientDialog()">+ Add Ingredient</button>
        </div>
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Code Name</th>
              <th>Display Name (EN)</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {ingredients.map(ing => (
              <tr>
                <td>{ing.id}</td>
                <td><code>{ing.code_name}</code></td>
                <td>{ing.name}</td>
                <td>
                  <button class="btn btn-secondary btn-sm" onclick={`editIngredient(${ing.id}, '${ing.code_name}')`}>Edit</button>
                  <button class="btn btn-danger btn-sm" onclick={`deleteIngredient(${ing.id})`}>Delete</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <!-- Section: FLAVOR TAGS -->
      <section id="section-tags" style="display: none;">
        <div class="action-bar">
          <h2>Flavor Tags</h2>
          <button class="btn" onclick="openTagDialog()">+ Add Flavor Tag</button>
        </div>
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Code Name</th>
              <th>Display Name (EN)</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {flavorTags.map(tag => (
              <tr>
                <td>{tag.id}</td>
                <td><code>{tag.code_name}</code></td>
                <td>{tag.name}</td>
                <td>
                  <button class="btn btn-secondary btn-sm" onclick={`editTag(${tag.id}, '${tag.code_name}')`}>Edit</button>
                  <button class="btn btn-danger btn-sm" onclick={`deleteTag(${tag.id})`}>Delete</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <!-- Section: PRINT MENU -->
      <section id="section-print" style="display: none;">
        <div class="action-bar">
          <h2>Print & Export Menu</h2>
        </div>

        <!-- Global Helper Bar -->
        <div class="global-helper-bar">
          <div class="global-helper-buttons">
            <button class="btn btn-secondary btn-sm" onclick="globalToggleCategories(true)">Select All Categories</button>
            <button class="btn btn-secondary btn-sm" onclick="globalToggleCategories(false)">Deselect All Categories</button>
          </div>
          <div class="global-helper-buttons">
            <button class="btn btn-secondary btn-sm" onclick="globalToggleOption('desc')">Toggle All Descriptions</button>
            <button class="btn btn-secondary btn-sm" onclick="globalToggleOption('price')">Toggle All Prices</button>
            <button class="btn btn-secondary btn-sm" onclick="globalToggleOption('ing')">Toggle All Ingredients</button>
            <button class="btn btn-secondary btn-sm" onclick="globalToggleOption('tags')">Toggle All Tags</button>
          </div>
        </div>

        <!-- Categories & Items list -->
        <div class="print-categories-list">
          {categories.map(category => {
            const items = menuItems.filter(item => item.category_name === category.name);
            return (
              <div class="print-category-group" data-category-id={category.id} data-category-name={category.name}>
                <div class="category-header-controls">
                  <label class="category-select-label">
                    <input 
                      type="checkbox" 
                      class="category-selector" 
                      data-category-id={category.id} 
                      onchange="toggleCategoryItems(this)" 
                    />
                    <strong>{category.name}</strong>
                  </label>
                  <div class="category-export-options">
                    <label>
                      <input type="checkbox" class="category-opt-desc" data-category-id={category.id} checked />
                      Description
                    </label>
                    <label>
                      <input type="checkbox" class="category-opt-price" data-category-id={category.id} checked />
                      Price
                    </label>
                    <label>
                      <input type="checkbox" class="category-opt-ing" data-category-id={category.id} checked />
                      Ingredients
                    </label>
                    <label>
                      <input type="checkbox" class="category-opt-tags" data-category-id={category.id} checked />
                      Tags
                    </label>
                  </div>
                </div>
                <div class="category-items-list" id={`category-items-${category.id}`}>
                  {items.map(item => (
                    <label class="print-item-label">
                      <input 
                        type="checkbox" 
                        class="print-item-selector" 
                        data-item-id={item.id} 
                        data-category-id={category.id} 
                        disabled 
                      />
                      <span>{item.name} <span class="muted-price">(NTD$ {item.price})</span></span>
                    </label>
                  ))}
                  {items.length === 0 && (
                    <span style="color: var(--text-muted); font-size: 0.9rem; grid-column: 1/-1;">No items in this category.</span>
                  )}
                </div>
              </div>
            );
          })}
        </div>

        <!-- Print Actions at bottom of page -->
