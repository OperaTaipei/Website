    async function getSelectedData() {
      const selectedBoxes = document.querySelectorAll('.print-item-selector:checked:not(:disabled)');
      if (selectedBoxes.length === 0) {
        alert('Please select at least one menu item.');
        return null;
      }
      
      const ids = Array.from(selectedBoxes).map(cb => Number(cb.dataset.itemId));
      const targetLocale = document.getElementById('print-lang').value;
      
      showLoading(true);
      try {
        const res = await fetch(`/opera-admin/api/print-data?ids=${ids.join(',')}&locale=${targetLocale}`);
        if (!res.ok) {
          throw new Error('Failed to load menu details from server.');
        }
        const data = await res.json();
        if (data.error) {
          throw new Error(data.error);
        }
        return data;
      } catch (err) {
        alert(err.message || 'Failed to load menu details for export.');
        return null;
      } finally {
        showLoading(false);
      }
    }

    async function exportToMarkdown() {
      const data = await getSelectedData();
      if (!data) return;

      let markdown = `# OPERA TAIPEI MENU\n\n`;
      const categoriesGrouped = {};
      data.forEach(item => {
        if (!categoriesGrouped[item.category_name]) categoriesGrouped[item.category_name] = [];
        categoriesGrouped[item.category_name].push(item);
      });

      Object.keys(categoriesGrouped).forEach(cat => {
        const categoryId = categoriesGrouped[cat][0].category_id;
        const includeDesc = document.querySelector(`.category-opt-desc[data-category-id="${categoryId}"]`).checked;
        const includePrice = document.querySelector(`.category-opt-price[data-category-id="${categoryId}"]`).checked;
        const includeIng = document.querySelector(`.category-opt-ing[data-category-id="${categoryId}"]`).checked;
        const includeTags = document.querySelector(`.category-opt-tags[data-category-id="${categoryId}"]`).checked;

        markdown += `## ${cat.toUpperCase()}\n\n`;
        categoriesGrouped[cat].forEach(item => {
          let nameStr = item.name;
          if (item.bottle_type && item.bottle_volume) {
            nameStr += ` (${item.bottle_type}, ${item.bottle_volume}L)`;
          }
          let line = `* **${nameStr}**`;
          if (includePrice) line += ` - NTD$ ${item.price}`;
          markdown += line + `\n`;
          if (includeIng && item.ingredients && item.ingredients.length > 0) {
            markdown += `  _Ingredients: ${item.ingredients.join(', ')}_\n`;
          }
          if (includeTags && item.tags && item.tags.length > 0) {
            markdown += `  _Tags: ${item.tags.join(', ')}_\n`;
          }
          if (includeDesc && item.description) {
            markdown += `  ${item.description}\n`;
          }
          markdown += `\n`;
        });
      });

      try {
        await navigator.clipboard.writeText(markdown);
        alert('Markdown menu format copied to clipboard!');
      } catch (err) {
        alert('Failed to copy to clipboard.');
      }
    }

