  <script type="application/json" id="data-menu-items" set:html={JSON.stringify(menuItems)}></script>
  <script type="application/json" id="data-categories" set:html={JSON.stringify(categories)}></script>
  <script type="application/json" id="data-ingredients" set:html={JSON.stringify(ingredients)}></script>
  <script type="application/json" id="data-flavor-tags" set:html={JSON.stringify(flavorTags)}></script>
  <script type="application/json" id="data-bottle-types" set:html={JSON.stringify(bottleTypes)}></script>
  <script type="application/json" id="data-media" set:html={JSON.stringify(media)}></script>

  <script>
    import { actions } from 'astro:actions';
    window.actions = actions;
  </script>

  <script is:inline>
    window.allMenuItems = JSON.parse(document.getElementById('data-menu-items').textContent);
    window.allCategories = JSON.parse(document.getElementById('data-categories').textContent);
    window.allIngredients = JSON.parse(document.getElementById('data-ingredients').textContent);
    window.allFlavorTags = JSON.parse(document.getElementById('data-flavor-tags').textContent);
    window.allBottleTypes = JSON.parse(document.getElementById('data-bottle-types').textContent);
    window.allMedia = JSON.parse(document.getElementById('data-media').textContent);
    /* =========================================================================
       1. GLOBAL STATE & UI CONTROL HELPERS
       ========================================================================= */
    const activeSection = 'items';
    const activeLanguageTab = 'en';

    function switchTab(sectionId) {
      ['items', 'categories', 'ingredients', 'tags', 'media', 'print', 'db'].forEach(id => {
        const section = document.getElementById(`section-${id}`);
        const nav = document.getElementById(`nav-${id}`);
        if (section) section.style.display = id === sectionId ? 'block' : 'none';
        if (nav) nav.className = id === sectionId ? 'active' : '';
      });
      sessionStorage.setItem('admin_active_tab', sectionId);
    }

    let adminCurrentPage = 1;
    let adminPageSize = 10;

    function changePageSize(size) {
      adminPageSize = size === 'all' ? 'all' : parseInt(size, 10);
      adminCurrentPage = 1;
      updateFilteredItems();
    }

    function updateFilteredItems() {
      const searchInput = document.getElementById('admin-search-input');
      const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

      const activeTableContainer = Array.from(document.querySelectorAll('.category-items-table')).find(el => el.style.display !== 'none');
      if (!activeTableContainer) return;

      const tbody = activeTableContainer.querySelector('tbody');
      if (!tbody) return;

      const rows = Array.from(tbody.querySelectorAll('tr[data-id]'));
      const emptyRow = tbody.querySelector('tr:not([data-id])');
      
      let totalMatching = 0;
      const matchingRows = [];

      rows.forEach(row => {
        const textContent = row.textContent.toLowerCase();
        const matches = textContent.includes(query);
        if (matches) {
          matchingRows.push(row);
          totalMatching++;
        } else {
          row.style.display = 'none';
        }
      });

      if (emptyRow) {
        if (totalMatching === 0) {
          emptyRow.style.display = 'table-row';
          const td = emptyRow.querySelector('td');
          if (td) {
            td.innerText = query ? 'No matching items found.' : 'No items in this category.';
          }
        } else {
          emptyRow.style.display = 'none';
        }
      }

      const totalPages = adminPageSize === 'all' ? 1 : Math.ceil(totalMatching / adminPageSize);
      if (adminCurrentPage > totalPages) {
        adminCurrentPage = Math.max(1, totalPages);
      }

      matchingRows.forEach((row, idx) => {
        if (adminPageSize === 'all') {
          row.style.display = 'table-row';
        } else {
          const start = (adminCurrentPage - 1) * adminPageSize;
          const end = start + adminPageSize;
          if (idx >= start && idx < end) {
            row.style.display = 'table-row';
          } else {
            row.style.display = 'none';
          }
        }
      });

      const pagContainer = document.getElementById('admin-pagination-container');
      if (pagContainer) {
        pagContainer.innerHTML = '';
        if (totalPages > 1) {
          const prevBtn = document.createElement('button');
          prevBtn.className = 'btn btn-secondary btn-sm';
          prevBtn.innerText = 'Prev';
          prevBtn.disabled = adminCurrentPage === 1;
          prevBtn.onclick = () => {
            adminCurrentPage--;
            updateFilteredItems();
          };
          pagContainer.appendChild(prevBtn);

          for (let i = 1; i <= totalPages; i++) {
            const pageBtn = document.createElement('button');
            pageBtn.className = i === adminCurrentPage ? 'btn btn-sm' : 'btn btn-secondary btn-sm';
            pageBtn.innerText = i;
            pageBtn.onclick = () => {
              adminCurrentPage = i;
              updateFilteredItems();
            };
            pagContainer.appendChild(pageBtn);
          }

          const nextBtn = document.createElement('button');
          nextBtn.className = 'btn btn-secondary btn-sm';
          nextBtn.innerText = 'Next';
          nextBtn.disabled = adminCurrentPage === totalPages;
          nextBtn.onclick = () => {
            adminCurrentPage++;
            updateFilteredItems();
          };
          pagContainer.appendChild(nextBtn);
        }
      }
    }

    function switchCategoryTab(categoryId) {
      document.querySelectorAll('.category-items-table').forEach(el => {
        el.style.display = el.id === `category-table-${categoryId}` ? 'block' : 'none';
      });
      document.querySelectorAll('.category-tab-btn').forEach(btn => {
        if (btn.id === `cat-tab-${categoryId}`) btn.classList.add('active');
        else btn.classList.remove('active');
      });
      sessionStorage.setItem('admin_active_category_tab', categoryId);
      adminCurrentPage = 1;
      updateFilteredItems();
    }

    document.addEventListener('DOMContentLoaded', () => {
      const savedTab = sessionStorage.getItem('admin_active_tab');
      if (savedTab) {
        switchTab(savedTab);
      }
      const savedCategoryTab = sessionStorage.getItem('admin_active_category_tab');
      if (savedCategoryTab && document.getElementById(`cat-tab-${savedCategoryTab}`)) {
        switchCategoryTab(savedCategoryTab);
      } else {
        updateFilteredItems();
      }
    });

    async function triggerPublish() {
      if (confirm('Are you sure you want to trigger a full site rebuild? This will publish all database changes to the live site.')) {
        await callAction('triggerPublish', {});
      }
    }

    function switchLanguageTab(locale) {
      ['en', 'fr', 'ja', 'zh'].forEach(loc => {
        const el = document.getElementById(`locale-tab-${loc}`);
        if (el) el.className = loc === locale ? 'tab-content active' : 'tab-content';
      });
      // Toggle button active highlights
      const buttons = document.querySelectorAll('#dialog-item .tab-btn');
      buttons.forEach(btn => {
        if (btn.innerText.toLowerCase() === locale) btn.classList.add('active');
        else btn.classList.remove('active');
      });
    }

    function toggleBottleFields() {
      const select = document.getElementById('item-category');
      const selectedOption = select.options[select.selectedIndex];
      const codeName = selectedOption ? selectedOption.getAttribute('data-code-name') : '';
      const row = document.getElementById('bottle-fields-row');
      const typeInput = document.getElementById('item-bottle-type');
      const volumeInput = document.getElementById('item-bottle-volume');
      
      if (codeName === 'bottles') {
        row.style.display = 'flex';
        typeInput.required = true;
        volumeInput.required = true;
      } else {
        row.style.display = 'none';
        typeInput.required = false;
        volumeInput.required = false;
      }
    }

    async function purgeAllOrphans() {
      if (confirm('Are you sure you want to purge all orphan records? This action cannot be undone.')) {
        await callAction('purgeOrphans', {});
      }
    }

    function copyFromEnglish(targetLocale) {
      const enName = document.getElementById('item-en-name').value;
      const enDesc = document.getElementById('item-en-desc').value;
      
      const nameInput = document.getElementById(`item-${targetLocale}-name`);
      const descInput = document.getElementById(`item-${targetLocale}-desc`);
      
      if (nameInput) nameInput.value = enName;
      if (descInput) descInput.value = enDesc;
    }

    function handleSlugAutoGeneration(nameValue) {
      const slugInput = document.getElementById('item-code-name');
      const slug = nameValue
        .toLowerCase()
        .replace(/[^a-z0-9\s-]/g, '') // remove symbols
        .trim()
        .replace(/\s+/g, '-');        // replace space with hyphens
      slugInput.value = slug;
    }

    function showAlert(type, message) {
      const banner = document.getElementById('alert-banner');
      banner.innerText = message;
      banner.className = type;
      banner.style.display = 'block';
      setTimeout(() => {
        banner.style.display = 'none';
      }, 7000);
    }

    function showLoading(visible) {
      document.getElementById('loading-overlay').style.display = visible ? 'flex' : 'none';
      document.body.style.cursor = visible ? 'wait' : 'default';
      // Disable buttons
      const buttons = document.querySelectorAll('button, input[type=submit]');
      buttons.forEach(btn => btn.disabled = visible);
    }

    function closeDialog(id) {
      document.getElementById(id).close();
    }

    function showDeleteCascadeModal(name, cascades, onConfirm) {
      document.getElementById('cascade-delete-element-name').textContent = name;
      const listEl = document.getElementById('cascade-delete-list');
      listEl.innerHTML = '';
      
      cascades.forEach(item => {
        const li = document.createElement('li');
        li.textContent = item;
        listEl.appendChild(li);
      });
      
      const confirmBtn = document.getElementById('btn-confirm-delete-cascade');
      const newConfirmBtn = confirmBtn.cloneNode(true);
      confirmBtn.parentNode.replaceChild(newConfirmBtn, confirmBtn);
      
      newConfirmBtn.addEventListener('click', async () => {
        closeDialog('dialog-confirm-cascade');
        await onConfirm();
      });
      
      document.getElementById('dialog-confirm-cascade').showModal();
    }

    /* =========================================================================
       2. SERVER ACTIONS WRAPPER
       ========================================================================= */
    async function callAction(actionName, payload) {
      showLoading(true);
      try {
        const actionFn = window.actions ? window.actions[actionName] : null;
        if (!actionFn) {
          throw new Error(`Action helper for "${actionName}" is not loaded.`);
        }

        const { data, error } = await actionFn(payload);
        showLoading(false);

        if (!error && data && data.success) {
          showAlert('success', data.message || 'Operation successful!');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          let errorMsg = 'An error occurred.';
          if (error) {
            if (typeof error === 'string') {
              errorMsg = error;
            } else if (error.message) {
              errorMsg = error.message;
            } else if (error.fields) {
              const fieldErrors = Object.entries(error.fields)
                .map(([field, msgs]) => `${field}: ${Array.isArray(msgs) ? msgs.join(', ') : msgs}`)
                .join('; ');
              errorMsg = `Validation Error - ${fieldErrors}`;
            } else if (error.code) {
              errorMsg = `Error code: ${error.code}`;
            }
          } else if (data && data.error) {
            errorMsg = data.error;
          }
          showAlert('error', errorMsg);
        }
      } catch (err) {
        showLoading(false);
        showAlert('error', err.message || 'Network failure or server error.');
      }
    }

    /* =========================================================================
       3. MENU ITEMS CRUD HANDLERS
       ========================================================================= */
    async function toggleAvailability(id, isChecked) {
      await callAction('toggleMenuItemAvailability', { id, is_available: isChecked });
    }

    async function deleteItem(id) {
      const item = window.allMenuItems.find(m => m.id === id);
      if (!item) return;
      
      const name = `Menu Item "${item.name}"`;
      const cascades = [
        'All translations (English, French, Japanese, Chinese) for this menu item',
        `Menu Item record (ID: ${item.id})`
      ];
      
      if (item.bottle_volume || item.bottle_type) {
        cascades.push(`Bottle specific properties (Volume: ${item.bottle_volume}L, Type: ${item.bottle_type || 'Unspecified'})`);
      }
      if (item.ingredients && item.ingredients.length > 0) {
        cascades.push(`Ingredient relationships for: ${item.ingredients.join(', ')}`);
      }
      if (item.tags && item.tags.length > 0) {
        cascades.push(`Flavor tag relationships for: ${item.tags.join(', ')}`);
      }
      
      showDeleteCascadeModal(name, cascades, async () => {
        await callAction('deleteMenuItem', { id });
      });
    }

    function openItemDialog() {
      document.getElementById('dialog-item-title').innerText = 'Add Menu Item';
      document.getElementById('form-item').reset();
      document.getElementById('item-id').value = '';
      
      // Clear checked lists
      document.querySelectorAll('.ing-checkbox').forEach(c => c.checked = false);
      document.querySelectorAll('.tag-checkbox').forEach(c => c.checked = false);
      
      document.getElementById('item-bottle-type').value = '';
