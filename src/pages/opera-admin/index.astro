  <script is:inline>
    // Client-side interactions & Actions execution wrapper
    const activeSection = 'items';
    const activeLanguageTab = 'en';
    
    function switchTab(sectionId) {
      ['items', 'categories', 'ingredients', 'tags'].forEach(id => {
        document.getElementById(`section-${id}`).style.display = id === sectionId ? 'block' : 'none';
        document.getElementById(`nav-${id}`).className = id === sectionId ? 'active' : '';
      });
    }

    function switchLanguageTab(locale) {
      ['en', 'fr', 'ja', 'zh'].forEach(loc => {
        const el = document.getElementById(`locale-tab-${loc}`);
        if (el) el.className = loc === locale ? 'tab-content active' : 'tab-content';
      });
      // Toggle button active highlights
      const buttons = document.querySelectorAll('#dialog-item .tab-btn');
      buttons.forEach(btn => {
        if (btn.innerText.toLowerCase() === locale) btn.classList.add('active');
        else btn.classList.remove('active');
      });
    }

    function copyFromEnglish(targetLocale) {
      const enName = document.getElementById('item-en-name').value;
      const enDesc = document.getElementById('item-en-desc').value;
      
      const nameInput = document.getElementById(`item-${targetLocale}-name`);
      const descInput = document.getElementById(`item-${targetLocale}-desc`);
      
      if (nameInput) nameInput.value = enName;
      if (descInput) descInput.value = enDesc;
    }

    function handleSlugAutoGeneration(nameValue) {
      const slugInput = document.getElementById('item-code-name');
      const slug = nameValue
        .toLowerCase()
        .replace(/[^a-z0-9\s-]/g, '') // remove symbols
        .trim()
        .replace(/\s+/g, '-');        // replace space with hyphens
      slugInput.value = slug;
    }

    function showAlert(type, message) {
      const banner = document.getElementById('alert-banner');
      banner.innerText = message;
      banner.className = type;
      banner.style.display = 'block';
      setTimeout(() => {
        banner.style.display = 'none';
      }, 7000);
    }

    function showLoading(visible) {
      document.getElementById('loading-overlay').style.display = visible ? 'flex' : 'none';
      document.body.style.cursor = visible ? 'wait' : 'default';
      // Disable buttons
      const buttons = document.querySelectorAll('button, input[type=submit]');
      buttons.forEach(btn => btn.disabled = visible);
    }

    function closeDialog(id) {
      document.getElementById(id).close();
    }

    // ----------------------------------------------------
    // ACTIONS RUNNERS
    // ----------------------------------------------------
    async function callAction(actionName, payload) {
      showLoading(true);
      try {
        const res = await fetch(`/_actions/${actionName}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await res.json();
        showLoading(false);
        if (result.success) {
          showAlert('success', result.message || 'Operation successful!');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showAlert('error', result.error || 'An error occurred.');
        }
      } catch (err) {
        showLoading(false);
        showAlert('error', 'Network failure or server error.');
      }
    }

    // Toggle menu visibility
    async function toggleAvailability(id, isChecked) {
      await callAction('toggleMenuItemAvailability', { id, is_available: isChecked });
    }

    // Delete item
    async function deleteItem(id) {
      if (confirm('Are you sure you want to delete this menu item?')) {
        await callAction('deleteMenuItem', { id });
      }
    }

    // Submit MenuItem Form
    async function submitItem(event) {
      event.preventDefault();
      const form = document.getElementById('form-item');
      const formData = new FormData(form);

      // Collect multiple checkbox elements
      const ingCheckboxes = document.querySelectorAll('.ing-checkbox:checked');
      const tagCheckboxes = document.querySelectorAll('.tag-checkbox:checked');
      const ingredients = Array.from(ingCheckboxes).map(c => Number(c.value));
      const tags = Array.from(tagCheckboxes).map(c => Number(c.value));

      const payload = {
        id: formData.get('id') ? Number(formData.get('id')) : undefined,
        code_name: formData.get('code_name'),
        category_id: Number(formData.get('category_id')),
        media_id: formData.get('media_id') ? Number(formData.get('media_id')) : null,
        price: Number(formData.get('price')),
        is_available: document.getElementById('item-available').checked,
        ingredients,
        tags,
        translations: {
          en: { name: formData.get('translations.en.name'), description: formData.get('translations.en.description') },
          fr: { name: formData.get('translations.fr.name'), description: formData.get('translations.fr.description') },
          ja: { name: formData.get('translations.ja.name'), description: formData.get('translations.ja.description') },
          zh: { name: formData.get('translations.zh.name'), description: formData.get('translations.zh.description') }
        }
      };

      await callAction('saveMenuItem', payload);
      closeDialog('dialog-item');
    }

    // Open item create dialog
    function openItemDialog() {
      document.getElementById('dialog-item-title').innerText = 'Add Menu Item';
      document.getElementById('form-item').reset();
      document.getElementById('item-id').value = '';
      
      // Clear checked lists
      document.querySelectorAll('.ing-checkbox').forEach(c => c.checked = false);
      document.querySelectorAll('.tag-checkbox').forEach(c => c.checked = false);
      
      switchLanguageTab('en');
      document.getElementById('dialog-item').showModal();
    }

    // Edit item (populates modal fields including translations fetch)
    async function editItem(item) {
      openItemDialog();
      document.getElementById('dialog-item-title').innerText = 'Edit Menu Item';
      
      // Fetch translations dynamically
      showLoading(true);
      try {
        const res = await fetch(`/_actions/saveMenuItem`); // Fetch fallback context
        // Instead of endpoint we query translations table details directly or via fetch
        // Since we can pass translations within data directly, let's load translations from a custom route
        // Wait, for this demo/exercise we can easily fetch localized translations from database. Let's do a quick fetch
        const transRes = await fetch(`/opera-admin/api/translations?entity_type=menu_item&id=${item.id}`);
        const translations = await transRes.json();
        
        document.getElementById('item-id').value = item.id;
        document.getElementById('item-code-name').value = item.code_name;
        document.getElementById('item-category').value = item.category_id;
        document.getElementById('item-media').value = item.media_id || '';
        document.getElementById('item-price').value = item.price;
        document.getElementById('item-available').checked = item.is_available;

        // Set translations
        ['en', 'fr', 'ja', 'zh'].forEach(loc => {
          const trans = translations[loc] || { name: '', description: '' };
          document.getElementById(`item-${loc}-name`).value = trans.name || (loc === 'en' ? item.name : '');
          document.getElementById(`item-${loc}-desc`).value = trans.description || (loc === 'en' ? item.description : '');
        });

        // Set checkboxes
        // Fetch specific selected IDs (using elements in row)
        const row = document.querySelector(`tr[data-id="${item.id}"]`);
        // We will select checking items by matching ingredients names or we can fetch ingredient relations.
        // For simplicity, we query backend for item associations
        const assocRes = await fetch(`/opera-admin/api/associations?id=${item.id}`);
        const assoc = await assocRes.json();
        
        assoc.ingredients.forEach(id => {
          const checkbox = document.getElementById(`ing-c-${id}`);
          if (checkbox) checkbox.checked = true;
        });
        assoc.tags.forEach(id => {
          const checkbox = document.getElementById(`tag-c-${id}`);
          if (checkbox) checkbox.checked = true;
        });

        showLoading(false);
        document.getElementById('dialog-item').showModal();
      } catch (err) {
        showLoading(false);
        showAlert('error', 'Failed to load item translation details.');
      }
    }

    // ----------------------------------------------------
    // CATEGORIES CRUD
    // ----------------------------------------------------
    function openCategoryDialog() {
      document.getElementById('dialog-category-title').innerText = 'Add Category';
      document.getElementById('form-category').reset();
      document.getElementById('category-id').value = '';
      document.getElementById('dialog-category').showModal();
    }

    async function editCategory(id, codeName) {
      openCategoryDialog();
      document.getElementById('dialog-category-title').innerText = 'Edit Category';
      document.getElementById('category-id').value = id;
      document.getElementById('category-code').value = codeName;

      showLoading(true);
      try {
        const transRes = await fetch(`/opera-admin/api/translations?entity_type=category&id=${id}`);
        const translations = await transRes.json();
        ['en', 'fr', 'ja', 'zh'].forEach(loc => {
          const t = translations[loc] || { name: '' };
          document.getElementById(`category-${loc}`).value = t.name || '';
        });
      } finally {
        showLoading(false);
      }
    }

    async function submitCategory(event) {
      event.preventDefault();
      const form = document.getElementById('form-category');
      const formData = new FormData(form);

      const payload = {
        id: formData.get('id') ? Number(formData.get('id')) : undefined,
        code_name: formData.get('code_name'),
        translations: {
          en: { name: formData.get('translations.en.name') },
          fr: { name: formData.get('translations.fr.name') },
          ja: { name: formData.get('translations.ja.name') },
          zh: { name: formData.get('translations.zh.name') }
        }
      };
      await callAction('saveCategory', payload);
      closeDialog('dialog-category');
    }

    async function deleteCategory(id) {
      if (confirm('Are you sure you want to delete this category?')) {
        await callAction('deleteCategory', { id });
      }
    }

    // ----------------------------------------------------
    // INGREDIENTS CRUD
    // ----------------------------------------------------
    function openIngredientDialog() {
      document.getElementById('dialog-ingredient-title').innerText = 'Add Ingredient';
      document.getElementById('form-ingredient').reset();
      document.getElementById('ingredient-id').value = '';
      document.getElementById('dialog-ingredient').showModal();
    }

    async function editIngredient(id, codeName) {
      openIngredientDialog();
