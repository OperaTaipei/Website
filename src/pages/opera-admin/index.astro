  <script is:inline>
    /* =========================================================================
       1. GLOBAL STATE & UI CONTROL HELPERS
       ========================================================================= */
    const activeSection = 'items';
    const activeLanguageTab = 'en';

    function switchTab(sectionId) {
      ['items', 'categories', 'ingredients', 'tags', 'print'].forEach(id => {
        const section = document.getElementById(`section-${id}`);
        const nav = document.getElementById(`nav-${id}`);
        if (section) section.style.display = id === sectionId ? 'block' : 'none';
        if (nav) nav.className = id === sectionId ? 'active' : '';
      });
    }

    function switchCategoryTab(categoryId) {
      document.querySelectorAll('.category-items-table').forEach(el => {
        el.style.display = el.id === `category-table-${categoryId}` ? 'block' : 'none';
      });
      document.querySelectorAll('.category-tab-btn').forEach(btn => {
        if (btn.id === `cat-tab-${categoryId}`) btn.classList.add('active');
        else btn.classList.remove('active');
      });
    }

    function switchLanguageTab(locale) {
      ['en', 'fr', 'ja', 'zh'].forEach(loc => {
        const el = document.getElementById(`locale-tab-${loc}`);
        if (el) el.className = loc === locale ? 'tab-content active' : 'tab-content';
      });
      // Toggle button active highlights
      const buttons = document.querySelectorAll('#dialog-item .tab-btn');
      buttons.forEach(btn => {
        if (btn.innerText.toLowerCase() === locale) btn.classList.add('active');
        else btn.classList.remove('active');
      });
    }

    function copyFromEnglish(targetLocale) {
      const enName = document.getElementById('item-en-name').value;
      const enDesc = document.getElementById('item-en-desc').value;
      
      const nameInput = document.getElementById(`item-${targetLocale}-name`);
      const descInput = document.getElementById(`item-${targetLocale}-desc`);
      
      if (nameInput) nameInput.value = enName;
      if (descInput) descInput.value = enDesc;
    }

    function handleSlugAutoGeneration(nameValue) {
      const slugInput = document.getElementById('item-code-name');
      const slug = nameValue
        .toLowerCase()
        .replace(/[^a-z0-9\s-]/g, '') // remove symbols
        .trim()
        .replace(/\s+/g, '-');        // replace space with hyphens
      slugInput.value = slug;
    }

    function showAlert(type, message) {
      const banner = document.getElementById('alert-banner');
      banner.innerText = message;
      banner.className = type;
      banner.style.display = 'block';
      setTimeout(() => {
        banner.style.display = 'none';
      }, 7000);
    }

    function showLoading(visible) {
      document.getElementById('loading-overlay').style.display = visible ? 'flex' : 'none';
      document.body.style.cursor = visible ? 'wait' : 'default';
      // Disable buttons
      const buttons = document.querySelectorAll('button, input[type=submit]');
      buttons.forEach(btn => btn.disabled = visible);
    }

    function closeDialog(id) {
      document.getElementById(id).close();
    }

    /* =========================================================================
       2. SERVER ACTIONS WRAPPER
       ========================================================================= */
    async function callAction(actionName, payload) {
      showLoading(true);
      try {
        const res = await fetch(`/_actions/${actionName}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (!res.ok) {
          throw new Error(`HTTP Error: ${res.status} ${res.statusText}`);
        }
        const result = await res.json();
        showLoading(false);
        if (result.success) {
          showAlert('success', result.message || 'Operation successful!');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showAlert('error', result.error || 'An error occurred.');
        }
      } catch (err) {
        showLoading(false);
        showAlert('error', err.message || 'Network failure or server error.');
      }
    }

    /* =========================================================================
       3. MENU ITEMS CRUD HANDLERS
       ========================================================================= */
    async function toggleAvailability(id, isChecked) {
      await callAction('toggleMenuItemAvailability', { id, is_available: isChecked });
    }

    async function deleteItem(id) {
      if (confirm('Are you sure you want to delete this menu item?')) {
        await callAction('deleteMenuItem', { id });
      }
    }

    function openItemDialog() {
      document.getElementById('dialog-item-title').innerText = 'Add Menu Item';
      document.getElementById('form-item').reset();
      document.getElementById('item-id').value = '';
      
      // Clear checked lists
      document.querySelectorAll('.ing-checkbox').forEach(c => c.checked = false);
      document.querySelectorAll('.tag-checkbox').forEach(c => c.checked = false);
      
      switchLanguageTab('en');
      document.getElementById('dialog-item').showModal();
    }

    async function editItem(item) {
      openItemDialog();
      document.getElementById('dialog-item-title').innerText = 'Edit Menu Item';
      
      showLoading(true);
      try {
        // Fetch translations
        const transRes = await fetch(`/opera-admin/api/translations?entity_type=menu_item&id=${item.id}`);
        if (!transRes.ok) {
          throw new Error('Failed to load translations from server.');
        }
        const translations = await transRes.json();
        if (translations.error) {
          throw new Error(translations.error);
        }
        
        document.getElementById('item-id').value = item.id;
        document.getElementById('item-code-name').value = item.code_name;
        document.getElementById('item-category').value = item.category_id;
        document.getElementById('item-media').value = item.media_id || '';
        document.getElementById('item-price').value = item.price;
        document.getElementById('item-available').checked = item.is_available;

        // Set translations
        ['en', 'fr', 'ja', 'zh'].forEach(loc => {
          const trans = translations[loc] || { name: '', description: '' };
          document.getElementById(`item-${loc}-name`).value = trans.name || (loc === 'en' ? item.name : '');
          document.getElementById(`item-${loc}-desc`).value = trans.description || (loc === 'en' ? item.description : '');
        });

        // Fetch associations
        const assocRes = await fetch(`/opera-admin/api/associations?id=${item.id}`);
        if (!assocRes.ok) {
          throw new Error('Failed to load menu associations from server.');
        }
        const assoc = await assocRes.json();
        if (assoc.error) {
          throw new Error(assoc.error);
        }
        
        assoc.ingredients.forEach(id => {
          const checkbox = document.getElementById(`ing-c-${id}`);
          if (checkbox) checkbox.checked = true;
        });
        assoc.tags.forEach(id => {
          const checkbox = document.getElementById(`tag-c-${id}`);
          if (checkbox) checkbox.checked = true;
        });

        showLoading(false);
      } catch (err) {
        showLoading(false);
        closeDialog('dialog-item');
        showAlert('error', err.message || 'Failed to load item translation details.');
      }
    }

    async function submitItem(event) {
      event.preventDefault();
      const form = document.getElementById('form-item');
      const formData = new FormData(form);

      const ingCheckboxes = document.querySelectorAll('.ing-checkbox:checked');
      const tagCheckboxes = document.querySelectorAll('.tag-checkbox:checked');
      const ingredients = Array.from(ingCheckboxes).map(c => Number(c.value));
      const tags = Array.from(tagCheckboxes).map(c => Number(c.value));

      const payload = {
        id: formData.get('id') ? Number(formData.get('id')) : undefined,
        code_name: formData.get('code_name'),
        category_id: Number(formData.get('category_id')),
        media_id: formData.get('media_id') ? Number(formData.get('media_id')) : null,
        price: Number(formData.get('price')),
        is_available: document.getElementById('item-available').checked,
        ingredients,
        tags,
        translations: {
          en: { name: formData.get('translations.en.name'), description: formData.get('translations.en.description') },
          fr: { name: formData.get('translations.fr.name'), description: formData.get('translations.fr.description') },
          ja: { name: formData.get('translations.ja.name'), description: formData.get('translations.ja.description') },
          zh: { name: formData.get('translations.zh.name'), description: formData.get('translations.zh.description') }
        }
      };

      await callAction('saveMenuItem', payload);
      closeDialog('dialog-item');
    }

    /* =========================================================================
       4. CATEGORIES CRUD HANDLERS
       ========================================================================= */
    function openCategoryDialog() {
      document.getElementById('dialog-category-title').innerText = 'Add Category';
      document.getElementById('form-category').reset();
      document.getElementById('category-id').value = '';
      document.getElementById('dialog-category').showModal();
    }

    async function editCategory(id, codeName) {
      openCategoryDialog();
      document.getElementById('dialog-category-title').innerText = 'Edit Category';
      document.getElementById('category-id').value = id;
      document.getElementById('category-code').value = codeName;

      showLoading(true);
      try {
        const transRes = await fetch(`/opera-admin/api/translations?entity_type=category&id=${id}`);
        if (!transRes.ok) {
          throw new Error('Failed to load translations from server.');
        }
        const translations = await transRes.json();
        if (translations.error) {
          throw new Error(translations.error);
        }
        ['en', 'fr', 'ja', 'zh'].forEach(loc => {
          const t = translations[loc] || { name: '' };
          document.getElementById(`category-${loc}`).value = t.name || '';
        });
      } catch (err) {
        closeDialog('dialog-category');
        showAlert('error', err.message || 'Failed to load category details.');
      } finally {
        showLoading(false);
      }
    }

    async function submitCategory(event) {
      event.preventDefault();
      const form = document.getElementById('form-category');
      const formData = new FormData(form);

      const payload = {
        id: formData.get('id') ? Number(formData.get('id')) : undefined,
        code_name: formData.get('code_name'),
        translations: {
          en: { name: formData.get('translations.en.name') },
          fr: { name: formData.get('translations.fr.name') },
          ja: { name: formData.get('translations.ja.name') },
          zh: { name: formData.get('translations.zh.name') }
        }
      };
      await callAction('saveCategory', payload);
      closeDialog('dialog-category');
    }

    async function deleteCategory(id) {
      if (confirm('Are you sure you want to delete this category?')) {
        await callAction('deleteCategory', { id });
      }
    }

    /* =========================================================================
       5. INGREDIENTS CRUD HANDLERS
       ========================================================================= */
    function openIngredientDialog() {
      document.getElementById('dialog-ingredient-title').innerText = 'Add Ingredient';
      document.getElementById('form-ingredient').reset();
      document.getElementById('ingredient-id').value = '';
      document.getElementById('dialog-ingredient').showModal();
    }

    async function editIngredient(id, codeName) {
      openIngredientDialog();
      document.getElementById('dialog-ingredient-title').innerText = 'Edit Ingredient';
      document.getElementById('ingredient-id').value = id;
      document.getElementById('ingredient-code').value = codeName;

      showLoading(true);
      try {
        const transRes = await fetch(`/opera-admin/api/translations?entity_type=ingredient&id=${id}`);
        if (!transRes.ok) {
          throw new Error('Failed to load translations from server.');
        }
        const translations = await transRes.json();
        if (translations.error) {
          throw new Error(translations.error);
        }
        ['en', 'fr', 'ja', 'zh'].forEach(loc => {
          const t = translations[loc] || { name: '' };
          document.getElementById(`ingredient-${loc}`).value = t.name || '';
        });
      } catch (err) {
        closeDialog('dialog-ingredient');
        showAlert('error', err.message || 'Failed to load ingredient details.');
      } finally {
        showLoading(false);
      }
    }

    async function submitIngredient(event) {
      event.preventDefault();
      const form = document.getElementById('form-ingredient');
      const formData = new FormData(form);

      const payload = {
        id: formData.get('id') ? Number(formData.get('id')) : undefined,
        code_name: formData.get('code_name'),
        translations: {
          en: { name: formData.get('translations.en.name') },
          fr: { name: formData.get('translations.fr.name') },
          ja: { name: formData.get('translations.ja.name') },
          zh: { name: formData.get('translations.zh.name') }
        }
      };
      await callAction('saveIngredient', payload);
      closeDialog('dialog-ingredient');
    }

    async function deleteIngredient(id) {
      if (confirm('Are you sure you want to delete this ingredient?')) {
        await callAction('deleteIngredient', { id });
      }
    }

    /* =========================================================================
       6. FLAVOR TAGS CRUD HANDLERS
       ========================================================================= */
    function openTagDialog() {
      document.getElementById('dialog-tag-title').innerText = 'Add Flavor Tag';
      document.getElementById('form-tag').reset();
      document.getElementById('tag-id').value = '';
      document.getElementById('dialog-tag').showModal();
    }

    async function editTag(id, codeName) {
      openTagDialog();
      document.getElementById('dialog-tag-title').innerText = 'Edit Flavor Tag';
      document.getElementById('tag-id').value = id;
      document.getElementById('tag-code').value = codeName;

      showLoading(true);
      try {
        const transRes = await fetch(`/opera-admin/api/translations?entity_type=tag&id=${id}`);
        if (!transRes.ok) {
          throw new Error('Failed to load translations from server.');
        }
        const translations = await transRes.json();
        if (translations.error) {
          throw new Error(translations.error);
        }
        ['en', 'fr', 'ja', 'zh'].forEach(loc => {
          const t = translations[loc] || { name: '' };
          document.getElementById(`tag-${loc}`).value = t.name || '';
        });
      } catch (err) {
        closeDialog('dialog-tag');
        showAlert('error', err.message || 'Failed to load tag details.');
      } finally {
        showLoading(false);
      }
    }

    async function submitTag(event) {
      event.preventDefault();
      const form = document.getElementById('form-tag');
      const formData = new FormData(form);

      const payload = {
        id: formData.get('id') ? Number(formData.get('id')) : undefined,
        code_name: formData.get('code_name'),
        translations: {
          en: { name: formData.get('translations.en.name') },
          fr: { name: formData.get('translations.fr.name') },
          ja: { name: formData.get('translations.ja.name') },
          zh: { name: formData.get('translations.zh.name') }
        }
      };
      await callAction('saveFlavorTag', payload);
      closeDialog('dialog-tag');
    }

    async function deleteTag(id) {
      if (confirm('Are you sure you want to delete this flavor tag?')) {
        await callAction('deleteFlavorTag', { id });
      }
    }

    /* =========================================================================
       7. PRINT & EXPORT LAYOUT GENERATORS
       ========================================================================= */
    function toggleCategoryItems(categoryInput) {
      const categoryId = categoryInput.dataset.categoryId;
      const checked = categoryInput.checked;
      const itemListContainer = document.getElementById(`category-items-${categoryId}`);
      if (itemListContainer) {
        const itemSelectors = itemListContainer.querySelectorAll('.print-item-selector');
        itemSelectors.forEach(cb => {
          cb.disabled = !checked;
          cb.checked = checked;
        });
      }
    }

    function globalToggleCategories(checked) {
      const categorySelectors = document.querySelectorAll('.category-selector');
      categorySelectors.forEach(cb => {
        cb.checked = checked;
        toggleCategoryItems(cb);
      });
    }

    function globalToggleOption(optionName) {
      const checkboxes = document.querySelectorAll(`.category-opt-${optionName}`);
      const anyChecked = Array.from(checkboxes).some(cb => cb.checked);
      checkboxes.forEach(cb => cb.checked = !anyChecked);
    }

    async function getSelectedData() {
      const selectedBoxes = document.querySelectorAll('.print-item-selector:checked:not(:disabled)');
      if (selectedBoxes.length === 0) {
        alert('Please select at least one menu item.');
        return null;
      }
      
      const ids = Array.from(selectedBoxes).map(cb => Number(cb.dataset.itemId));
      const targetLocale = document.getElementById('print-lang').value;
      
      showLoading(true);
      try {
        const res = await fetch(`/opera-admin/api/print-data?ids=${ids.join(',')}&locale=${targetLocale}`);
        if (!res.ok) {
          throw new Error('Failed to load menu details from server.');
        }
        const data = await res.json();
        if (data.error) {
          throw new Error(data.error);
        }
        return data;
      } catch (err) {
        alert(err.message || 'Failed to load menu details for export.');
        return null;
      } finally {
        showLoading(false);
      }
    }

    async function exportToMarkdown() {
      const data = await getSelectedData();
      if (!data) return;

      let markdown = `# OPERA TAIPEI MENU\n\n`;
      const categoriesGrouped = {};
      data.forEach(item => {
        if (!categoriesGrouped[item.category_name]) categoriesGrouped[item.category_name] = [];
        categoriesGrouped[item.category_name].push(item);
      });

      Object.keys(categoriesGrouped).forEach(cat => {
        const categoryId = categoriesGrouped[cat][0].category_id;
        const includeDesc = document.querySelector(`.category-opt-desc[data-category-id="${categoryId}"]`).checked;
        const includePrice = document.querySelector(`.category-opt-price[data-category-id="${categoryId}"]`).checked;
        const includeIng = document.querySelector(`.category-opt-ing[data-category-id="${categoryId}"]`).checked;
        const includeTags = document.querySelector(`.category-opt-tags[data-category-id="${categoryId}"]`).checked;

        markdown += `## ${cat.toUpperCase()}\n\n`;
        categoriesGrouped[cat].forEach(item => {
          let line = `* **${item.name}**`;
          if (includePrice) line += ` - NTD$ ${item.price}`;
          markdown += line + `\n`;
          if (includeIng && item.ingredients && item.ingredients.length > 0) {
            markdown += `  _Ingredients: ${item.ingredients.join(', ')}_\n`;
          }
          if (includeTags && item.tags && item.tags.length > 0) {
            markdown += `  _Tags: ${item.tags.join(', ')}_\n`;
          }
          if (includeDesc && item.description) {
            markdown += `  ${item.description}\n`;
          }
          markdown += `\n`;
        });
      });

      try {
        await navigator.clipboard.writeText(markdown);
        alert('Markdown menu format copied to clipboard!');
      } catch (err) {
        alert('Failed to copy to clipboard.');
      }
    }

    async function generatePrintedLayout() {
      const data = await getSelectedData();
      if (!data) return;

      const printWindow = window.open('', '_blank');
      let html = `
        <html>
        <head>
          <title>Opera Taipei printed menu</title>
          <style>
            body { font-family: "Georgia", serif; padding: 3rem; color: #111; max-width: 800px; margin: auto; }
            h1 { text-align: center; text-transform: uppercase; letter-spacing: 0.1em; border-bottom: 2px solid #222; padding-bottom: 0.5rem; margin-bottom: 2rem; }
            .category-section { margin-bottom: 2.5rem; page-break-inside: avoid; }
            .category-title { border-bottom: 1px solid #444; font-size: 1.5rem; text-transform: uppercase; margin-bottom: 1rem; padding-bottom: 0.25rem; letter-spacing: 0.05em; }
            .menu-item { display: flex; flex-direction: column; margin-bottom: 1.25rem; }
            .item-header { display: flex; justify-content: space-between; font-weight: bold; font-size: 1.1rem; }
            .item-desc { font-style: italic; color: #444; font-size: 0.95rem; margin-top: 0.25rem; }
            .item-ings { font-size: 0.85rem; color: #555; text-transform: uppercase; margin-top: 0.15rem; }
            .item-tags { font-size: 0.85rem; color: #777; font-style: italic; margin-top: 0.15rem; }
            @media print {
              body { padding: 1.5rem; }
              button { display: none; }
            }
          </style>
        </head>
        <body>
          <h1>OPERA TAIPEI</h1>
      `;

      const categoriesGrouped = {};
      data.forEach(item => {
        if (!categoriesGrouped[item.category_name]) categoriesGrouped[item.category_name] = [];
        categoriesGrouped[item.category_name].push(item);
      });

      Object.keys(categoriesGrouped).forEach(cat => {
        const categoryId = categoriesGrouped[cat][0].category_id;
        const includeDesc = document.querySelector(`.category-opt-desc[data-category-id="${categoryId}"]`).checked;
        const includePrice = document.querySelector(`.category-opt-price[data-category-id="${categoryId}"]`).checked;
        const includeIng = document.querySelector(`.category-opt-ing[data-category-id="${categoryId}"]`).checked;
        const includeTags = document.querySelector(`.category-opt-tags[data-category-id="${categoryId}"]`).checked;

        html += `<div class="category-section">`;
        html += `<h2 class="category-title">${cat}</h2>`;
        categoriesGrouped[cat].forEach(item => {
          html += `<div class="menu-item">`;
          html += `<div class="item-header"><span>${item.name}</span>`;
          if (includePrice) html += `<span>$${item.price}</span>`;
          html += `</div>`;
          if (includeIng && item.ingredients && item.ingredients.length > 0) {
            html += `<div class="item-ings">${item.ingredients.join(' / ')}</div>`;
          }
          if (includeTags && item.tags && item.tags.length > 0) {
            html += `<div class="item-tags">${item.tags.join(', ')}</div>`;
          }
          if (includeDesc && item.description) {
            html += `<div class="item-desc">${item.description}</div>`;
          }
          html += `</div>`;
        });
        html += `</div>`;
      });

      html += `
        <script>
          window.onload = function() {
            window.print();
          }
        <\/script>
        </body>
        </html>
      `;

      printWindow.document.write(html);
      printWindow.document.close();
    }
  </script>
</body>
</html>
