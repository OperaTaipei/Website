---
export const prerender = false;

import * as dbHelpers from '../../lib/db';
const version = import.meta.env.PUBLIC_APP_VERSION || 'v0.0.0';

const db = Astro.locals.runtime?.env?.DB;
if (!db) {
  return new Response("Cloudflare D1 Database binding is missing. Check your wrangler configuration.", { status: 500 });
}

// 1. Fetch initial lists
const menuItems = await dbHelpers.getMenuItems(db);
const categories = await dbHelpers.getCategories(db);
const ingredients = await dbHelpers.getIngredients(db);
const flavorTags = await dbHelpers.getFlavorTags(db);
const media = await dbHelpers.getMedia(db);
const bottleTypes = await dbHelpers.getBottleTypes(db);
bottleTypes.sort((a, b) => a.name.localeCompare(b.name));
const orphans = await dbHelpers.getOrphans(db);

// Sort categories placing 'bottles' first, others alphabetically ascending by name
categories.sort((a, b) => {
  if (a.code_name === 'bottles') return -1;
  if (b.code_name === 'bottles') return 1;
  return a.name.localeCompare(b.name);
});
menuItems.sort((a, b) => a.name.localeCompare(b.name));

// Helper to check Cloudflare Access headers if available
const isLocal = new URL(Astro.request.url).hostname === 'localhost' || new URL(Astro.request.url).hostname === '127.0.0.1';
const userEmailHeader = Astro.request.headers.get('Cf-Access-Authenticated-User-Email');

if (!isLocal) {
  if (!userEmailHeader) {
    return new Response("Unauthorized: Missing Cf-Access authentication header", { status: 401 });
  }
  const allowedEmailsStr = Astro.locals.runtime?.env?.ADMIN_EMAILS || import.meta.env.ADMIN_EMAILS;
  if (allowedEmailsStr) {
    const allowedEmails = allowedEmailsStr.split(',').map((email: string) => email.trim().toLowerCase());
    if (!allowedEmails.includes(userEmailHeader.toLowerCase())) {
      return new Response(`Forbidden: Access denied for ${userEmailHeader}`, { status: 403 });
    }
  }
}

const userEmail = userEmailHeader || 'Local Dev Admin';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Opera menu manager</title>
  <style>
    /* =========================================================================
       1. THEME DESIGN TOKENS (CSS VARIABLES)
       ========================================================================= */
    :root {
      --bg-dark: #121214;
      --bg-card: #1e1e24;
      --primary: #c5a880;
      --primary-hover: #b4966e;
      --text: #e2e8f0;
      --text-muted: #94a3b8;
      --border: #2d2d34;
      --danger: #ef4444;
      --success: #10b981;
    }

    /* =========================================================================
       2. RESET & BASE STYLES
       ========================================================================= */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text);
      padding: 3rem 0 2rem 0;
    }

    .admin-container {
      max-width: 1400px;
      margin: 0 auto;
      width: 100%;
      padding: 0 1.5rem;
      box-sizing: border-box;
    }

    /* =========================================================================
       3. HEADER & NAVIGATION STYLES
       ========================================================================= */
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
      border-bottom: 1px solid var(--border);
      padding: 0 1.5rem 1rem 1.5rem;
    }

    .header-left, .header-right {
      flex: 1;
      display: flex;
    }

    .header-left {
      justify-content: flex-start;
    }

    .header-right {
      justify-content: flex-end;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.25rem;
    }

    .header-center {
      flex: 2;
      text-align: center;
    }

    .logo {
      height: 75px;
      width: auto;
      margin-top: 1rem;
    }

    h1 {
      color: var(--primary);
      font-weight: 600;
    }

    .user-tag {
      font-size: 0.85rem;
      color: var(--text-muted);
      background: var(--border);
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
    }

    /* =========================================================================
       4. LAYOUT & SIDEBAR STYLES
       ========================================================================= */
    .grid {
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 2rem;
    }

    .sidebar {
      background: var(--bg-card);
      border-radius: 8px;
      padding: 1.5rem;
      border: 1px solid var(--border);
      height: fit-content;
    }

    .sidebar-nav button {
      display: block;
      width: 100%;
      text-align: left;
      padding: 0.75rem 1rem;
      background: none;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      border-radius: 4px;
      font-size: 1rem;
      margin-bottom: 0.5rem;
    }

    .sidebar-nav button.active {
      background: var(--primary);
      color: var(--bg-dark);
      font-weight: bold;
    }

    .content-area {
      background: var(--bg-card);
      border-radius: 8px;
      padding: 2rem;
      border: 1px solid var(--border);
    }

    /* =========================================================================
       5. ACTIONS BAR & BUTTON STYLES
       ========================================================================= */
    .action-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
    }

    .btn {
      background: var(--primary);
      color: var(--bg-dark);
      border: none;
      padding: 0.5rem 1rem;
      font-weight: bold;
      border-radius: 4px;
      cursor: pointer;
      font-size: 0.9rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      transition: background 0.2s;
    }

    .btn:hover {
      background: var(--primary-hover);
    }

    .btn-danger {
      background: var(--danger);
      color: white;
    }

    .btn-danger:hover {
      background: #dc2626;
    }

    .btn-secondary {
      background: #475569;
      color: white;
    }

    .btn-secondary:hover {
      background: #334155;
    }

    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    /* =========================================================================
       6. TABLE & DATA VISUALIZATION
       ========================================================================= */
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 1.5rem;
    }

    th, td {
      padding: 1rem;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }

    th {
      color: var(--text-muted);
      font-weight: 600;
      cursor: pointer;
      position: relative;
      user-select: none;
    }

    th::after {
      content: ' ↕';
      opacity: 0.3;
      font-size: 0.8em;
      margin-left: 5px;
    }

    th[aria-sort="ascending"]::after {
      content: ' ▲';
      opacity: 0.9;
    }

    th[aria-sort="descending"]::after {
      content: ' ▼';
      opacity: 0.9;
    }

    th[data-sortable="false"] {
      cursor: default;
    }

    th[data-sortable="false"]::after {
      display: none;
    }

    tr:hover {
      background: rgba(255, 255, 255, 0.02);
    }

    .badge {
      display: inline-block;
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
      font-size: 0.75rem;
      background: var(--border);
      color: var(--text-muted);
      margin-right: 0.25rem;
      margin-bottom: 0.25rem;
    }

    .badge-success {
      background: rgba(16, 185, 129, 0.1);
      color: var(--success);
      border: 1px solid var(--success);
    }

    .badge-danger {
      background: rgba(239, 68, 68, 0.1);
      color: var(--danger);
      border: 1px solid var(--danger);
    }

    /* =========================================================================
       7. FORM CONTROL STYLES
       ========================================================================= */
    .form-group {
      margin-bottom: 1.25rem;
    }

    .form-group label {
      display: block;
      margin-bottom: 0.5rem;
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    .form-control {
      width: 100%;
      background: var(--bg-dark);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 0.75rem;
      border-radius: 4px;
      font-size: 0.95rem;
    }

    .form-control:focus {
      outline: 1px solid var(--primary);
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .form-group-checkbox {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 1rem;
    }

    /* =========================================================================
       8. TAB CONTROLS (LANGUAGES & CATEGORIES)
       ========================================================================= */
    .tabs {
      display: flex;
      border-bottom: 1px solid var(--border);
      margin-bottom: 1rem;
    }

    .tab-btn {
      background: none;
      border: none;
      color: var(--text-muted);
      padding: 0.5rem 1rem;
      cursor: pointer;
      border-bottom: 2px solid transparent;
      font-weight: 500;
    }

    .tab-btn.active {
      color: var(--primary);
      border-bottom-color: var(--primary);
    }

    .tab-content {
      display: none;
      background: rgba(0, 0, 0, 0.15);
      padding: 1rem;
      border-radius: 4px;
      border: 1px solid var(--border);
      margin-bottom: 1rem;
    }

    .tab-content.active {
      display: block;
    }

    .copy-helper-btn {
      float: right;
      font-size: 0.75rem;
      background: #334155;
      color: #cbd5e1;
      border: none;
      padding: 0.2rem 0.5rem;
      border-radius: 3px;
      cursor: pointer;
      margin-bottom: 0.5rem;
    }

    .copy-helper-btn:hover {
      background: #475569;
    }

    /* =========================================================================
       9. MODALS & DIALOG OVERRIDES
       ========================================================================= */
    .dialog {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      padding: 2rem;
      margin: auto;
      max-width: 600px;
      width: 90%;
    }

    .dialog::backdrop {
      background: rgba(0, 0, 0, 0.8);
    }

    .dialog-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.5rem;
    }

    .dialog h3 {
      color: var(--primary);
    }

    .dialog-close {
      background: none;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 1.5rem;
    }

    /* =========================================================================
       10. SLIDERS & TOGGLES
       ========================================================================= */
    .switch {
      position: relative;
      display: inline-block;
      width: 44px;
      height: 24px;
    }

    .switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }

    .slider {
      position: absolute;
      cursor: pointer;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: #475569;
      transition: .4s;
      border-radius: 24px;
    }

    .slider:before {
      position: absolute;
      content: "";
      height: 16px;
      width: 16px;
      left: 4px;
      bottom: 4px;
      background-color: white;
      transition: .4s;
      border-radius: 50%;
    }

    input:checked + .slider {
      background-color: var(--success);
    }

    input:checked + .slider:before {
      transform: translateX(20px);
    }

    .select-checkbox {
      width: 18px;
      height: 18px;
      cursor: pointer;
    }

    /* =========================================================================
       11. PRINT & EXPORT LAYOUT STYLES
       ========================================================================= */
    .print-panel {
      background: #1e293b;
      padding: 1.5rem;
      border-radius: 8px;
      border: 1px solid #334155;
      margin-top: 1.5rem;
    }

    .print-category-group {
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 1.25rem;
      margin-bottom: 1.5rem;
      background: rgba(255, 255, 255, 0.01);
    }

    .category-header-controls {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.75rem;
      margin-bottom: 0.75rem;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .category-select-label {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 1.1rem;
      cursor: pointer;
    }

    .category-export-options {
      display: flex;
      gap: 1rem;
      align-items: center;
    }

    .category-export-options label {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      font-size: 0.85rem;
      color: var(--text-muted);
      cursor: pointer;
    }

    .category-items-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 0.75rem;
      padding: 0.5rem 0;
    }

    .print-item-label {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.95rem;
      cursor: pointer;
      padding: 0.25rem;
      border-radius: 4px;
    }

    .print-item-label:hover {
      background: rgba(255, 255, 255, 0.03);
    }

    .print-item-label input:disabled + span {
      color: var(--text-muted);
      opacity: 0.6;
      cursor: not-allowed;
    }

    .muted-price {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .print-actions-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border);
      flex-wrap: wrap;
      gap: 1rem;
    }

    .global-helper-bar {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 1rem;
      margin-bottom: 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .global-helper-buttons {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    /* =========================================================================
       12. ALERTS, LOGGERS & LOADING SPINNER
       ========================================================================= */
    #alert-banner {
      display: none;
      padding: 1rem;
      border-radius: 4px;
      margin-bottom: 1.5rem;
      font-weight: 500;
    }

    #alert-banner.success {
      background: rgba(16, 185, 129, 0.15);
      color: var(--success);
      border: 1px solid var(--success);
    }

    #alert-banner.error {
      background: rgba(239, 68, 68, 0.15);
      color: var(--danger);
      border: 1px solid var(--danger);
    }

    #loading-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.6);
      z-index: 9999;
      justify-content: center;
      align-items: center;
      color: white;
      font-size: 1.5rem;
      font-weight: bold;
    }

    .spinner {
      border: 4px solid rgba(255, 255, 255, 0.1);
      width: 50px;
      height: 50px;
      border-radius: 50%;
      border-left-color: var(--primary);
      animation: spin 1s linear infinite;
      margin-bottom: 1rem;
    }

    @keyframes spin {
      0% {
        transform: rotate(0deg);
      }
      100% {
        transform: rotate(360deg);
      }
    }
  </style>
</head>
<body>
  <div class="admin-container">

  <header>
    <div class="header-left">
      <img src="/images/opera-logo.png" alt="Opera Logo" class="logo" />
    </div>
    <div class="header-center">
      <h1>Opera menu manager</h1>
    </div>
    <div class="header-right">
      <span class="user-tag">User: {userEmail}</span>
      <span style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.5rem;">Version: {version}</span>
      <button class="btn btn-sm" onclick="triggerPublish()" style="padding: 0.4rem 0.8rem; font-size: 0.85rem;">Publish Changes</button>
    </div>
  </header>

  <!-- Loading Overlay -->
  <div id="loading-overlay">
    <div style="text-align: center;">
      <div class="spinner"></div>
      <p>Saving Changes...</p>
    </div>
  </div>

  <div class="grid">
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      <!-- Sidebar navigation -->
      <div class="sidebar">
        <div class="sidebar-nav">
          <button onclick="switchTab('items')" id="nav-items" class="active">Menu Items</button>
          <button onclick="switchTab('categories')" id="nav-categories">Categories</button>
          <button onclick="switchTab('ingredients')" id="nav-ingredients">Ingredients</button>
          <button onclick="switchTab('tags')" id="nav-tags">Flavor Tags</button>
          <button onclick="switchTab('media')" id="nav-media">Media Gallery</button>
          <button onclick="switchTab('print')" id="nav-print">Print menu</button>
          <button onclick="switchTab('db')" id="nav-db">DB Management</button>
        </div>
      </div>
      <!-- Alert Banner -->
      <div id="alert-banner"></div>
    </div>

    <!-- Main Content Area -->
    <div class="content-area">
      
      <!-- Section: MENU ITEMS -->
      <section id="section-items">
        <div class="action-bar">
          <h2>Menu Items</h2>
          <div style="display: flex; gap: 0.5rem;">
            <button class="btn" onclick="openItemDialog()">+ Add Menu Item</button>
          </div>
        </div>

        <!-- Category sub-tabs -->
        <div class="category-subtabs" style="display: flex; gap: 0.5rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem; flex-wrap: wrap;">
          {categories.map((category, index) => (
            <button 
              type="button" 
              class={`tab-btn category-tab-btn ${index === 0 ? 'active' : ''}`} 
              onclick={`switchCategoryTab(${category.id})`}
              id={`cat-tab-${category.id}`}
            >
              {category.name}
            </button>
          ))}
        </div>

        <!-- Search and Pagination Controls -->
        <div class="search-pagination-bar" style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
          <div style="flex: 1; min-width: 250px;">
            <input type="text" id="admin-search-input" placeholder="Search menu items by name, ingredients, or tags..." style="width: 100%; padding: 0.6rem 1rem; border-radius: 4px; border: 2px solid var(--primary); background: var(--bg-card); color: var(--text);" oninput="updateFilteredItems()" />
          </div>
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <span style="font-size: 0.9rem; color: var(--text-muted);">Items per page:</span>
            <select id="admin-page-size" style="padding: 0.5rem; border-radius: 4px; border: 1px solid var(--border); background: var(--bg-card); color: var(--text);" onchange="changePageSize(this.value)">
              <option value="10" selected>10</option>
              <option value="25">25</option>
              <option value="50">50</option>
              <option value="all">All</option>
            </select>
          </div>
        </div>

        {categories.map((category, index) => {
          const items = menuItems.filter(item => item.category_id === category.id);
          const isBottles = category.code_name === 'bottles';
          return (
            <div 
              class="category-items-table" 
              id={`category-table-${category.id}`} 
              style={`display: ${index === 0 ? 'block' : 'none'};`}
            >
              {isBottles && (
                <div style="margin-bottom: 2rem; background: rgba(197, 168, 128, 0.05); padding: 1.5rem; border-radius: 6px; border: 1px solid var(--border);">
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                    <h3 style="font-size: 1.1rem; color: var(--primary);">Manage Bottle Types</h3>
                    <button class="btn btn-sm" onclick="openBottleTypeDialog()">+ Add Bottle Type</button>
                  </div>
                  <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                    {bottleTypes.map(bt => (
                      <div class="badge" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.75rem; background: var(--border); border-radius: 4px; font-size: 0.9rem;">
                        <span>{bt.name}</span>
                        <button type="button" class="btn-link" data-bt={JSON.stringify(bt)} onclick="editBottleType(JSON.parse(this.dataset.bt))" style="background: none; border: none; color: var(--primary); cursor: pointer; font-size: 0.8rem;">Edit</button>
                        <button type="button" class="btn-link" onclick={`deleteBottleType(${bt.id})`} style="background: none; border: none; color: var(--danger); cursor: pointer; font-size: 0.8rem;">&times;</button>
                      </div>
                    ))}
                    {bottleTypes.length === 0 && (
                      <span style="color: var(--text-muted); font-size: 0.9rem;">No bottle types configured yet.</span>
                    )}
                  </div>
                </div>
              )}
              <table>
                <thead>
                  {isBottles ? (
                    <tr>
                      <th>Name (EN)</th>
                      <th>Price (NTD$)</th>
                      <th>Type</th>
                      <th>Volume</th>
                      <th>Ingredients</th>
                      <th>Tags</th>
                      <th>Picture</th>
                      <th>Visible</th>
                      <th data-sortable="false">Actions</th>
                    </tr>
                  ) : (
                    <tr>
                      <th>Name (EN)</th>
                      <th>Price (NTD$)</th>
                      <th>Ingredients</th>
                      <th>Tags</th>
                      <th>Picture</th>
                      <th>Visible</th>
                      <th data-sortable="false">Actions</th>
                    </tr>
                  )}
                </thead>
                <tbody>
                  {items.map(item => (
                    <tr data-id={item.id}>
                      {isBottles ? (
                        <>
                          <td style="font-weight: 500;">{item.name}</td>
                          <td>{item.price}</td>
                          <td><span class="badge" style="background: rgba(197, 168, 128, 0.1); color: var(--primary);">{item.bottle_type || '-'}</span></td>
                          <td>{item.bottle_volume !== undefined ? `${item.bottle_volume} L` : '-'}</td>
                        </>
                      ) : (
                        <>
                          <td style="font-weight: 500;">{item.name}</td>
                          <td>{item.price}</td>
                        </>
                      )}
                      <td>
                        {item.ingredients.map(ing => (
                          <span class="badge">{ing}</span>
                        ))}
                      </td>
                      <td>
                        {item.tags.map(tag => (
                          <span class="badge">{tag}</span>
                        ))}
                      </td>
                      <td style={`font-weight: 500; color: ${item.media_id ? 'var(--success)' : 'inherit'};`}>{item.media_id ? 'Yes' : 'No'}</td>
                      <td>
                        <label class="switch">
                          <input type="checkbox" checked={item.is_available} onchange={`toggleAvailability(${item.id}, this.checked)`} />
                          <span class="slider"></span>
                        </label>
                      </td>
                      <td>
                        <button class="btn btn-secondary btn-sm" data-item={JSON.stringify(item)} onclick="editItem(JSON.parse(this.dataset.item))">Edit</button>
                        <button class="btn btn-danger btn-sm" onclick={`deleteItem(${item.id})`}>Delete</button>
                      </td>
                    </tr>
                  ))}
                  {items.length === 0 && (
                    <tr>
                      <td colspan={isBottles ? 9 : 7} style="text-align: center; color: var(--text-muted); padding: 2rem;">No items in this category.</td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          );
        })}
        <!-- Pagination controls container -->
        <div id="admin-pagination-container" style="display: flex; justify-content: center; align-items: center; gap: 0.5rem; margin-top: 1.5rem; margin-bottom: 1.5rem;"></div>
      </section>

      <!-- Section: CATEGORIES -->
      <section id="section-categories" style="display: none;">
        <div class="action-bar">
          <h2>Categories</h2>
          <button class="btn" onclick="openCategoryDialog()">+ Add Category</button>
        </div>
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Code Name</th>
              <th>Display Name (EN)</th>
              <th data-sortable="false">Actions</th>
            </tr>
          </thead>
          <tbody>
            {categories.map(cat => (
              <tr>
                <td>{cat.id}</td>
                <td><code>{cat.code_name}</code></td>
                <td>{cat.name}</td>
                <td>
                  <button class="btn btn-secondary btn-sm" onclick={`editCategory(${cat.id}, '${cat.code_name}')`}>Edit</button>
                  <button class="btn btn-danger btn-sm" onclick={`deleteCategory(${cat.id})`}>Delete</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <!-- Section: INGREDIENTS -->
      <section id="section-ingredients" style="display: none;">
        <div class="action-bar">
          <h2>Ingredients</h2>
          <button class="btn" onclick="openIngredientDialog()">+ Add Ingredient</button>
        </div>
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Code Name</th>
              <th>Display Name (EN)</th>
              <th data-sortable="false">Actions</th>
            </tr>
          </thead>
          <tbody>
            {ingredients.map(ing => (
              <tr>
                <td>{ing.id}</td>
                <td><code>{ing.code_name}</code></td>
                <td>{ing.name}</td>
                <td>
                  <button class="btn btn-secondary btn-sm" onclick={`editIngredient(${ing.id}, '${ing.code_name}')`}>Edit</button>
                  <button class="btn btn-danger btn-sm" onclick={`deleteIngredient(${ing.id})`}>Delete</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <!-- Section: FLAVOR TAGS -->
      <section id="section-tags" style="display: none;">
        <div class="action-bar">
          <h2>Flavor Tags</h2>
          <button class="btn" onclick="openTagDialog()">+ Add Flavor Tag</button>
        </div>
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Code Name</th>
              <th>Display Name (EN)</th>
              <th data-sortable="false">Actions</th>
            </tr>
          </thead>
          <tbody>
            {flavorTags.map(tag => (
              <tr>
                <td>{tag.id}</td>
                <td><code>{tag.code_name}</code></td>
                <td>{tag.name}</td>
                <td>
                  <button class="btn btn-secondary btn-sm" onclick={`editTag(${tag.id}, '${tag.code_name}')`}>Edit</button>
                  <button class="btn btn-danger btn-sm" onclick={`deleteTag(${tag.id})`}>Delete</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <!-- Section: PRINT MENU -->
      <section id="section-print" style="display: none;">
        <div class="action-bar">
          <h2>Print & Export Menu</h2>
        </div>

        <!-- Global Helper Bar -->
        <div class="global-helper-bar">
          <div class="global-helper-buttons">
            <button class="btn btn-secondary btn-sm" onclick="globalToggleCategories(true)">Select All Categories</button>
            <button class="btn btn-secondary btn-sm" onclick="globalToggleCategories(false)">Deselect All Categories</button>
          </div>
          <div class="global-helper-buttons">
            <button class="btn btn-secondary btn-sm" onclick="globalToggleOption('desc')">Toggle All Descriptions</button>
            <button class="btn btn-secondary btn-sm" onclick="globalToggleOption('price')">Toggle All Prices</button>
            <button class="btn btn-secondary btn-sm" onclick="globalToggleOption('ing')">Toggle All Ingredients</button>
            <button class="btn btn-secondary btn-sm" onclick="globalToggleOption('tags')">Toggle All Tags</button>
          </div>
        </div>

        <!-- Categories & Items list -->
        <div class="print-categories-list">
          {categories.map(category => {
            const items = menuItems.filter(item => item.category_name === category.name);
            return (
              <div class="print-category-group" data-category-id={category.id} data-category-name={category.name}>
                <div class="category-header-controls">
                  <label class="category-select-label">
                    <input 
                      type="checkbox" 
                      class="category-selector" 
                      data-category-id={category.id} 
                      onchange="toggleCategoryItems(this)" 
                    />
                    <strong>{category.name}</strong>
                  </label>
                  <div class="category-export-options">
                    <label>
                      <input type="checkbox" class="category-opt-desc" data-category-id={category.id} checked />
                      Description
                    </label>
                    <label>
                      <input type="checkbox" class="category-opt-price" data-category-id={category.id} checked />
                      Price
                    </label>
                    <label>
                      <input type="checkbox" class="category-opt-ing" data-category-id={category.id} checked />
                      Ingredients
                    </label>
                    <label>
                      <input type="checkbox" class="category-opt-tags" data-category-id={category.id} checked />
                      Tags
                    </label>
                  </div>
                </div>
                <div class="category-items-list" id={`category-items-${category.id}`}>
                  {items.map(item => (
                    <label class="print-item-label">
                      <input 
                        type="checkbox" 
                        class="print-item-selector" 
                        data-item-id={item.id} 
                        data-category-id={category.id} 
                        disabled 
                      />
                      <span>{item.name} <span class="muted-price">(NTD$ {item.price})</span></span>
                    </label>
                  ))}
                  {items.length === 0 && (
                    <span style="color: var(--text-muted); font-size: 0.9rem; grid-column: 1/-1;">No items in this category.</span>
                  )}
                </div>
              </div>
            );
          })}
        </div>

        <!-- Print Actions at bottom of page -->
        <div class="print-actions-bar">
          <div>
            <label style="font-size: 0.9rem; color: var(--text-muted); display: inline-block; margin-right: 0.5rem;">Target Language:</label>
            <select id="print-lang" class="form-control" style="width: 150px; display: inline-block; padding: 0.4rem; vertical-align: middle;">
              <option value="en">English (EN)</option>
              <option value="fr">French (FR)</option>
              <option value="ja">Japanese (JA)</option>
              <option value="zh">Chinese (ZH)</option>
            </select>
          </div>
          <div style="display: flex; gap: 0.5rem;">
            <button class="btn btn-secondary" onclick="backupDatabase()">Backup database</button>
            <button class="btn btn-secondary" onclick="exportToMarkdown()">Export .md</button>
            <button class="btn" onclick="generatePrintedLayout()">Print pdf</button>
          </div>
        </div>
      </section>

      <!-- Section: DB MANAGEMENT -->
      <section id="section-db" style="display: none;">
        <div class="action-bar">
          <h2>DB Management</h2>
          <button class="btn btn-danger" onclick="purgeAllOrphans()" disabled={orphans.ingredients.length === 0 && orphans.translations.length === 0 && orphans.pivotIngredients.length === 0 && orphans.pivotTags.length === 0 && orphans.media.length === 0}>
            Purge All Orphans
          </button>
        </div>
        <p class="description-text" style="color: var(--text-muted); margin-bottom: 2rem;">
          Validate and purge orphan records in the database. Deleting menu items, categories, ingredients, or flavor tags can leave dangling associations or translations. We purge them in the correct database deletion sequence to avoid constraint errors.
        </p>

        <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem;">
          <!-- Card: Orphan Ingredients -->
          <div style="background: var(--bg-dark); border: 1px solid var(--border); padding: 1.5rem; border-radius: 6px;">
            <h3 style="color: var(--primary); font-size: 1.1rem; margin-bottom: 1rem; display: flex; justify-content: space-between;">
              <span>Orphan Ingredients</span>
              <span class="user-tag" style="background: rgba(197, 168, 128, 0.1); color: var(--primary);">{orphans.ingredients.length}</span>
            </h3>
            {orphans.ingredients.length > 0 ? (
              <div style="max-height: 250px; overflow-y: auto;">
                <table style="width: 100%; font-size: 0.9rem;">
                  <thead>
                    <tr>
                      <th style="text-align: left; padding: 0.5rem;">ID</th>
                      <th style="text-align: left; padding: 0.5rem;">Code Name</th>
                      <th style="text-align: left; padding: 0.5rem;">Display Name</th>
                    </tr>
                  </thead>
                  <tbody>
                    {orphans.ingredients.map(ing => (
                      <tr>
                        <td style="padding: 0.5rem; color: var(--text-muted);">{ing.id}</td>
                        <td style="padding: 0.5rem;"><code>{ing.code_name}</code></td>
                        <td style="padding: 0.5rem;">{ing.name}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <p style="color: var(--success); font-size: 0.9rem;">No orphan ingredients found.</p>
            )}
          </div>

          <!-- Card: Orphan Translations -->
          <div style="background: var(--bg-dark); border: 1px solid var(--border); padding: 1.5rem; border-radius: 6px;">
            <h3 style="color: var(--primary); font-size: 1.1rem; margin-bottom: 1rem; display: flex; justify-content: space-between;">
              <span>Orphan Translations</span>
              <span class="user-tag" style="background: rgba(197, 168, 128, 0.1); color: var(--primary);">{orphans.translations.length}</span>
            </h3>
            {orphans.translations.length > 0 ? (
              <div style="max-height: 250px; overflow-y: auto;">
                <table style="width: 100%; font-size: 0.9rem;">
                  <thead>
                    <tr>
                      <th style="text-align: left; padding: 0.5rem;">ID</th>
                      <th style="text-align: left; padding: 0.5rem;">Locale</th>
                      <th style="text-align: left; padding: 0.5rem;">Entity Type</th>
                      <th style="text-align: left; padding: 0.5rem;">Entity ID</th>
                      <th style="text-align: left; padding: 0.5rem;">Translated Name</th>
                    </tr>
                  </thead>
                  <tbody>
                    {orphans.translations.map(tr => (
                      <tr>
                        <td style="padding: 0.5rem; color: var(--text-muted);">{tr.id}</td>
                        <td style="padding: 0.5rem;"><code style="text-transform: uppercase;">{tr.locale}</code></td>
                        <td style="padding: 0.5rem; color: var(--text-muted);">{tr.entity_type}</td>
                        <td style="padding: 0.5rem; color: var(--text-muted);">{tr.entity_id}</td>
                        <td style="padding: 0.5rem;">{tr.name}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <p style="color: var(--success); font-size: 0.9rem;">No orphan translations found.</p>
            )}
          </div>

          <!-- Card: Orphan Joins -->
          <div style="background: var(--bg-dark); border: 1px solid var(--border); padding: 1.5rem; border-radius: 6px;">
            <h3 style="color: var(--primary); font-size: 1.1rem; margin-bottom: 1rem; display: flex; justify-content: space-between;">
              <span>Invalid Join Entries (Pivot Tables)</span>
              <span class="user-tag" style="background: rgba(197, 168, 128, 0.1); color: var(--primary);">{orphans.pivotIngredients.length + orphans.pivotTags.length}</span>
            </h3>
            {orphans.pivotIngredients.length > 0 || orphans.pivotTags.length > 0 ? (
              <div style="max-height: 200px; overflow-y: auto;">
                <ul style="font-size: 0.9rem; padding-left: 1.5rem;">
                  {orphans.pivotIngredients.map(entry => (
                    <li style="margin-bottom: 0.25rem;">
                      Ingredient pivot row references missing Menu Item <code style="color: var(--danger);">ID {entry.menu_item_id}</code> or Ingredient <code style="color: var(--danger);">ID {entry.ingredient_id}</code>
                    </li>
                  ))}
                  {orphans.pivotTags.map(entry => (
                    <li style="margin-bottom: 0.25rem;">
                      Tag pivot row references missing Menu Item <code style="color: var(--danger);">ID {entry.menu_item_id}</code> or Tag <code style="color: var(--danger);">ID {entry.tag_id}</code>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <p style="color: var(--success); font-size: 0.9rem;">No invalid join entries found.</p>
            )}
          </div>

          <!-- Card: Orphan Media -->
          <div style="background: var(--bg-dark); border: 1px solid var(--border); padding: 1.5rem; border-radius: 6px;">
            <h3 style="color: var(--primary); font-size: 1.1rem; margin-bottom: 1rem; display: flex; justify-content: space-between;">
              <span>Orphan Media Assets</span>
              <span class="user-tag" style="background: rgba(197, 168, 128, 0.1); color: var(--primary);">{orphans.media.length}</span>
            </h3>
            {orphans.media.length > 0 ? (
              <div style="max-height: 250px; overflow-y: auto;">
                <table style="width: 100%; font-size: 0.9rem;">
                  <thead>
                    <tr>
                      <th style="text-align: left; padding: 0.5rem;">ID</th>
                      <th style="text-align: left; padding: 0.5rem;">Preview</th>
                      <th style="text-align: left; padding: 0.5rem;">URL / Alt Text</th>
                    </tr>
                  </thead>
                  <tbody>
                    {orphans.media.map(med => (
                      <tr>
                        <td style="padding: 0.5rem; color: var(--text-muted);">{med.id}</td>
                        <td style="padding: 0.5rem;">
                          <img src={med.url} alt={med.alt_text || ''} style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px; border: 1px solid var(--border);" />
                        </td>
                        <td style="padding: 0.5rem;">
                          <div style="font-weight: 500; word-break: break-all;">{med.url}</div>
                          <div style="font-size: 0.8rem; color: var(--text-muted);">{med.alt_text || 'No alt text'}</div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <p style="color: var(--success); font-size: 0.9rem;">No orphan media assets found.</p>
            )}
          </div>
        </div>
      </section>

      <!-- Section: MEDIA GALLERY -->
      <section id="section-media" style="display: none;">
        <div class="action-bar">
          <h2>Media Gallery</h2>
          <button class="btn" onclick="openMediaDialog()">+ Add Media</button>
        </div>
        <p class="description-text" style="color: var(--text-muted); margin-bottom: 2rem;">
          Manage the media pictures used by the menu items. Set alt text (which acts as a descriptive name) and enter the static path or URL.
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1.5rem;" id="media-grid-container">
          {media.map(m => (
            <div class="media-card" style="background: var(--bg-dark); border: 1px solid var(--border); border-radius: 6px; overflow: hidden; display: flex; flex-direction: column;" data-media-id={m.id}>
              <div style="height: 150px; background: #1a1a1a; display: flex; align-items: center; justify-content: center; overflow: hidden; border-bottom: 1px solid var(--border);">
                <img src={m.url} alt={m.alt_text || 'No description'} style="max-width: 100%; max-height: 100%; object-fit: contain;" onerror="this.onerror=null; this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'100\' height=\'100\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'%23c5a880\' stroke-width=\'1\' stroke-linecap=\'round\' stroke-linejoin=\'round\'><rect x=\'3\' y=\'3\' width=\'18\' height=\'18\' rx=\'2\' ry=\'2\'/><circle cx=\'8.5\' cy=\'8.5\' r=\'1.5\'/><polyline points=\'21 15 16 10 5 21\'/></svg>';" />
              </div>
              <div style="padding: 1rem; flex-grow: 1; display: flex; flex-direction: column; gap: 0.5rem;">
                <h4 style="font-size: 0.95rem; font-weight: 600; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--primary);" title={m.alt_text || 'No Alt Text'}>
                  {m.alt_text || <span style="font-style: italic; color: var(--text-muted);">No Alt Text (Name)</span>}
                </h4>
                <div style="font-size: 0.8rem; color: var(--text-muted); word-break: break-all; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 1.3;" title={m.url}>
                  {m.url}
                </div>
                <div style="margin-top: auto; display: flex; justify-content: flex-end; gap: 0.5rem; padding-top: 0.75rem; border-top: 1px solid rgba(255,255,255,0.05);">
                  <button class="btn btn-secondary btn-sm" data-media={JSON.stringify(m)} onclick="openMediaDialog(JSON.parse(this.dataset.media))" style="padding: 0.25rem 0.5rem; font-size: 0.8rem;">Edit</button>
                  <button class="btn btn-danger btn-sm" onclick={`deleteMediaRecord(${m.id})`} style="padding: 0.25rem 0.5rem; font-size: 0.8rem; background: var(--danger);">Delete</button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

    </div>
  </div>

  <!-- DIALOG: MENU ITEM FORM -->
  <dialog id="dialog-item" class="dialog">
    <div class="dialog-header">
      <h3 id="dialog-item-title">Add Menu Item</h3>
      <button class="dialog-close" onclick="closeDialog('dialog-item')">&times;</button>
    </div>
    <form id="form-item" onsubmit="submitItem(event)">
      <input type="hidden" name="id" id="item-id" />
      
      <div class="form-row">
        <div class="form-group">
          <label>English Display Name (Primary)</label>
          <input type="text" id="item-en-name" name="translations.en.name" class="form-control" required oninput="handleSlugAutoGeneration(this.value)" />
        </div>
        <div class="form-group">
          <label>Code Name / Slug (Auto-generated)</label>
          <input type="text" id="item-code-name" name="code_name" class="form-control" required />
        </div>
      </div>

      <!-- Localization Tabs inside dialog -->
      <div style="margin-top: 1rem;">
        <label style="color: var(--text-muted); font-size: 0.85rem; display: block; margin-bottom: 0.5rem;">Localizations</label>
        <div class="tabs">
          <button type="button" class="tab-btn active" onclick="switchLanguageTab('en')">EN</button>
          <button type="button" class="tab-btn" onclick="switchLanguageTab('fr')">FR</button>
          <button type="button" class="tab-btn" onclick="switchLanguageTab('ja')">JA</button>
          <button type="button" class="tab-btn" onclick="switchLanguageTab('zh')">ZH</button>
        </div>
        
        <!-- Locale EN Tab -->
        <div id="locale-tab-en" class="tab-content active">
          <div class="form-group">
            <label>Description (EN)</label>
            <textarea id="item-en-desc" name="translations.en.description" class="form-control" rows="2"></textarea>
          </div>
        </div>

        <!-- Locale FR Tab -->
        <div id="locale-tab-fr" class="tab-content">
          <button type="button" class="copy-helper-btn" onclick="copyFromEnglish('fr')">Copy EN Content</button>
          <div class="form-group">
            <label>Name (FR)</label>
            <input type="text" id="item-fr-name" name="translations.fr.name" class="form-control" />
          </div>
          <div class="form-group">
            <label>Description (FR)</label>
            <textarea id="item-fr-desc" name="translations.fr.description" class="form-control" rows="2"></textarea>
          </div>
        </div>

        <!-- Locale JA Tab -->
        <div id="locale-tab-ja" class="tab-content">
          <button type="button" class="copy-helper-btn" onclick="copyFromEnglish('ja')">Copy EN Content</button>
          <div class="form-group">
            <label>Name (JA)</label>
            <input type="text" id="item-ja-name" name="translations.ja.name" class="form-control" />
          </div>
          <div class="form-group">
            <label>Description (JA)</label>
            <textarea id="item-ja-desc" name="translations.ja.description" class="form-control" rows="2"></textarea>
          </div>
        </div>

        <!-- Locale ZH Tab -->
        <div id="locale-tab-zh" class="tab-content">
          <button type="button" class="copy-helper-btn" onclick="copyFromEnglish('zh')">Copy EN Content</button>
          <div class="form-group">
            <label>Name (ZH)</label>
            <input type="text" id="item-zh-name" name="translations.zh.name" class="form-control" />
          </div>
          <div class="form-group">
            <label>Description (ZH)</label>
            <textarea id="item-zh-desc" name="translations.zh.description" class="form-control" rows="2"></textarea>
          </div>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label>Category</label>
          <select id="item-category" name="category_id" class="form-control" required onchange="toggleBottleFields()">
            {categories.map(c => (
              <option value={c.id} data-code-name={c.code_name}>{c.name}</option>
            ))}
          </select>
        </div>
        <div class="form-group">
          <label>Price (NTD$)</label>
          <input type="number" id="item-price" name="price" class="form-control" required />
        </div>
      </div>

      <!-- Bottle Details (Only for Bottles category) -->
      <div class="form-row" id="bottle-fields-row" style="display: none;">
        <div class="form-group">
          <label>Bottle Type</label>
          <select id="item-bottle-type" name="bottle_type_id" class="form-control">
            <option value="">Select Type</option>
            {bottleTypes.map(bt => (
              <option value={bt.id}>{bt.name}</option>
            ))}
          </select>
        </div>
        <div class="form-group">
          <label>Volume (Liters)</label>
          <input type="number" step="0.01" id="item-bottle-volume" name="bottle_volume" class="form-control" placeholder="e.g. 0.7" />
        </div>
      </div>

      <div class="form-row">
        <div class="form-group" style="flex-grow: 1;">
          <label>Attached Picture Path</label>
          <div style="display: flex; gap: 1rem; align-items: center;">
            <select id="item-media" name="media_id" class="form-control" onchange="updateItemMediaPreview()" style="flex-grow: 1;">
              <option value="">No Media Attached</option>
              {media.map(m => (
                <option value={m.id}>{m.alt_text ? `${m.alt_text} (${m.url})` : m.url}</option>
              ))}
            </select>
            <div id="item-media-preview-container" style="width: 50px; height: 50px; border: 1px solid var(--border); border-radius: 4px; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #1a1a1a; flex-shrink: 0;">
              <img id="item-media-preview" src="" style="max-width: 100%; max-height: 100%; object-fit: contain; display: none;" />
              <span id="item-media-preview-placeholder" style="font-size: 0.7rem; color: var(--text-muted);">None</span>
            </div>
          </div>
        </div>
        <div class="form-group-checkbox" style="align-self: center; margin-top: 1rem;">
          <input type="checkbox" id="item-available" name="is_available" checked style="width: 20px; height: 20px;" />
          <label for="item-available" style="margin-bottom: 0;">Visible on website menu</label>
        </div>
      </div>

