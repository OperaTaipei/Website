    }

    function compressImage(file, maxDim, quality) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = function(event) {
          const img = new Image();
          img.onload = function() {
            const canvas = document.createElement('canvas');
            let width = img.width;
            let height = img.height;

            if (width > height) {
              if (width > maxDim) {
                height = Math.round((height * maxDim) / width);
                width = maxDim;
              }
            } else {
              if (height > maxDim) {
                width = Math.round((width * maxDim) / height);
                height = maxDim;
              }
            }

            canvas.width = width;
            canvas.height = height;

            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, width, height);

            const mimeType = file.type || 'image/jpeg';
            canvas.toBlob((blob) => {
              if (blob) {
                resolve(blob);
              } else {
                reject(new Error('Canvas compilation failed'));
              }
            }, mimeType, quality);
          };
          img.onerror = () => reject(new Error('Image failed to load'));
          img.src = event.target.result;
        };
        reader.onerror = () => reject(new Error('File reader failed'));
        reader.readAsDataURL(file);
      });
    }

    async function submitMedia(event) {
      event.preventDefault();
      const form = document.getElementById('form-media');
      const formData = new FormData(form);

      const fileInput = document.getElementById('media-file');
      let file = fileInput.files[0];
      const isEdit = !!formData.get('id');

      // Client-side validations
      if (file) {
        // Extension validation first
        const allowedExtensions = /(\.jpg|\.jpeg|\.png)$/i;
        if (!allowedExtensions.exec(file.name)) {
          alert('Only JPG and PNG files are allowed.');
          return;
        }

        // Auto-compression logic if size exceeds 150 KB
        if (file.size > 153600) {
          try {
            showLoading(true);
            const compressedBlob = await compressImage(file, 1200, 0.7);
            showLoading(false);
            if (compressedBlob.size > 153600) {
              const moreCompressedBlob = await compressImage(file, 800, 0.5);
              if (moreCompressedBlob.size > 153600) {
                alert('Image is too large and could not be compressed below 150 KB. Please select a smaller image.');
                return;
              }
              formData.set('file', moreCompressedBlob, file.name);
            } else {
              formData.set('file', compressedBlob, file.name);
            }
          } catch (compressErr) {
            showLoading(false);
            alert('Failed to compress image. Please upload an image smaller than 150 KB.');
            return;
          }
        }
      } else if (!isEdit) {
        alert('Please select an image file to upload.');
        return;
      }

      await callAction('saveMedia', formData);
      closeDialog('dialog-media');
    }

    async function deleteMediaRecord(id) {
      const mediaItem = window.allMedia.find(m => m.id === id);
      if (!mediaItem) return;

      // Check if it is used by any menu items
      const referencingItems = window.allMenuItems.filter(i => i.media_id === id);
      if (referencingItems.length > 0) {
        const name = `Media "${mediaItem.alt_text || mediaItem.url}"`;
        const cascades = [
          `This media is currently attached to: ${referencingItems.map(i => `"${i.name}"`).join(', ')}`,
          `Deleting it will clear the media association for these menu items.`
        ];
        showDeleteCascadeModal(name, cascades, async () => {
          await callAction('deleteMedia', { id });
        });
      } else {
        if (confirm('Are you sure you want to delete this media?')) {
          await callAction('deleteMedia', { id });
        }
      }
    }

