      showLoading(true);
      try {
        const transRes = await fetch(`/opera-admin/api/translations?entity_type=ingredient&id=${id}`);
        const translations = await transRes.json();
        ['en', 'fr', 'ja', 'zh'].forEach(loc => {
          const t = translations[loc] || { name: '' };
          document.getElementById(`ingredient-${loc}`).value = t.name || '';
        });
      } finally {
        showLoading(false);
      }
    }

    async function submitIngredient(event) {
      event.preventDefault();
      const form = document.getElementById('form-ingredient');
