---
interface Props {
  t: any;
  lang?: string;
}

const { t, lang = 'en' } = Astro.props;
const quoteUrl = !lang || lang === 'en' ? '/quote' : `/${lang}/quote`;
---

<!-- Gallery Section first (matching design flow) -->
<section id="gallery" class="fade-in">
  <div class="section-wrap">
    <p class="section-label">{t.gallery_label}</p>
    <h2 class="section-title" set:html={t.gallery_title} />
    <div class="section-divider"></div>

    <div class="gallery-action-container">
      <button id="open-vibe-btn" class="btn-gold"><span>{t.gallery_experience_vibe}</span></button>
    </div>

    <div class="gallery-grid">
      <div class="gallery-item">
        <img src="/images/nz93950-enhanced-nr.jpg" alt="Opera Taipei panoramic view" loading="lazy" onerror="this.onerror=null;this.style.display='none';this.parentElement.classList.add('img-error');">
      </div>
      <div class="gallery-item">
        <img src="/images/nz93619-enhanced-nr.jpg" alt="Opera Taipei bar area" loading="lazy" onerror="this.onerror=null;this.style.display='none';this.parentElement.classList.add('img-error');">
      </div>
      <div class="gallery-item">
        <img src="/images/nz93801-enhanced-nr.jpg" alt="Opera Taipei interior" loading="lazy" onerror="this.onerror=null;this.style.display='none';this.parentElement.classList.add('img-error');">
      </div>
      <div class="gallery-item">
        <img src="/images/nz94160-enhanced-nr.jpg" alt="Opera Taipei at night" loading="lazy" onerror="this.onerror=null;this.style.display='none';this.parentElement.classList.add('img-error');">
      </div>
      <div class="gallery-item">
        <img src="/images/pxl_20230816_104507838.jpg" alt="Opera Taipei cocktail details" loading="lazy" onerror="this.onerror=null;this.style.display='none';this.parentElement.classList.add('img-error');">
      </div>
      <div class="gallery-item">
        <img src="/images/pxl_20230816_104529730.jpg" alt="Opera Taipei ambiance" loading="lazy" onerror="this.onerror=null;this.style.display='none';this.parentElement.classList.add('img-error');">
      </div>
      <div class="gallery-item">
        <img src="/images/darts.jpg" alt="Opera Taipei darts game machines" loading="lazy" onerror="this.onerror=null;this.style.display='none';this.parentElement.classList.add('img-error');">
      </div>
    </div>
  </div>
</section>

<!-- Trusted By Section -->
<section id="trusted-by" style="background: var(--color-deep-dark); padding: 100px 40px;">
  <div class="section-wrap fade-in">
    <p class="section-label">{t.trusted_label}</p>
    <h2 class="section-title" set:html={t.trusted_title} />
    <div class="section-divider"></div>

    <p class="trusted-by-intro">
      {t.trusted_intro}
    </p>

    <div class="trusted-by-grid">
      <div class="trusted-by-column">
        <div class="trusted-by-column-label">{t.trusted_col1}</div>
        <ul class="trusted-by-list">
          <li>Taiwan Foreign Correspondent Club</li>
          <li>Meta TW Association</li>
          <li>French Chamber of Commerce</li>
          <li>Dragon Chamber Award</li>
          <li>Gigabyte</li>
          <li>McKinsey</li>
          <li>Amazon</li>
          <li>COACH</li>
        </ul>
      </div>
      <div class="trusted-by-column">
        <div class="trusted-by-column-label">{t.trusted_col2}</div>
        <ul class="trusted-by-list">
          <li>{t.trusted_e1}</li>
          <li>{t.trusted_e2}</li>
          <li>{t.trusted_e3}</li>
          <li>{t.trusted_e4}</li>
          <li>{t.trusted_e5}</li>
          <li>{t.trusted_e6}</li>
          <li>{t.trusted_e7}</li>
          <li>{t.trusted_e8}</li>
        </ul>
      </div>
      <div class="trusted-by-column">
        <div class="trusted-by-column-label">{t.trusted_col3}</div>
        <ul class="trusted-by-list">
          <li>{t.trusted_s1}</li>
          <li>{t.trusted_s2}</li>
          <li>{t.trusted_s3}</li>
          <li>{t.trusted_s4}</li>
          <li>{t.trusted_s5}</li>
          <li>{t.trusted_s6}</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Corporate Events Hiring Details (Studio Showcase Design) -->
<section id="events" class="events-studio-shell">
  <!-- Architectural Threshold / Studio Entry Header -->
  <div class="events-studio-banner fade-in">
    <div class="studio-ornament-line">
      <span class="studio-ornament-line-wing"></span>
      <span class="studio-ornament-diamond">✦</span>
      <span class="studio-ornament-line-wing"></span>
    </div>
    <div class="studio-entry-inner">
      <div class="part-mode-pill part-mode-pill--studio">{t.events_label}</div>
      <h2 class="studio-entry-title" set:html={t.events_title} />
      <p class="studio-entry-sub">{t.events_intro}</p>
    </div>
  </div>

  <!-- Studio Content Body: 4 Offer Pillars + Interactive Quote CTA -->
  <div class="events-studio-body">
    <div class="section-wrap fade-in">
      <div class="events-pillars-grid">
        <!-- Pillar 01: Capacity & Scale -->
        <article class="studio-pillar-card">
          <div class="studio-pillar-top">
            <div class="studio-step-num-badge" aria-hidden="true">01</div>
            <div class="studio-pillar-headings">
              <span class="studio-pillar-tag">{t.events_pillar1_tag}</span>
              <h3 class="studio-pillar-title" set:html={t.events_pillar1_title} />
            </div>
          </div>
          <p class="studio-pillar-desc">{t.events_pillar1_desc}</p>
        </article>

        <!-- Pillar 02: Branding & Equipment -->
        <article class="studio-pillar-card">
          <div class="studio-pillar-top">
            <div class="studio-step-num-badge" aria-hidden="true">02</div>
            <div class="studio-pillar-headings">
              <span class="studio-pillar-tag">{t.events_pillar2_tag}</span>
              <h3 class="studio-pillar-title" set:html={t.events_pillar2_title} />
            </div>
          </div>
          <p class="studio-pillar-desc">{t.events_pillar2_desc}</p>
        </article>

        <!-- Pillar 03: Custom Drink Menu & Catering -->
        <article class="studio-pillar-card">
          <div class="studio-pillar-top">
            <div class="studio-step-num-badge" aria-hidden="true">03</div>
            <div class="studio-pillar-headings">
              <span class="studio-pillar-tag">{t.events_pillar3_tag}</span>
              <h3 class="studio-pillar-title" set:html={t.events_pillar3_title} />
            </div>
          </div>
          <p class="studio-pillar-desc">{t.events_pillar3_desc}</p>
        </article>

        <!-- Pillar 04: Vibe & Flexibility -->
        <article class="studio-pillar-card">
          <div class="studio-pillar-top">
            <div class="studio-step-num-badge" aria-hidden="true">04</div>
            <div class="studio-pillar-headings">
              <span class="studio-pillar-tag">{t.events_pillar4_tag}</span>
              <h3 class="studio-pillar-title" set:html={t.events_pillar4_title} />
            </div>
          </div>
          <p class="studio-pillar-desc">{t.events_pillar4_desc}</p>
        </article>
      </div>

      <!-- Callout Ledger Encouraging User to Click "Simulate a Quote" -->
      <div class="studio-cta-ledger">
        <div class="studio-ledger-header">
          <span class="studio-ledger-icon" aria-hidden="true">◈</span>
          <span class="studio-ledger-title">{t.events_cta_badge}</span>
        </div>
        <div class="studio-cta-ledger-content">
          <div class="studio-cta-text-col">
            <h3 class="studio-cta-heading">{t.events_cta_heading}</h3>
            <p class="studio-cta-copy">{t.events_cta_copy}</p>
          </div>
          <div class="studio-cta-action-col">
            <a href={quoteUrl} class="btn-simulate-quote">
              <span>{t.events_simulate_btn}</span>
              <span class="btn-simulate-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Darts/Vibe Video Modal -->
<div id="vibe-modal" class="vibe-modal-overlay">
  <div class="vibe-modal-content">
    <button id="close-vibe-btn" class="vibe-modal-close" aria-label="Close modal">&times;</button>
    <div class="video-container">
      <video id="vibe-video" controls loop playsinline>
        <source src="/images/opera_vibe.mp4" type="video/mp4">
        Your browser does not support the video tag.
      </video>
    </div>
  </div>
</div>

<style>
  .gallery-action-container {
    display: flex;
    justify-content: center;
    margin-top: -10px;
    margin-bottom: 40px;
  }
  
  .gallery-action-container button {
    font-family: 'Montserrat', sans-serif;
    font-weight: 500;
    background: none;
    cursor: pointer;
  }

  /* Vibe Modal Styles */
  .vibe-modal-overlay {
    display: none;
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0, 0, 0, 0.95);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .vibe-modal-overlay.active {
    display: flex;
    opacity: 1;
  }

  .vibe-modal-content {
    position: relative;
    width: 90%;
    max-width: 800px;
    background: #000;
    border: 2px solid var(--color-gold, #d4af37); /* Golden frame */
    border-radius: 8px;
    padding: 4px;
    box-shadow: 0 0 25px rgba(212, 175, 55, 0.4);
    transform: scale(0.9);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .vibe-modal-overlay.active .vibe-modal-content {
    transform: scale(1);
  }

  .vibe-modal-close {
    position: absolute;
    top: -45px;
    right: -10px;
    background: none;
    border: none;
    color: var(--color-gold, #d4af37); /* Golden cross */
    font-size: 2.8rem;
    line-height: 1;
    cursor: pointer;
    transition: color 0.2s, transform 0.2s;
    z-index: 1010;
  }

  .vibe-modal-close:hover {
    color: var(--color-gold-light, #f3e5ab);
    transform: scale(1.1);
  }

  .video-container {
    width: 100%;
    height: 0;
    padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
    position: relative;
    border-radius: 4px;
    overflow: hidden;
  }

  .video-container video {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
  }

  /* ================================================================
     PRIVATE EVENT & CORPORATE VENUE — WARM BRONZE STUDIO SHOWCASE
     (Inspired by Part II · Interactive Quotation Studio)
  ================================================================ */
  .events-studio-shell {
    position: relative;
    padding: 0;
    background: #16120d;
    border-top: 2px solid var(--color-gold);
    border-bottom: 2px solid var(--color-gold);
    box-shadow: 0 -24px 60px rgba(0, 0, 0, 0.85), 0 24px 60px rgba(0, 0, 0, 0.75);
  }

  .events-studio-banner {
    background:
      radial-gradient(ellipse at 50% 0%, rgba(201, 168, 76, 0.24) 0%, transparent 70%),
      linear-gradient(180deg, #211a12 0%, #16120d 100%);
    padding: 72px 40px 52px;
    text-align: center;
    border-bottom: 1px solid rgba(201, 168, 76, 0.24);
  }

  .studio-ornament-line {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    max-width: 460px;
    margin: 0 auto 22px;
  }

  .studio-ornament-line-wing {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-gold), transparent);
  }

  .studio-ornament-diamond {
    color: var(--color-gold-light);
    font-size: 0.95rem;
    line-height: 1;
  }

  .studio-entry-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .part-mode-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    padding: 6px 18px;
    border-radius: 30px;
    margin-bottom: 18px;
  }

  .part-mode-pill--studio {
    color: #080808;
    background: linear-gradient(135deg, var(--color-gold-light), var(--color-gold));
    border: 1px solid var(--color-gold-light);
    box-shadow: 0 4px 18px rgba(201, 168, 76, 0.32);
  }

  .studio-entry-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.3rem, 5vw, 3.8rem);
    font-weight: 300;
    color: var(--color-white);
    line-height: 1.12;
    margin-bottom: 16px;
  }

  .studio-entry-title :global(em) {
    font-style: italic;
    color: var(--color-gold-light);
  }

  .studio-entry-sub {
    font-size: 0.94rem;
    color: rgba(245, 240, 232, 0.82);
    line-height: 1.85;
    font-weight: 300;
    max-width: 760px;
    margin: 0 auto;
  }

  .events-studio-body {
    background:
      radial-gradient(ellipse at 85% 20%, rgba(201, 168, 76, 0.08) 0%, transparent 55%),
      radial-gradient(ellipse at 15% 80%, rgba(201, 168, 76, 0.07) 0%, transparent 55%),
      #16120d;
    padding: 64px 40px 84px;
  }

  .events-pillars-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 44px;
  }

  .studio-pillar-card {
    background: #221b14;
    border: 1px solid rgba(201, 168, 76, 0.3);
    border-radius: 12px;
    padding: 32px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.38);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .studio-pillar-card:hover {
    transform: translateY(-3px);
    border-color: rgba(201, 168, 76, 0.65);
    box-shadow: 0 16px 38px rgba(0, 0, 0, 0.5), 0 0 24px rgba(201, 168, 76, 0.12);
  }

  .studio-pillar-top {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .studio-step-num-badge {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.5rem;
    font-weight: 300;
    line-height: 1;
    color: var(--color-gold-light);
    background: rgba(201, 168, 76, 0.1);
    border: 1px solid rgba(201, 168, 76, 0.45);
    border-radius: 12px;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: inset 0 0 18px rgba(201, 168, 76, 0.14);
  }

  .studio-pillar-headings {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .studio-pillar-tag {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .studio-pillar-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.65rem;
    font-weight: 400;
    line-height: 1.15;
    color: var(--color-white);
    margin: 0;
  }

  .studio-pillar-title :global(em) {
    font-style: italic;
    color: var(--color-gold-light);
  }

  .studio-pillar-desc {
    font-size: 0.86rem;
    color: rgba(245, 240, 232, 0.78);
    line-height: 1.8;
    font-weight: 300;
    margin: 0;
  }

  /* Studio CTA Ledger encouraging user to click "Simulate a Quote" */
  .studio-cta-ledger {
    background:
      radial-gradient(ellipse at 90% 50%, rgba(201, 168, 76, 0.16) 0%, transparent 65%),
      linear-gradient(145deg, rgba(38, 30, 21, 0.96), rgba(24, 19, 13, 0.98));
    border: 1px solid rgba(201, 168, 76, 0.45);
    border-left: 4px solid var(--color-gold);
    border-radius: 12px;
    padding: 28px 34px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
  }

  .studio-ledger-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(201, 168, 76, 0.22);
  }

  .studio-ledger-icon {
    color: var(--color-gold);
    font-size: 1rem;
  }

  .studio-ledger-title {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold-light);
  }

  .studio-cta-ledger-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .studio-cta-text-col {
    max-width: 720px;
  }

  .studio-cta-heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.55rem, 3vw, 2.1rem);
    font-weight: 400;
    color: var(--color-white);
    margin: 0 0 8px;
    line-height: 1.2;
  }

  .studio-cta-copy {
    font-size: 0.88rem;
    color: rgba(245, 240, 232, 0.8);
    line-height: 1.75;
    font-weight: 300;
    margin: 0;
  }

  .studio-cta-action-col {
    flex-shrink: 0;
  }

  .btn-simulate-quote {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 18px 36px;
    border-radius: 40px;
    background: linear-gradient(135deg, var(--color-gold-light), var(--color-gold));
    color: #080808;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--color-gold-light);
    box-shadow: 0 6px 24px rgba(201, 168, 76, 0.38);
    transition: transform 0.25s ease, box-shadow 0.25s ease, filter 0.25s ease;
    white-space: nowrap;
  }

  .btn-simulate-quote:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 32px rgba(201, 168, 76, 0.55);
    filter: brightness(1.06);
  }

  .btn-simulate-arrow {
    font-size: 1.05rem;
    line-height: 1;
    transition: transform 0.25s ease;
  }

  .btn-simulate-quote:hover .btn-simulate-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 1024px) {
    .events-pillars-grid {
      grid-template-columns: 1fr;
    }

    .studio-cta-ledger-content {
      flex-direction: column;
      align-items: flex-start;
    }

    .studio-cta-action-col {
      width: 100%;
    }

    .btn-simulate-quote {
      width: 100%;
    }
  }

  @media (max-width: 768px) {
    .events-studio-banner {
      padding: 56px 24px 40px;
    }

    .events-studio-body {
      padding: 44px 24px 64px;
    }

    .studio-pillar-card {
      padding: 24px 20px;
    }

    .studio-cta-ledger {
      padding: 24px 20px;
    }
  }
</style>

<script>
  const openBtn = document.getElementById('open-vibe-btn');
  const closeBtn = document.getElementById('close-vibe-btn');
  const modal = document.getElementById('vibe-modal');
  const video = document.getElementById('vibe-video') as HTMLVideoElement | null;

  if (openBtn && modal) {
    openBtn.addEventListener('click', () => {
      modal.classList.add('active');
      document.body.style.overflow = 'hidden'; // Disable page scrolling
      if (video) {
        video.play().catch(err => console.log('Video autoplay blocked:', err));
      }
    });
  }

  const closeModal = () => {
    if (modal) {
      modal.classList.remove('active');
      document.body.style.overflow = ''; // Re-enable page scrolling
      if (video) {
        video.pause();
        video.currentTime = 0; // Reset video to start
      }
    }
  };

  if (closeBtn) {
    closeBtn.addEventListener('click', closeModal);
  }

  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });
  }

  // Close on Escape key press
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeModal();
    }
  });
</script>
