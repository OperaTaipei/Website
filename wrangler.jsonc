{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "main": "dist/_worker.js",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opera-db",
      "database_id": "ab85fa74-7ab5-40ec-8136-7d68c7d7d4ef"
    }
  ]
}

